# AI DebugScan v3 - Environment Configuration

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debugscan
DB_USER=postgres
DB_PASS=password

# App Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
SESSION_LIFETIME=28800 # 8 hours in seconds

# AI Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Retention
RETENTION_DAYS=90

# Security
CSRF_SECRET=placeholder_secret_replace_in_production
ENCRYPTION_KEY=placeholder_encryption_key_32_chars_long
