{% extends "layout/base.twig" %}

{% block head %}
<style>
    .admin-layout {
        display: flex;
        min-height: 100vh;
    }
    .admin-sidebar {
        width: 240px;
        background: #2D3E50; /* Darker sidebar for Admin */
        color: #FFFFFF;
        display: flex;
        flex-direction: column;
    }
    .admin-header {
        padding: 24px;
        background: rgba(0,0,0,0.2);
        font-weight: 700;
        font-size: 16px;
        text-align: center;
        color: #E0E0E0;
    }
    .admin-nav { list-style: none; padding: 24px 0; flex: 1; }
    .admin-nav-link {
        display: block;
        padding: 12px 24px;
        color: #B0BEC5;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 14px;
    }
    .admin-nav-link:hover { background: rgba(255,255,255,0.1); color: #FFFFFF; }
    .admin-nav-link.active { background: var(--primary); color: #FFFFFF; font-weight: 600; }

    .admin-main { flex: 1; background: var(--bg-light); display: flex; flex-direction: column; }
    .admin-top-nav {
        height: 64px;
        background: var(--white);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 0 24px;
    }
    .page-container { padding: 32px; max-width: 1200px; margin: 0 auto; width: 100%; }

    /* Admin Specific Styling */
    .admin-title { font-size: 24px; font-weight: 700; color: #2D3436; margin-bottom: 32px; }
    
    /* KPI Grid & Cards */
    .kpi-grid { 
        display: grid; 
        grid-template-columns: repeat(5, 1fr); 
        gap: 24px; 
        margin-bottom: 32px; 
        width: 100%;
    }
    .kpi-card { 
        background: var(--white); 
        padding: 24px; 
        border-radius: var(--radius); 
        box-shadow: var(--shadow-1); 
        text-align: center;
        border: 1px solid var(--border);
        border-top: 4px solid var(--primary);
        min-width: 0; /* Prevents overflow-driven expansion */
        width: 100%;
    }
    .kpi-value { font-size: 28px; font-weight: 700; color: var(--text-primary); }
    .kpi-label { font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-top: 4px; letter-spacing: 0.05em; }

    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 32px; }
    .stat-card { background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-1); border-top: 4px solid var(--primary); }
    .stat-value { font-size: 28px; font-weight: 700; color: var(--text-primary); }
    .stat-label { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-top: 4px; }
    /* User Profile Card Styles */
    .user-profile-card {
        background: var(--white);
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-1);
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        border: 1px solid var(--border);
    }
    .user-avatar {
        width: 32px;
        height: 32px;
        background: var(--primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        text-transform: uppercase;
    }
    .user-meta { display: flex; flex-direction: column; line-height: 1.2; }
    .user-name { font-weight: 700; color: var(--text-primary); }
    .user-role { font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; }
    .user-actions { border-left: 1px solid var(--border); padding-left: 12px; display: flex; gap: 8px; }
    .btn-icon { color: var(--text-secondary); cursor: pointer; transition: color 0.2s; }
    .btn-icon:hover { color: var(--primary); }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    .modal-content {
        background: white;
        padding: 32px;
        border-radius: var(--radius);
        width: 100%;
        max-width: 400px;
        box-shadow: var(--shadow-2);
    }

    /* Tooltip System */
    [data-tooltip] {
        position: relative;
        cursor: pointer;
    }
    [data-tooltip]:before {
        content: attr(data-tooltip);
        position: absolute;
        bottom: 125%;
        left: 50%;
        transform: translateX(-50%);
        padding: 6px 10px;
        background: #333;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        border-radius: 4px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: all 0.2s ease;
        z-index: 1000;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    [data-tooltip]:after {
        content: '';
        position: absolute;
        bottom: 115%;
        left: 50%;
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-top-color: #333;
        opacity: 0;
        visibility: hidden;
        transition: all 0.2s ease;
        z-index: 1000;
    }
    [data-tooltip]:hover:before, [data-tooltip]:hover:after {
        opacity: 1;
        visibility: visible;
    }
    
    /* Center icons in action buttons */
    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-secondary);
        transition: all 0.2s ease;
    }
    .btn-action:hover {
        background: var(--bg-light);
        color: var(--primary);
        border-color: var(--primary);
        transform: translateY(-1px);
    }
    .btn-action.btn-danger-alt:hover {
        color: var(--error);
        border-color: var(--error);
        background: var(--error-light);
    }
    .btn-action.btn-success-alt:hover {
        color: var(--success);
        border-color: var(--success);
        background: var(--success-light);
    }
     .btn-action.btn-warning-alt:hover {
        color: var(--warning);
        border-color: var(--warning);
        background: #fff3e0;
    }
</style>
<script>
    function toggleProfileModal() {
        const modal = document.getElementById('profileModal');
        modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
    }
</script>
{% endblock %}

{% block content %}
<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="admin-header" style="display: flex; align-items: center; justify-content: center; padding: 12px;">
            <img src="/assets/img/logo-white.png" alt="AI DebugScan" style="height: 30px; width: auto; object-fit: contain;">
        </div>
        <nav class="admin-nav">
            <a href="/admin" class="admin-nav-link {% if active_page == 'admin_dash' %}active{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 12px; vertical-align: middle;"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                System Dashboard
            </a>
            <a href="/admin/tenants" class="admin-nav-link {% if active_page == 'admin_tenants' %}active{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 12px; vertical-align: middle;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                Tenant Management
            </a>
            <a href="/admin/scans" class="admin-nav-link {% if active_page == 'admin_scans' %}active{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 12px; vertical-align: middle;"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                Analysis Jobs
            </a>
            <a href="/admin/settings" class="admin-nav-link {% if active_page == 'admin_settings' %}active{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 12px; vertical-align: middle;"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="2" y1="14" x2="6" y2="14"></line><line x1="10" y1="8" x2="14" y2="8"></line><line x1="18" y1="16" x2="22" y2="16"></line></svg>
                AI & System Settings
            </a>
            <a href="/admin/logs" class="admin-nav-link {% if active_page == 'admin_logs' %}active{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 12px; vertical-align: middle;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                Audit & Error Logs
            </a>
            <a href="/admin/explorer" class="admin-nav-link {% if active_page == 'admin_explorer' %}active{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 12px; vertical-align: middle;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                VPS File Explorer
            </a>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-top-nav">
            <div class="user-profile-card">
                <div class="user-avatar">{{ user_name|slice(0,1) }}</div>
                <div class="user-meta">
                    <span class="user-name">{{ user_name }}</span>
                    <span class="user-role">{{ user_role|default('Admin') }}</span>
                </div>
                <div class="user-actions">
                    <span class="btn-icon" onclick="toggleProfileModal()" title="Edit Profile">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    </span>
                    <a href="/auth/logout" class="btn-icon" title="Logout" style="text-decoration: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    </a>
                </div>
            </div>
        </header>

        <!-- Profile Modal -->
        <div id="profileModal" class="modal-overlay" onclick="if(event.target === this) toggleProfileModal()">
            <div class="modal-content">
                <h3 style="margin-bottom: 24px; font-weight: 700;">Edit My Profile</h3>
                <form action="/profile/update" method="POST">
                    <div class="form-group">
                        <label class="form-label">Display Name</label>
                        <input type="text" name="display_name" class="form-control" value="{{ user_name }}" required>
                    </div>
                    <div class="form-group" style="margin-top: 16px;">
                        <label class="form-label">New Password (leave blank to keep)</label>
                        <input type="password" name="password" class="form-control" placeholder="••••••••">
                    </div>
                    <div style="margin-top: 32px; display: flex; gap: 12px; justify-content: flex-end;">
                        <button type="button" class="btn btn-secondary" onclick="toggleProfileModal()">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <section class="page-container">
            {% block admin_content %}{% endblock %}
        </section>
    </main>
</div>
{% endblock %}
