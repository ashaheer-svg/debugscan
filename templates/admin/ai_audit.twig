{% extends "layout/admin.twig" %}

{% block title %}AI Forensic Audit Log - Admin{% endblock %}

{% block content %}
<header class="page-header" style="margin-bottom: 32px;">
    <h1 class="page-title">AI Forensic Audit Log</h1>
    <p class="page-subtitle">Global immutable record of all AI transactions and token expenditure.</p>
</header>

<div class="card" style="padding: 0; overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Scan UID</th>
                <th>Tenant / Project</th>
                <th>AI Model</th>
                <th>Prompt Size</th>
                <th>Token Metrics (In / Out)</th>
                <th>Completed At</th>
                <th style="padding-right: 24px; text-align: right;">Status</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            <tr>
                <td style="padding-left: 24px;">
                    <div style="font-family: monospace; font-size: 11px; color: var(--text-muted);">#{{ log.id|slice(0, 8) }}</div>
                </td>
                <td>
                    <div style="font-weight: 700; color: var(--text-primary);">{{ log.tenant_name }}</div>
                    <div style="font-size: 11px; color: var(--text-muted);">{{ log.project_name }}</div>
                </td>
                <td>
                    <span class="badge" style="background: rgba(108, 92, 231, 0.1); color: #6c5ce7; font-weight: 800; border: 1px solid rgba(108, 92, 231, 0.2);">
                        {{ log.ai_model|default('unknown')|upper }}
                    </span>
                </td>
                <td>
                    <div style="font-size: 13px; font-weight: 600; font-family: monospace;">{{ (log.prompt_size_bytes / 1024)|number_format(2) }} <span style="font-size: 10px; color: var(--text-muted);">KB</span></div>
                    <div style="font-size: 10px; color: var(--text-muted); font-weight: 700;">{{ log.prompt_size_bytes|number_format }} CHARS</div>
                </td>
                <td>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="flex: 1;">
                            <div style="font-size: 12px; font-weight: 700; color: var(--primary);">{{ log.ai_input_tokens_used|number_format }} <span style="font-size: 10px; opacity: 0.6;">IN</span></div>
                            <div style="font-size: 12px; font-weight: 700; color: #10b981;">{{ log.ai_output_tokens_used|number_format }} <span style="font-size: 10px; opacity: 0.6;">OUT</span></div>
                        </div>
                        <div style="background: var(--bg-deep); padding: 4px 10px; border-radius: 6px; text-align: right;">
                            <div style="font-size: 10px; font-weight: 800; color: var(--text-muted);">TOTAL</div>
                            <div style="font-size: 13px; font-weight: 900; color: var(--text-primary);">{{ (log.ai_input_tokens_used + log.ai_output_tokens_used)|number_format }}</div>
                        </div>
                    </div>
                </td>
                <td style="font-size: 12px; color: var(--text-muted);">
                    {{ log.completed_at ? log.completed_at|date('M d, H:i:s') : 'Pending' }}
                </td>
                <td style="padding-right: 24px; text-align: right;">
                    {% if log.status == 'completed' %}
                        <span style="color: #10b981; font-weight: 800; font-size: 10px; letter-spacing: 0.05em;">SUCCESS</span>
                    {% else %}
                        <span style="color: var(--danger); font-weight: 800; font-size: 10px; letter-spacing: 0.05em;">FAILED</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            {% if not logs %}
            <tr>
                <td colspan="7" style="padding: 80px; text-align: center; color: var(--text-muted);">
                    <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">🧠</div>
                    <div style="font-weight: 600; color: var(--text-primary);">No AI transactions logged yet.</div>
                </td>
            </tr>
            {% endif %}
        </tbody>
    </table>
</div>
{% endblock %}
