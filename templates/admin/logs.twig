{% extends "layout/admin.twig" %}

{% block title %}System Audit Logs - AI DebugScan v3{% endblock %}

{% block admin_content %}
<header class="page-header">
    <h1 class="admin-title">System Audit & Error Logs</h1>
    <p class="page-subtitle">Historical record of all system events, authentication attempts, and scan failures.</p>
</header>

<section class="card" style="padding: 0; overflow: hidden;">
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Timestamp</th>
                <th>Context</th>
                <th>Action</th>
                <th>Source</th>
                <th style="padding-right: 24px;">Details</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            <tr>
                <td style="padding-left: 24px; color: var(--text-secondary); white-space: nowrap; font-size: 11px; font-weight: 500;">
                    {{ log.created_at|date('Y-m-d H:i:s') }}
                </td>
                <td>
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 13px;">{{ log.user_name|default('System') }}</div>
                    <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">ID: {{ log.user_id|slice(0,8) }}</div>
                </td>
                <td>
                    <span class="badge" style="
                        background: {% if 'FAILED' in log.action|upper or 'ERROR' in log.action|upper %}var(--danger-light){% elseif 'CREATE' in log.action|upper or 'SUCCESS' in log.action|upper %}var(--success-light){% else %}var(--bg-light){% endif %};
                        color: {% if 'FAILED' in log.action|upper or 'ERROR' in log.action|upper %}var(--danger){% elseif 'CREATE' in log.action|upper or 'SUCCESS' in log.action|upper %}var(--success){% else %}var(--text-primary){% endif %};
                        border: 1px solid {% if 'FAILED' in log.action|upper or 'ERROR' in log.action|upper %}var(--danger){% elseif 'CREATE' in log.action|upper or 'SUCCESS' in log.action|upper %}var(--success){% else %}var(--border){% endif %};
                        ">
                        {{ log.action|upper }}
                    </span>
                </td>
                <td style="font-family: monospace; font-size: 11px; color: var(--text-muted); font-weight: 600;">{{ log.ip_address|default('::1') }}</td>
                <td style="padding-right: 24px; color: var(--text-secondary); max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500;" title="{{ log.details }}">
                    {{ log.details }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    {% if not logs %}
    <div style="padding: 80px; text-align: center; color: var(--text-muted);">
        <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">📜</div>
        <div style="font-weight: 600; color: var(--text-primary);">No audit trails discovered</div>
    </div>
    {% endif %}
</section>
{% endblock %}
