{% extends "layout/admin.twig" %}

{% block title %}System Settings - AI DebugScan v3{% endblock %}

{% block admin_content %}
<header class="page-header">
    <h1 class="page-title">AI & System Configuration</h1>
    <p class="page-subtitle">Governance policies, AI model routing, and core performance tuning.</p>
</header>

{% if error or session.error %}
<div style="background: var(--danger-light); color: var(--danger); padding: 12px 16px; border-radius: var(--radius); margin-bottom: 32px; font-weight: 600; border: 1px solid var(--danger);">
    {{ error ?: session.error }}
</div>
{% endif %}

{% if success or session.success %}
<div style="background: var(--success-light); color: var(--success); padding: 12px 16px; border-radius: var(--radius); margin-bottom: 32px; font-weight: 600; border: 1px solid var(--success);">
    {{ success ?: session.success }}
</div>
{% endif %}

<form action="/admin/settings/update" method="POST">
    <div class="responsive-grid" style="align-items: start;">
        
        <!-- AI Model Selection -->
        <section class="card">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 24px;">AI Engine Configuration</h3>
            
            <div class="form-group">
                <label for="level1_model" class="form-label">Level 1 Scan Model (Standard)</label>
                <select id="level1_model" name="level1_model" class="form-control" style="background: var(--bg-light); border-color: var(--border);">
                    {% for model in models %}
                    <option value="{{ model.id }}" {% if settings.level1_model == model.id %}selected{% endif %}>{{ model.id }}</option>
                    {% endfor %}
                </select>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 6px; font-weight: 500;">Optimized for rapid hardware identity discovery and extraction.</p>
            </div>

            <div class="form-group" style="margin-top: 24px;">
                <label for="level2_model" class="form-label">Level 2 Scan Model (Deep Forensic)</label>
                <select id="level2_model" name="level2_model" class="form-control" style="background: var(--bg-light); border-color: var(--border);">
                    {% for model in models %}
                    <option value="{{ model.id }}" {% if settings.level2_model == model.id %}selected{% endif %}>{{ model.id }}</option>
                    {% endfor %}
                </select>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 6px; font-weight: 500;">Optimized for high-context archival log cross-referencing.</p>
            </div>

            <div class="form-group" style="margin-top: 24px;">
                <label for="max_prompt_chars" class="form-label">AI Character Limit (Per File)</label>
                <input type="number" id="max_prompt_chars" name="max_prompt_chars" class="form-control" value="{{ settings.max_prompt_chars|default(50000) }}" min="1000" max="500000" step="5000" style="background: var(--bg-light); border-color: var(--border);">
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 6px; font-weight: 500;">Safety limit for forensic data density. Recommended: 50,000 - 150,000.</p>
            </div>
        </section>

        <!-- System Governance & Regional -->
        <section class="card">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 24px;">Regional & Governance</h3>
            
            <div class="form-group">
                <label for="timezone" class="form-label">Global System Timezone</label>
                <select id="timezone" name="timezone" class="form-control" style="background: var(--bg-light); border-color: var(--border);">
                    {% for tz in timezones %}
                    <option value="{{ tz }}" {% if settings.timezone == tz %}selected{% endif %}>{{ tz }}</option>
                    {% endfor %}
                </select>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 6px; font-weight: 500;">Synchronizes all audit logs and forensic scans to your local time.</p>
            </div>

            <div class="form-group" style="margin-top: 24px; display: flex; align-items: flex-start; justify-content: space-between; padding: 16px; background: var(--bg-light); border: 1px solid var(--border); border-radius: var(--radius);">
                <div>
                    <label for="debug_mode" class="form-label" style="display: block; font-weight: 700; color: var(--text-primary);">Developer Debug Mode</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px; font-weight: 500;">Output detailed Slim crash traces to the browser instead of a generic 500 error page. Disable in production for security.</p>
                </div>
                <label class="switch" style="position: relative; display: inline-block; width: 44px; height: 24px; margin-left: 16px; flex-shrink: 0;">
                    <input type="checkbox" id="debug_mode" name="debug_mode" value="true" {% if settings.debug_mode %}checked{% endif %} style="opacity: 0; width: 0; height: 0;">
                    <span class="slider round" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--border); transition: .4s; border-radius: 24px;"></span>
                </label>
            </div>
            
            <style>
                .switch input:checked + .slider { background-color: var(--primary); }
                .switch input:focus + .slider { box-shadow: 0 0 1px var(--primary); }
                .switch .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
                .switch input:checked + .slider:before { transform: translateX(20px); }
            </style>

            <div class="form-group" style="margin-top: 24px;">
                <label for="retention_days" class="form-label">Data Retention Period (Days)</label>
                <input type="number" id="retention_days" name="retention_days" class="form-control" value="{{ settings.retention_days }}" min="7" max="365" style="background: var(--bg-light); border-color: var(--border);">
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 6px; font-weight: 500;">Logs and reports will be permanently purged after this window.</p>
            </div>

            <div class="form-group" style="margin-top: 24px;">
                <label for="max_concurrent_scans" class="form-label">Max Concurrent Worker Scans</label>
                <input type="number" id="max_concurrent_scans" name="max_concurrent_scans" class="form-control" value="{{ settings.max_concurrent_scans }}" min="1" max="10" style="background: var(--bg-light); border-color: var(--border);">
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 6px; font-weight: 500;">Simultaneous extractions permitted to maintain VPS stability.</p>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px;">
                <div class="form-group">
                    <label for="stuck_alert_mins" class="form-label">Heartbeat Alert (m)</label>
                    <input type="number" id="stuck_alert_mins" name="stuck_alert_mins" class="form-control" value="{{ settings.stuck_alert_mins|default(5) }}" min="1" max="60" style="background: var(--bg-light); border-color: var(--border);">
                </div>
                <div class="form-group">
                    <label for="auto_cancel_mins" class="form-label">Auto-Cancel (m)</label>
                    <input type="number" id="auto_cancel_mins" name="auto_cancel_mins" class="form-control" value="{{ settings.auto_cancel_mins|default(30) }}" min="5" max="240" style="background: var(--bg-light); border-color: var(--border);">
                </div>
            </div>
        </section>

        <section class="card" style="grid-column: span 2;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 24px;">Global Notifications & Reporting</h3>
            <div class="form-group" style="max-width: 400px;">
                <label for="reporting_email" class="form-label">Primary Admin/Reporting Email</label>
                <input type="email" id="reporting_email" name="reporting_email" class="form-control" value="{{ settings.reporting_email|default('shaheer@activelk.com') }}" required style="background: var(--bg-light); border-color: var(--border);">
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 6px; font-weight: 500;">AI token requests, magic link approvals, and forensic summary reports will be sent to this address.</p>
            </div>
        </section>

        <!-- SMTP Email Configuration -->
        <section class="card" style="grid-column: span 2;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 24px;">Outbound Email (SMTP)</h3>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 24px;">Required for sending token purchase magic links to the administrator.</p>
            
            <div class="responsive-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
                <div class="form-group">
                    <label for="smtp_host" class="form-label">SMTP Host</label>
                    <input type="text" id="smtp_host" name="smtp_host" class="form-control" value="{{ settings.smtp_host }}" placeholder="smtp.gmail.com" style="background: var(--bg-light); border-color: var(--border);">
                </div>
                <div class="form-group">
                    <label for="smtp_port" class="form-label">SMTP Port</label>
                    <input type="number" id="smtp_port" name="smtp_port" class="form-control" value="{{ settings.smtp_port|default(587) }}" placeholder="587" style="background: var(--bg-light); border-color: var(--border);">
                </div>
                <div class="form-group">
                    <label for="smtp_encryption" class="form-label">Encryption</label>
                    <select id="smtp_encryption" name="smtp_encryption" class="form-control" style="background: var(--bg-light); border-color: var(--border);">
                        <option value="tls" {% if settings.smtp_encryption == 'tls' %}selected{% endif %}>STARTTLS (587)</option>
                        <option value="ssl" {% if settings.smtp_encryption == 'ssl' %}selected{% endif %}>SSL/TLS (465)</option>
                    </select>
                </div>
            </div>

            <div class="responsive-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 20px;">
                <div class="form-group">
                    <label for="smtp_user" class="form-label">SMTP Username</label>
                    <input type="text" id="smtp_user" name="smtp_user" class="form-control" value="{{ settings.smtp_user }}" style="background: var(--bg-light); border-color: var(--border);">
                </div>
                <div class="form-group">
                    <label for="smtp_pass" class="form-label">SMTP Password</label>
                    <input type="password" id="smtp_pass" name="smtp_pass" class="form-control" value="{{ settings.smtp_pass }}" placeholder="••••••••" style="background: var(--bg-light); border-color: var(--border);">
                </div>
                <div class="form-group">
                    <label for="smtp_from" class="form-label">Sender Email (From)</label>
                    <input type="email" id="smtp_from" name="smtp_from" class="form-control" value="{{ settings.smtp_from }}" placeholder="no-reply@activelk.com" style="background: var(--bg-light); border-color: var(--border);">
                </div>
            </div>
        </section>

    </div>

    <div style="margin-top: 32px; display: flex; justify-content: flex-end; gap: 16px;">
        <button type="button" onclick="document.getElementById('testEmailForm').submit()" class="btn" style="width: auto; padding: 12px 24px; font-weight: 700; background: var(--bg-light); border: 1px solid var(--border); color: var(--text-primary);">
            Test SMTP Configuration
        </button>
        <button type="submit" class="btn btn-primary" style="width: auto; padding: 12px 48px; font-weight: 700;">
            Apply System Configuration
        </button>
    </div>
</form>

<form id="testEmailForm" action="/admin/settings/test-email" method="POST" style="display: none;"></form>

<!-- Danger Zone -->
<section class="card" style="margin-top: 64px; border: 1px solid var(--danger); background: var(--danger-light); padding: 32px;">
    <h3 style="color: var(--danger); margin: 0 0 12px 0; font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Danger Zone</h3>
    <p style="color: var(--text-primary); margin-bottom: 24px; font-size: 14px; font-weight: 600; line-height: 1.6;">
        Perform a factory reset of the forensic environment. This will permanently delete all projects, diagnostic log files, and scan indices across all tenant partitions.
    </p>

    <div style="display: flex; align-items: center; justify-content: space-between; gap: 24px;">
        <p style="color: var(--text-muted); font-size: 12px; margin: 0; font-weight: 500;">
            User account registry and AI settings will be preserved. This operation is IRREVERSIBLE.
        </p>
        <form action="/admin/settings/reset" method="POST" id="resetForm">
            <button type="button" class="btn btn-danger" onclick="confirmReset()" style="width: auto; padding: 12px 32px; font-weight: 700;">
                Factory Reset All History
            </button>
        </form>
    </div>
</section>

<script>
function confirmReset() {
    if (confirm("WARNING: This will permanently delete all forensic data and history. This action cannot be undone.\n\nAre you absolutely sure?")) {
        if (confirm("LAST CHANCE: All diagnostic logs and extraction workspaces will be wiped. Type 'CONFIRM' to proceed.")) {
            document.getElementById('resetForm').submit();
        }
    }
}
</script>
{% endblock %}
