{% extends "layout/admin.twig" %}

{% block title %}System Settings - AI DebugScan v3{% endblock %}

{% block admin_content %}
<h1 class="admin-title">AI & System Configuration</h1>

{% if error %}
<div class="alert alert-danger">{{ error }}</div>
{% endif %}

<form action="/admin/settings/update" method="POST">
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px;">
        
        <!-- AI Model Selection -->
        <section style="background: var(--white); padding: 32px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
            <h3 style="margin-bottom: 24px; font-weight: 700; color: var(--text-primary);">AI Engine Configuration</h3>
            
            <div class="form-group">
                <label for="level1_model" class="form-label">Level 1 Scan Model (Standard)</label>
                <select id="level1_model" name="level1_model" class="form-control">
                    {% for model in models %}
                    <option value="{{ model.id }}" {% if settings.level1_model == model.id %}selected{% endif %}>{{ model.id }} ({{ model.owned_by }})</option>
                    {% endfor %}
                </select>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Optimized for rapid hardware identity discovery.</p>
            </div>

            <div class="form-group" style="margin-top: 24px;">
                <label for="level2_model" class="form-label">Level 2 Scan Model (Deep Forensic)</label>
                <select id="level2_model" name="level2_model" class="form-control">
                    {% for model in models %}
                    <option value="{{ model.id }}" {% if settings.level2_model == model.id %}selected{% endif %}>{{ model.id }} ({{ model.owned_by }})</option>
                    {% endfor %}
                </select>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Optimized for cross-referenced multi-file log analysis.</p>
            </div>
        </section>

        <!-- System Governance -->
        <section style="background: var(--white); padding: 32px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
            <h3 style="margin-bottom: 24px; font-weight: 700; color: var(--text-primary);">Forensic Governance</h3>
            
            <div class="form-group">
                <label for="retention_days" class="form-label">Data Retention Period (Days)</label>
                <input type="number" id="retention_days" name="retention_days" class="form-control" value="{{ settings.retention_days }}" min="7" max="365">
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Extracted logs and reports will be purged after this period.</p>
            </div>

            <div class="form-group" style="margin-top: 24px;">
                <label for="max_concurrent_scans" class="form-label">Max Concurrent Worker Scans</label>
                <input type="number" id="max_concurrent_scans" name="max_concurrent_scans" class="form-control" value="{{ settings.max_concurrent_scans }}" disabled>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Locked based on VPS license tier.</p>
            </div>
        </section>

    </div>

    <div style="margin-top: 32px; display: flex; justify-content: flex-end;">
        <button type="submit" class="btn btn-primary" style="width: auto; padding: 12px 32px;">
            Save System Settings
        </button>
    </div>
</form>
{% endblock %}
