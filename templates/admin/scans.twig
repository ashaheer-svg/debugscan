{% extends "layout/admin.twig" %}

{% block title %}Analysis Jobs - System Admin{% endblock %}

{% block admin_content %}
<header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px;">
    <div>
        <h1 class="admin-title" style="margin-bottom: 4px;">Analysis Jobs</h1>
        <p style="color: var(--text-muted); font-size: 14px;">Monitor platform-wide forensic audits and AI token consumption.</p>
    </div>
</header>

<section class="card" style="padding: 0; overflow: hidden;">
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">ID / Date</th>
                <th>Tenant / Project</th>
                <th>Level</th>
                <th>Progress / Status</th>
                <th>AI Usage</th>
                <th style="padding-right: 24px; text-align: right;">Audit Toolbox</th>
            </tr>
        </thead>
        <tbody>
            {% for scan in scans %}
            <tr>
                <td style="padding-left: 24px;">
                    <div style="font-family: monospace; font-weight: 700; font-size: 11px; color: var(--text-primary);">#{{ scan.id|slice(0, 8) }}</div>
                    <div style="font-size: 11px; color: var(--text-muted); font-weight: 500;">{{ scan.created_at|date('M d, H:i') }}</div>
                </td>
                <td>
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 13px;">{{ scan.tenant_name }}</div>
                    <div style="font-size: 11px; color: var(--primary); font-weight: 600;">{{ scan.project_name }}</div>
                </td>
                <td>
                    <span class="badge" style="background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border);">
                        {{ scan.scan_level|upper }}
                    </span>
                </td>
                <td>
                    <div style="display: flex; flex-direction: column; gap: 4px; width: 140px;">
                        <span style="font-size: 10px; font-weight: 800; color: {% if scan.status == 'completed' %}var(--success){% elseif scan.status == 'failed' or scan.status == 'error' %}var(--danger){% else %}var(--primary){% endif %}; text-transform: uppercase; letter-spacing: 0.05em;">
                            {{ scan.status }}
                        </span>
                        {% if scan.status in ['queued', 'running'] %}
                        <div style="height: 4px; background: var(--bg-light); border-radius: 2px; overflow: hidden;">
                            <div class="shimmer" style="width: {{ scan.progress_percent }}%; height: 100%; background: var(--primary);"></div>
                        </div>
                        <div style="font-size: 9px; color: var(--text-muted); font-weight: 600;">{{ scan.progress_stage }}</div>
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div style="font-weight: 700; font-size: 13px; color: var(--text-primary);">{{ (scan.ai_input_tokens_used + scan.ai_output_tokens_used)|number_format }} <span style="font-size: 10px; color: var(--text-muted);">TKN</span></div>
                    <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">Charged: {{ scan.tokens_charged|number_format }}</div>
                </td>
                <td style="padding-right: 24px; text-align: right;">
                    <div style="display: flex; gap: 6px; justify-content: flex-end;">
                        <button onclick="toggleAudit('{{ scan.id }}')" class="btn btn-outline" title="View Audit Logs" style="height: 28px; padding: 0 8px; font-size: 10px; font-weight: 700;">LOG</button>
                        <a href="/admin/scans/raw/{{ scan.id }}" class="btn btn-outline" title="Download Raw Input" style="height: 28px; padding: 0 8px; font-size: 10px; font-weight: 700;">RAW</a>
                        <a href="/admin/scans/report/{{ scan.id }}" class="btn btn-outline" title="Download AI Report" style="height: 28px; padding: 0 8px; font-size: 10px; font-weight: 700;">REP</a>
                        <a href="/scans/report/{{ scan.id }}" target="_blank" class="btn btn-primary" style="height: 28px; padding: 0 12px; font-size: 10px; font-weight: 700;">VIEW</a>
                    </div>
                </td>
            </tr>
            <tr id="audit-{{ scan.id }}" style="display: none; background: var(--bg-off-white);">
                <td colspan="6" style="padding: 24px;">
                    <div style="font-size: 11px; border-left: 3px solid var(--primary); padding-left: 20px;">
                        <h4 style="margin: 0 0 16px 0; font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: flex; justify-content: space-between; letter-spacing: 0.1em;">
                            <span>Forensic Technical Log Stream</span>
                            <span id="log-status-{{ scan.id }}" style="color: var(--primary);"></span>
                        </h4>
                        
                        <div id="log-console-{{ scan.id }}" style="background: #1e1e1e; color: #d4d4d4; padding: 20px; border-radius: 6px; font-family: 'Cascadia Code', 'Source Code Pro', monospace; font-size: 12px; max-height: 400px; overflow-y: auto; line-height: 1.6; box-shadow: var(--shadow-2);">
                            <div style="color: #6a9955; font-style: italic;">// Initializing technical audit stream...</div>
                        </div>
                    </div>
                </td>
            </tr>
            {% endfor %}
            {% if not scans %}
            <tr>
                <td colspan="6" style="padding: 80px; text-align: center; color: var(--text-muted);">
                    <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">⏳</div>
                    <div style="font-weight: 600; color: var(--text-primary);">No analysis jobs discovered</div>
                </td>
            </tr>
            {% endif %}
        </tbody>
    </table>
</section>
{% endblock %}

{% block scripts %}
<script>
const activePolls = new Set();

function toggleAudit(scanId) {
    const row = document.getElementById('audit-' + scanId);
    if (row.style.display === 'none') {
        row.style.display = 'table-row';
        startPolling(scanId);
    } else {
        row.style.display = 'none';
        stopPolling(scanId);
    }
}

function startPolling(scanId) {
    if (activePolls.has(scanId)) return;
    activePolls.add(scanId);
    fetchStatus(scanId);
}

function stopPolling(scanId) {
    activePolls.delete(scanId);
}

function fetchStatus(scanId) {
    if (!activePolls.has(scanId)) return;

    fetch('/admin/scans/status/' + scanId)
        .then(r => r.json())
        .then(job => {
            renderLogs(scanId, job);
            
            if (job.status === 'running' || job.status === 'queued') {
                setTimeout(() => fetchStatus(scanId), 3000);
            }
        });
}

function renderLogs(scanId, job) {
    const console = document.getElementById('log-console-' + scanId);
    const statusLabel = document.getElementById('log-status-' + scanId);
    
    statusLabel.innerText = `STATUS: ${job.status.toUpperCase()} (${job.progress_percent}%)`;
    
    let html = '';
    if (job.checkpoints && job.checkpoints.length > 0) {
        job.checkpoints.forEach(cp => {
            const ts = cp.ts.split(' ')[1];
            const color = cp.status === 'success' ? '#6a9955' : '#f44747';
            const stageColor = '#569cd6';
            
            html += `<div style="margin-bottom: 8px;">`;
            html += `<span style="color: #808080;">[${ts}]</span> `;
            html += `<span style="color: ${stageColor}; font-weight: bold;">${cp.stage}</span>: `;
            html += `<span style="color: ${color};">${cp.status.toUpperCase()}</span>`;
            
            if (cp.meta && Object.keys(cp.meta).length > 0) {
                html += `<div style="padding-left: 20px; color: #9cdcfe; font-size: 11px;">`;
                Object.entries(cp.meta).forEach(([k, v]) => {
                    html += `<div><span style="color: #cccccc;">${k}:</span> ${JSON.stringify(v)}</div>`;
                });
                html += `</div>`;
            }
            html += `</div>`;
        });
    } else {
        html = `<div style="color: #808080;">// Waiting for job to start...</div>`;
    }
    
    console.innerHTML = html;
    console.scrollTop = console.scrollHeight;
}
</script>
{% endblock %}
