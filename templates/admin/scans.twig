{% extends "layout/admin.twig" %}

{% block title %}Analysis Jobs - System Admin{% endblock %}

{% block admin_content %}
<header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px;">
    <div>
        <h1 class="admin-title" style="margin-bottom: 4px;">Analysis Jobs</h1>
        <p style="color: var(--text-muted); font-size: 14px;">Monitor platform-wide forensic audits and AI token consumption.</p>
    </div>
</header>

<section style="background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-1); overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">
                <th style="padding: 12px 24px;">ID / Date</th>
                <th style="padding: 12px 0;">Tenant / Project</th>
                <th style="padding: 12px 0;">Level</th>
                <th style="padding: 12px 0;">Progress / Status</th>
                <th style="padding: 12px 0;">Tokens</th>
                <th style="padding: 12px 24px; text-align: right;">Audit Toolbox</th>
            </tr>
        </thead>
        <tbody>
            {% for scan in scans %}
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 13px;">
                <td style="padding: 16px 24px;">
                    <div style="font-family: monospace; font-weight: 700; font-size: 11px;">{{ scan.id|slice(0, 8) }}...</div>
                    <div style="font-size: 11px; color: var(--text-muted);">{{ scan.created_at|date('M d, H:i') }}</div>
                </td>
                <td style="padding: 16px 0;">
                    <div style="font-weight: 600;">{{ scan.tenant_name }}</div>
                    <div style="font-size: 11px; color: var(--text-muted);">{{ scan.project_name }}</div>
                </td>
                <td style="padding: 16px 0;">
                    <span class="badge" style="background: {% if scan.scan_level == 'level1' %}var(--success-light){% else %}var(--warning-light){% endif %}; color: {% if scan.scan_level == 'level1' %}var(--success){% else %}var(--warning){% endif %}; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: 700;">
                        {{ scan.scan_level|upper }}
                    </span>
                </td>
                <td style="padding: 16px 0;">
                    <div style="display: flex; flex-direction: column; gap: 4px; width: 120px;">
                        <span style="font-size: 11px; font-weight: 700; color: {% if scan.status == 'completed' %}var(--success){% elseif scan.status == 'failed' %}var(--error){% else %}var(--primary){% endif %}; text-transform: uppercase;">
                            {{ scan.status }}
                        </span>
                        {% if scan.status in ['queued', 'running'] %}
                        <div style="height: 4px; background: var(--bg-light); border-radius: 2px; overflow: hidden;">
                            <div style="width: {{ scan.progress_percent }}%; height: 100%; background: var(--primary);"></div>
                        </div>
                        <div style="font-size: 9px; color: var(--text-muted);">{{ scan.progress_stage }}</div>
                        {% endif %}
                    </div>
                </td>
                <td style="padding: 16px 0;">
                    <div style="font-weight: 700;">{{ (scan.ai_input_tokens_used + scan.ai_output_tokens_used)|number_format }}</div>
                    <div style="font-size: 10px; color: var(--text-muted);">Charged: {{ scan.tokens_charged|number_format }}</div>
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; gap: 6px; justify-content: flex-end;">
                        <button onclick="toggleAudit('{{ scan.id }}')" class="btn btn-sm" title="View Audit Logs" style="width: auto; padding: 4px 8px; background: var(--bg-light); border: 1px solid var(--border); font-size: 10px; cursor: pointer;">LOG</button>
                        <a href="/admin/scans/raw/{{ scan.id }}" class="btn btn-sm" title="Download Raw Input" style="width: auto; padding: 4px 8px; background: var(--bg-light); border: 1px solid var(--border); font-size: 10px; text-decoration: none;">RAW ({{ scan.formatted_payload_size }})</a>
                        <a href="/admin/scans/report/{{ scan.id }}" class="btn btn-sm" title="Download AI Report" style="width: auto; padding: 4px 8px; background: var(--bg-light); border: 1px solid var(--border); font-size: 10px; text-decoration: none;">REP</a>
                        <a href="/scans/report/{{ scan.id }}" target="_blank" class="btn btn-sm" style="width: auto; padding: 4px 8px; background: var(--primary); color: white; border: none; font-size: 10px; text-decoration: none;">VIEW</a>
                    </div>
                </td>
            </tr>
            <tr id="audit-{{ scan.id }}" style="display: none; background: #fafafa;">
                <td colspan="6" style="padding: 16px 24px;">
                    <div style="font-size: 11px; border-left: 2px solid var(--primary); padding-left: 16px;">
                        <h4 style="margin: 0 0 8px 0; font-size: 10px; text-transform: uppercase; color: var(--text-muted);">Forensic Extraction Audit Log</h4>
                        {% set checkpoints = scan.checkpoints|json_decode %}
                        {% if checkpoints %}
                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px;">
                            {% for cp in checkpoints if cp.type == 'forensic' %}
                                <div style="background: white; padding: 8px; border-radius: 4px; border: 1px solid var(--border);">
                                    <div style="font-weight: 700; color: var(--primary); margin-bottom: 4px;">{{ cp.stage }}</div>
                                    {% if cp.data.stats %}
                                        <ul style="list-style: none; padding: 0; margin: 0; font-family: monospace;">
                                        {% for table, s in cp.data.stats %}
                                            {% if table != 'root_path' %}
                                            <li style="margin-bottom: 2px;">
                                                <span style="color: var(--text-muted);">{{ table }}:</span> 
                                                <strong>{{ s.found|default(0) }}</strong> found &rarr; 
                                                <strong>{{ s.selected|default(s.selected_critical|default(0)) }}</strong> selected
                                            </li>
                                            {% endif %}
                                        {% endfor %}
                                        </ul>
                                        <div style="margin-top: 8px; font-size: 9px; color: var(--text-muted);">
                                            Path: <code>{{ cp.data.stats.root_path }}</code>
                                        </div>
                                    {% else %}
                                        <div style="color: var(--text-muted);">{{ cp.message }}</div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                            </div>
                        {% else %}
                            <p style="color: var(--text-muted); italic;">No detailed forensic logs available for this scan.</p>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
            {% if not scans %}
            <tr>
                <td colspan="6" style="padding: 48px; text-align: center; color: var(--text-muted);">No analysis jobs have been executed yet.</td>
            </tr>
            {% endif %}
        </tbody>
    </table>
</section>
{% endblock %}

{% block scripts %}
<script>
function toggleAudit(scanId) {
    const row = document.getElementById('audit-' + scanId);
    if (row.style.display === 'none') {
        row.style.display = 'table-row';
    } else {
        row.style.display = 'none';
    }
}
</script>
{% endblock %}
