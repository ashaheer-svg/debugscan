{% extends "layout/admin.twig" %}

{% block title %}Analysis Jobs - System Admin{% endblock %}

{% block admin_content %}
<header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px;">
    <div>
        <h1 class="admin-title" style="margin-bottom: 4px;">Analysis Jobs</h1>
        <p style="color: var(--text-muted); font-size: 14px;">Monitor platform-wide forensic audits and AI token consumption.</p>
    </div>
</header>

<section class="card" style="padding: 0; overflow: hidden;">
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">ID / Date</th>
                <th>Tenant / Project</th>
                <th>Level</th>
                <th>Progress / Status</th>
                <th>AI Usage</th>
                <th style="padding-right: 24px; text-align: right;">Audit Toolbox</th>
            </tr>
        </thead>
        <tbody>
            {% for scan in scans %}
            <tr>
                <td style="padding-left: 24px;">
                    <div style="font-family: monospace; font-weight: 700; font-size: 11px; color: var(--text-primary);">#{{ scan.id|slice(0, 8) }}</div>
                    <div style="font-size: 11px; color: var(--text-muted); font-weight: 500;">{{ scan.created_at|date('M d, H:i') }}</div>
                </td>
                <td>
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 13px;">{{ scan.tenant_name }}</div>
                    <div style="font-size: 11px; color: var(--primary); font-weight: 600;">{{ scan.project_name }}</div>
                </td>
                <td>
                    <span class="badge" style="background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border);">
                        {{ scan.scan_level|upper }}
                    </span>
                </td>
                <td>
                    <div style="display: flex; flex-direction: column; gap: 4px; width: 140px;">
                        <span style="font-size: 10px; font-weight: 800; color: {% if scan.status == 'completed' %}var(--success){% elseif scan.status == 'failed' or scan.status == 'error' %}var(--danger){% else %}var(--primary){% endif %}; text-transform: uppercase; letter-spacing: 0.05em;">
                            {{ scan.status }}
                        </span>
                        {% if scan.status in ['queued', 'running'] %}
                        <div style="height: 4px; background: var(--bg-light); border-radius: 2px; overflow: hidden;">
                            <div class="shimmer" style="width: {{ scan.progress_percent }}%; height: 100%; background: var(--primary);"></div>
                        </div>
                        <div style="font-size: 9px; color: var(--text-muted); font-weight: 600;">{{ scan.progress_stage }}</div>
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div style="font-weight: 700; font-size: 13px; color: var(--text-primary);">{{ (scan.ai_input_tokens_used + scan.ai_output_tokens_used)|number_format }} <span style="font-size: 10px; color: var(--text-muted);">TKN</span></div>
                    <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">Charged: {{ scan.tokens_charged|number_format }}</div>
                </td>
                <td style="padding-right: 24px; text-align: right;">
                    <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                        <button onclick="toggleAudit('{{ scan.id }}')" class="btn-action" data-tooltip="View Live Technical Logs" aria-label="Logs">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                        </button>

                        <button onclick="openScanPromptModal('{{ scan.id }}')" class="btn-action" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border-color: rgba(16, 185, 129, 0.2);" data-tooltip="Inspect Full AI Context Trace" aria-label="Inspect AI">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                        
                        <a href="/admin/scans/raw/{{ scan.id }}" class="btn-action" data-tooltip="Download Raw Data JSON" aria-label="Raw Data" style="width: auto; padding: 0 10px; gap: 6px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
                            <span style="font-size: 10px; font-weight: 700;">{{ scan.formatted_payload_size }}</span>
                        </a>

                        <a href="/admin/scans/report/{{ scan.id }}" class="btn-action" data-tooltip="Download Final AI Report" aria-label="Report" style="width: auto; padding: 0 10px; gap: 6px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            <span style="font-size: 10px; font-weight: 700;">{{ scan.formatted_report_size }}</span>
                        </a>

                        {% if scan.status in ['queued', 'running'] %}
                        <button onclick="abortJob('{{ scan.id }}')" class="btn-action btn-danger-alt" data-tooltip="Abort stuck job" aria-label="Abort">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                        {% endif %}

                        <a href="/scans/report/{{ scan.id }}" target="_blank" class="btn-action btn-success-alt" data-tooltip="Launch Professional Dashboard" aria-label="View Dashboard">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </a>
                    </div>
                </td>
            </tr>
            <tr id="audit-{{ scan.id }}" style="display: none; background: var(--bg-off-white);">
                <td colspan="6" style="padding: 24px;">
                    <div style="font-size: 11px; border-left: 3px solid var(--primary); padding-left: 20px;">
                        <h4 style="margin: 0 0 16px 0; font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: flex; justify-content: space-between; letter-spacing: 0.1em;">
                            <span>Forensic Technical Log Stream</span>
                            <span id="log-status-{{ scan.id }}" style="color: var(--primary);"></span>
                        </h4>
                        
                        <div id="log-console-{{ scan.id }}" style="background: #1e1e1e; color: #d4d4d4; padding: 20px; border-radius: 6px; font-family: 'Cascadia Code', 'Source Code Pro', monospace; font-size: 12px; max-height: 400px; overflow-y: auto; line-height: 1.6; box-shadow: var(--shadow-2);">
                            <div style="color: #6a9955; font-style: italic;">// Initializing technical audit stream...</div>
                        </div>
                    </div>
                </td>
            </tr>
            {% endfor %}
            {% if not scans %}
            <tr>
                <td colspan="6" style="padding: 80px; text-align: center; color: var(--text-muted);">
                    <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">⏳</div>
                    <div style="font-weight: 600; color: var(--text-primary);">No analysis jobs discovered</div>
                </td>
            </tr>
            {% endif %}
        </tbody>
    </table>
</section>

<!-- Styled Prompt Modal (Reused from Tenant for consistancy) -->
<div id="promptModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,10,0.85); z-index: 10005; align-items: center; justify-content: center; backdrop-filter: blur(12px);">
    <div style="background: #1a1b1e; width: 95%; max-width: 1200px; height: 85vh; border-radius: 20px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.1);">
        <div style="padding: 24px 32px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; background: #232429;">
            <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <h3 id="promptModalTitle" style="margin: 0; font-size: 16px; font-weight: 700; color: #fff; letter-spacing: -0.01em;">Global AI Trace</h3>
                    <span id="promptTypeBadge" class="badge" style="font-size: 10px; font-weight: 800; padding: 4px 10px; border-radius: 4px;">AI TRACE</span>
                </div>
            </div>
            <button onclick="closePromptModal()" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #9ca3af; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.color='#fff';" onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.color='#9ca3af';">&times;</button>
        </div>
        
        <div id="promptModalContent" style="flex-grow: 1; overflow: hidden; background: #0f1012; position: relative;">
            <!-- Content will be injected here via renderForensicInspector -->
            <div id="fi-loader" style="display: flex; align-items: center; justify-content: center; height: 100%; color: #6b7280; font-family: monospace;">
                FETCHING FORENSIC DATA...
            </div>
        </div>
        
        <div style="padding: 12px 32px; border-top: 1px solid rgba(255,255,255,0.05); background: #232429; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 11px; color: #6b7280; font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em;">SECURED FORENSIC AUDIT CHANNEL | ADMIN ACCESS ONLY</span>
            <div style="display: flex; gap: 12px;">
                <button onclick="closePromptModal()" class="btn" style="width: auto; height: 32px; padding: 0 20px; background: transparent; color: #9ca3af; border: 1px solid rgba(255,255,255,0.1); font-weight: 700; border-radius: 6px; font-size: 12px;">Dismiss</button>
            </div>
        </div>
    </div>
</div>

<style>
    .fi-container { display: flex; height: 100%; background: #0f1012; }
    .fi-sidebar { width: 280px; background: #15161a; border-right: 1px solid rgba(255,255,255,0.05); overflow-y: auto; padding-bottom: 40px; }
    .fi-main { flex-grow: 1; overflow-y: auto; padding: 40px; scroll-behavior: smooth; font-family: 'JetBrains Mono', 'Source Code Pro', monospace; }
    .fi-section { margin-bottom: 60px; }
    .fi-section-header { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .fi-section-title { font-size: 14px; font-weight: 800; color: #f8fafc; text-transform: uppercase; letter-spacing: 0.05em; }
    .fi-nav-item { padding: 12px 24px; font-size: 12px; color: #94a3b8; cursor: pointer; transition: all 0.2s; border-left: 2px solid transparent; }
    .fi-nav-item:hover { background: rgba(255,255,255,0.02); color: #fff; }
    .fi-nav-item.active { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border-left-color: #3b82f6; font-weight: 700; }
    .fi-pre { background: #1a1b1e; padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); color: #e2e8f0; font-size: 13px; line-height: 1.6; overflow-x: auto; white-space: pre-wrap; margin: 0; }
    .fi-tabs { display: flex; background: rgba(255,255,255,0.03); padding: 4px; border-radius: 8px; margin-top: 4px; }
    .fi-tab { padding: 6px 16px; font-size: 11px; font-weight: 800; color: #64748b; cursor: pointer; border-radius: 6px; text-transform: uppercase; transition: all 0.2s; }
    .fi-tab.active { background: #3b82f6; color: #fff; }
</style>
{% endblock %}

{% block scripts %}
<script>
const activePolls = new Set();

function toggleAudit(scanId) {
    const row = document.getElementById('audit-' + scanId);
    if (row.style.display === 'none') {
        row.style.display = 'table-row';
        startPolling(scanId);
    } else {
        row.style.display = 'none';
        stopPolling(scanId);
    }
}

function startPolling(scanId) {
    if (activePolls.has(scanId)) return;
    activePolls.add(scanId);
    fetchStatus(scanId);
}

function stopPolling(scanId) {
    activePolls.delete(scanId);
}

function fetchStatus(scanId) {
    if (!activePolls.has(scanId)) return;

    fetch('/admin/scans/status/' + scanId)
        .then(r => r.json())
        .then(job => {
            renderLogs(scanId, job);
            
            if (job.status === 'running' || job.status === 'queued') {
                setTimeout(() => fetchStatus(scanId), 3000);
            }
        });
}

function renderLogs(scanId, job) {
    if (!job) return;
    const console = document.getElementById('log-console-' + scanId);
    const statusLabel = document.getElementById('log-status-' + scanId);
    if (!console || !statusLabel) return;
    
    const status = (job.status || 'unknown').toUpperCase();
    const percent = job.progress_percent || 0;
    statusLabel.innerText = `STATUS: ${status} (${percent}%)`;
    
    let html = '';
    if (job.checkpoints && Array.isArray(job.checkpoints) && job.checkpoints.length > 0) {
        job.checkpoints.forEach(cp => {
            const ts = cp.ts ? (cp.ts.includes(' ') ? cp.ts.split(' ')[1] : cp.ts) : '--:--:--';
            const color = cp.status === 'success' ? '#6a9955' : '#f44747';
            const stageColor = '#569cd6';
            const stage = cp.stage || 'Process Step';
            const statusDisplay = (cp.status || 'Executing').toUpperCase();
            
            html += `<div style="margin-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 4px;">`;
            html += `<span style="color: #808080; font-family: monospace;">[${ts}]</span> `;
            html += `<span style="color: ${stageColor}; font-weight: bold;">${stage}</span>: `;
            html += `<span style="color: ${color}; font-size: 10px; font-weight: 800;">${statusDisplay}</span>`;
            
            if (cp.meta && typeof cp.meta === 'object' && Object.keys(cp.meta).length > 0) {
                html += `<div style="padding-left: 20px; color: #9cdcfe; font-size: 11px; margin-top: 2px;">`;
                Object.entries(cp.meta).forEach(([k, v]) => {
                    const val = typeof v === 'object' ? JSON.stringify(v) : v;
                    html += `<div><span style="color: #cccccc; opacity: 0.7;">${k}:</span> ${val}</div>`;
                });
                html += `</div>`;
            }
            html += `</div>`;
        });
    } else {
        html = `<div style="color: #808080; font-style: italic; padding: 10px;">// Initializing forensic technical audit stream...</div>`;
    }
    
    console.innerHTML = html;
    console.scrollTop = console.scrollHeight;
}

function openScanPromptModal(jobId) {
    const modal = document.getElementById('promptModal');
    const content = document.getElementById('promptModalContent');
    
    modal.style.display = 'flex';
    content.innerHTML = '<div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #6b7280; font-family: monospace;">FETCHING GLOBAL AI CONTEXT TRACE...</div>';
    
    fetch(`/admin/scans/prompt/${jobId}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(resp => {
        if (resp.success) {
            renderForensicInspector(resp.data, resp.title, 'AI TRACE');
        } else {
            content.innerHTML = `<div style="color: var(--error); padding: 40px; text-align: center;">${resp.message || 'Failed to load AI trace.'}</div>`;
        }
    })
    .catch(err => {
        content.innerHTML = `<div style="color: var(--error); padding: 40px; text-align: center;">Network Error: ${err.message}</div>`;
    });
}

function renderForensicInspector(rawData, title, badgeText) {
    const modalTitle = document.getElementById('promptModalTitle');
    const typeBadge = document.getElementById('promptTypeBadge');
    const content = document.getElementById('promptModalContent');
    
    modalTitle.innerText = title;
    typeBadge.innerText = badgeText;
    typeBadge.style.background = badgeText === 'AI TRACE' ? '#3b82f6' : '#10b981';
    
    const parsed = parseForensicPrompt(rawData);
    
    let sidebarHtml = '';
    let mainHtml = '<div id="fi-payload-view" class="fi-tab-content">';
    
    // 1. Data Sets
    if (parsed.data_sets.length > 0) {
        parsed.data_sets.forEach((set, idx) => {
            const setId = `dataset-${idx}`;
            sidebarHtml += `<div class="fi-nav-item" onclick="scrollToFiSection('${setId}', this)">Data Set ${idx + 1}</div>`;
            
            mainHtml += `<div id="${setId}" class="fi-section">
                <div class="fi-section-header">
                    <span style="font-size: 20px;">📦</span>
                    <span class="fi-section-title">Data Set ${idx + 1}: Diagnostic Payload</span>
                </div>`;
            
            if (set.identity) {
                mainHtml += `<div style="background: rgba(255,255,255,0.03); padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05); margin-bottom: 20px;">
                    <div style="font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 4px;">Forensic Identity</div>
                    <div style="font-size: 13px; color: #fff; font-weight: 600;">${set.identity}</div>
                </div>`;
            }
            
            set.sections.forEach((sec, sidx) => {
                const secId = `${setId}-sec-${sidx}`;
                sidebarHtml += `<div class="fi-nav-item" style="padding-left: 40px; font-weight: 500; font-size: 10px;" onclick="scrollToFiSection('${secId}', this)">${sec.title}</div>`;
                
                mainHtml += `<div id="${secId}" style="margin-top: 24px;">
                    <div style="font-size: 11px; font-weight: 800; color: #3b82f6; margin-bottom: 8px; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                        <span>${sec.is_json ? '📊' : '📄'}</span> ${sec.title}
                    </div>
                    <pre class="fi-pre">${sec.content.trim()}</pre>
                </div>`;
            });
            
            mainHtml += `</div>`;
        });
    } else {
        mainHtml += `<div style="padding: 40px; text-align: center; color: #64748b;">No structured data sets identified in this trace.</div>
                    <pre class="fi-pre">${typeof rawData === 'string' ? rawData : JSON.stringify(rawData, null, 2)}</pre>`;
    }
    
    mainHtml += '</div>';
    
    // 2. System Prompt View (hidden by default)
    mainHtml += `<div id="fi-system-view" class="fi-tab-content" style="display: none;">
        <div class="fi-section">
            <div class="fi-section-header">
                <span style="font-size: 20px;">⚙️</span>
                <span class="fi-section-title">System Context & Forensic Rules</span>
            </div>
            <pre class="fi-pre" style="color: #9cdcfe;">${parsed.system_prompt || 'No system instructions provided.'}</pre>
        </div>
    </div>`;

    // Assemble Final UI
    content.innerHTML = `
        <div class="fi-container">
            <div class="fi-sidebar">
                <div style="padding: 16px 24px; font-size: 10px; font-weight: 800; color: #4b5563; text-transform: uppercase; letter-spacing: 0.1em;">Navigator</div>
                ${sidebarHtml}
            </div>
            <div class="fi-main">
                ${mainHtml}
            </div>
        </div>
    `;

    // Add Tab Switcher to header
    const header = modalTitle.parentElement;
    if (!header.parentElement.querySelector('.fi-tabs')) {
        const tabs = document.createElement('div');
        tabs.className = 'fi-tabs';
        tabs.innerHTML = `
            <div class="fi-tab active" onclick="switchFiTab('payload', this)">Payload Explorer</div>
            <div class="fi-tab" onclick="switchFiTab('system', this)">System Prompt</div>
        `;
        header.after(tabs);
    }
}

function parseForensicPrompt(data) {
    const result = { system_prompt: '', data_sets: [] };
    if (typeof data !== 'string') return result;

    // Split System/User
    const promptParts = data.split('USER PROMPT:');
    result.system_prompt = promptParts[0].replace('SYSTEM PROMPT:', '').trim();
    
    const userContent = promptParts[1] || '';
    if (!userContent) return result;

    // Split into Data Sets
    const sets = userContent.split('### DATA SET').filter(s => s.trim());
    
    sets.forEach(setStr => {
        const lines = setStr.split("\n");
        const setObj = { identity: '', sections: [] };
        
        let currentSection = null;
        
        lines.forEach(line => {
            if (line.startsWith('- Device Identity:')) {
                setObj.identity = line.replace('- Device Identity:', '').trim();
            } else if (line.startsWith('####')) {
                if (currentSection) setObj.sections.push(currentSection);
                currentSection = { title: line.replace('####', '').trim(), content: '', is_json: false };
            } else if (currentSection) {
                currentSection.content += line + "\n";
                if (line.trim().startsWith('{') || line.trim().startsWith('[')) currentSection.is_json = true;
            }
        });
        if (currentSection) setObj.sections.push(currentSection);
        result.data_sets.push(setObj);
    });

    return result;
}

function switchFiTab(type, el) {
    document.querySelectorAll('.fi-tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    
    if (type === 'payload') {
        document.getElementById('fi-payload-view').style.display = 'block';
        document.getElementById('fi-system-view').style.display = 'none';
        document.querySelector('.fi-sidebar').style.display = 'block';
    } else {
        document.getElementById('fi-payload-view').style.display = 'none';
        document.getElementById('fi-system-view').style.display = 'block';
        document.querySelector('.fi-sidebar').style.display = 'none';
    }
}

function scrollToFiSection(id, el) {
    const target = document.getElementById(id);
    if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        document.querySelectorAll('.fi-nav-item').forEach(item => item.classList.remove('active'));
        el.classList.add('active');
    }
}

function abortJob(scanId) {
    if (!confirm('Are you sure you want to abort this forensic analysis?')) return;
    
    fetch(`/admin/scans/abort/${scanId}`, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Failed to abort job: ' + (data.message || 'Unknown error'));
            }
        });
}

function closePromptModal() {
    document.getElementById('promptModal').style.display = 'none';
    const tabSwitcher = document.querySelector('.fi-tabs');
    if (tabSwitcher) tabSwitcher.remove();
}
</script>
{% endblock %}
