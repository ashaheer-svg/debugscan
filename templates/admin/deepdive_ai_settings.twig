{% extends "layout/admin.twig" %}

{% block admin_content %}
<style>
    .deepdive-settings-container {
        max-width: 800px;
    }
    .deepdive-settings-container h2 {
        font-size: 24px;
        font-weight: 700;
        color: #2D3436;
        margin-bottom: 12px;
    }
    .deepdive-settings-container > p {
        color: #666;
        font-size: 14px;
        margin-bottom: 32px;
    }
</style>

<div class="deepdive-settings-container">
    {{ settings_html | raw }}
</div>

<script>
// Inject CSRF token directly (from Twig global)
// Slim expects BOTH the token name field AND the token value field
window.CSRF_TOKEN = {
    nameField: '{{ csrf.keys.name|default('csrf_name') }}',     // Field name for the token name (e.g., 'csrf_name')
    nameValue: '{{ csrf.name|default('') }}',                     // Actual token name value
    valueField: '{{ csrf.keys.value|default('csrf_value') }}',   // Field name for the token value (e.g., 'csrf_value')
    value: '{{ csrf.value|default('') }}'                         // Actual token value
};
console.log('CSRF Token loaded:', {
    nameField: window.CSRF_TOKEN.nameField,
    nameValue: window.CSRF_TOKEN.nameValue ? window.CSRF_TOKEN.nameValue.substring(0, 10) + '...' : 'EMPTY',
    valueField: window.CSRF_TOKEN.valueField,
    value: window.CSRF_TOKEN.value ? window.CSRF_TOKEN.value.substring(0, 10) + '...' : 'EMPTY'
});
</script>
{% endblock %}
