{% extends "layout/admin.twig" %}

{% block admin_content %}
<style>
    .deepdive-settings-container {
        max-width: 800px;
    }
    .deepdive-settings-container h2 {
        font-size: 24px;
        font-weight: 700;
        color: #2D3436;
        margin-bottom: 12px;
    }
    .deepdive-settings-container > p {
        color: #666;
        font-size: 14px;
        margin-bottom: 32px;
    }
</style>

<div class="deepdive-settings-container">
    {# Inject CSRF token as a data attribute for JavaScript access #}
    <div id="csrf-container" data-csrf-name="{{ csrf.name|default('__csrf') }}" data-csrf-value="{{ csrf.value|default('') }}"></div>
    {{ settings_html | raw }}
</div>

<script>
// Make CSRF token available to the form JavaScript
window.CSRF_TOKEN = {
    name: document.getElementById('csrf-container').dataset.csrfName,
    value: document.getElementById('csrf-container').dataset.csrfValue
};
</script>
{% endblock %}
