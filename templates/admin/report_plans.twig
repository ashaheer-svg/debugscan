{% extends "layout/admin.twig" %}

{% block title %}Forensic Report Packages - AI DebugScan v3{% endblock %}

{% block admin_content %}
<header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px;">
    <div>
        <h1 style="font-size: 24px; font-weight: 800; color: var(--text-primary); margin-bottom: 6px;">Forensic Report Packages</h1>
        <p style="color: var(--text-muted); font-size: 14px; font-weight: 500;">
            Define customizable forensic reporting plans with specialized AI prompt headers and token charges.
        </p>
    </div>
    <button class="btn btn-primary" onclick="openPlanModal()" style="padding: 10px 24px; font-weight: 700;">
        <i class="fas fa-plus" style="margin-right: 8px;"></i>Create New Package
    </button>
</header>

{% if success %}
    <div class="alert alert-success" style="margin-bottom: 20px;">{{ success }}</div>
{% endif %}
{% if error %}
    <div class="alert alert-danger" style="margin-bottom: 20px;">{{ error }}</div>
{% endif %}

<div class="card" style="padding: 0; overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-1);">
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="background: var(--bg-light); border-bottom: 1px solid var(--border);">
                <th style="padding: 16px 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Package Name</th>
                <th style="padding: 16px 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">AI Model</th>
                <th style="padding: 16px 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Token Cost</th>
                <th style="padding: 16px 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Status</th>
                <th style="padding: 16px 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for plan in plans %}
            <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 16px 24px;">
                    <div style="font-weight: 700; color: var(--text-primary);">{{ plan.name }}</div>
                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">ID: {{ plan.id }}</div>
                </td>
                <td style="padding: 16px 24px; font-size: 13px; font-family: monospace; color: var(--text-secondary);">
                    {{ plan.ai_model }}
                </td>
                <td style="padding: 16px 24px;">
                    <span style="font-weight: 700; color: var(--primary);">{{ plan.token_charge|number_format }}</span>
                    <span style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-left: 4px;">Tokens</span>
                </td>
                <td style="padding: 16px 24px;">
                    {% if plan.is_active %}
                        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: #f0fdf4; color: #16a34a; border-radius: 20px; font-size: 11px; font-weight: 700;">
                            <span style="width: 6px; height: 6px; background: #16a34a; border-radius: 50%;"></span>
                            ACTIVE
                        </span>
                    {% else %}
                        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: #fef2f2; color: #dc2626; border-radius: 20px; font-size: 11px; font-weight: 700;">
                            <span style="width: 6px; height: 6px; background: #dc2626; border-radius: 50%;"></span>
                            INACTIVE
                        </span>
                    {% endif %}
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/admin/extraction-config/{{ plan.id }}" class="btn btn-secondary btn-sm" title="Configure Extraction Rules">
                            <i class="fas fa-microscope" style="margin-right: 6px;"></i>Forensic Rules
                        </a>
                        <button class="btn btn-secondary btn-sm" onclick="openPlanModal({{ plan|json_encode|e('html_attr') }})">
                            <i class="fas fa-edit"></i>
                        </button>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" style="padding: 40px; text-align: center; color: var(--text-muted);">
                    <i class="fas fa-box-open" style="font-size: 32px; display: block; margin-bottom: 12px; opacity: 0.3;"></i>
                    No forensic report packages defined yet.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Plan Management Modal #}
<div id="planModal" class="modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="modal-content" style="background: white; width: 600px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-3);">
        <header style="padding: 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
            <h2 id="modalTitle" style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0;">Create Forensic Package</h2>
            <button onclick="closePlanModal()" style="background: none; border: none; font-size: 20px; color: var(--text-muted); cursor: pointer;">&times;</button>
        </header>
        <form action="/admin/report-plans/save" method="POST" style="padding: 24px;">
            <input type="hidden" name="id" id="plan_id">
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px;">Package Name</label>
                    <input type="text" name="name" id="plan_name" required placeholder="e.g. Deep Storage Audit"
                           style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-weight: 600;">
                </div>
                <div class="form-group">
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px;">Token Charge</label>
                    <input type="number" name="token_charge" id="plan_token_charge" required value="100000"
                           style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-weight: 600;">
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px;">AI Model</label>
                <select name="ai_model" id="plan_ai_model" required style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-weight: 600; background: var(--bg-light);">
                    <option value="llama-3.3-70b-versatile">Llama 3.3 70B (Versatile/Balanced)</option>
                    <option value="llama-3.1-8b-instant">Llama 3.1 8B (Instant/Fast)</option>
                    <option value="mixtral-8x7b-32768">Mixtral 8x7B (Deep Analysis)</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
                <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px;">
                    Custom Prompt Header
                    <i class="fas fa-info-circle" style="margin-left: 4px; pointer-events: auto;" title="This text will be prepended to the AI forensic rules. Use it to steer the analysis."></i>
                </label>
                <textarea name="prompt_header" id="plan_prompt_header" rows="4" placeholder="e.g. Focus specifically on identifying file system corruption and storage pool health."
                          style="width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-family: inherit; font-size: 14px; line-height: 1.5;"></textarea>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center;">
                <label style="display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--text-secondary); cursor: pointer;">
                    <input type="checkbox" name="is_active" id="plan_is_active" value="1" checked style="width: 18px; height: 18px;">
                    Make this package available for selection
                </label>
                <div style="display: flex; gap: 12px;">
                    <button type="button" onclick="closePlanModal()" class="btn btn-secondary">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="padding-inline: 32px;">Save Package</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
function openPlanModal(plan = null) {
    const modal = document.getElementById('planModal');
    const title = document.getElementById('modalTitle');
    const idInput = document.getElementById('plan_id');
    const nameInput = document.getElementById('plan_name');
    const tokenInput = document.getElementById('plan_token_charge');
    const modelSelect = document.getElementById('plan_ai_model');
    const headerInput = document.getElementById('plan_prompt_header');
    const activeCheck = document.getElementById('plan_is_active');

    if (plan) {
        title.innerText = 'Edit Forensic Package';
        idInput.value = plan.id;
        nameInput.value = plan.name;
        tokenInput.value = plan.token_charge;
        modelSelect.value = plan.ai_model;
        headerInput.value = plan.prompt_header || '';
        activeCheck.checked = !!plan.is_active;
    } else {
        title.innerText = 'Create Forensic Package';
        idInput.value = '';
        nameInput.value = '';
        tokenInput.value = '100000';
        modelSelect.value = 'llama-3.3-70b-versatile';
        headerInput.value = '';
        activeCheck.checked = true;
    }

    modal.style.display = 'flex';
}

function closePlanModal() {
    document.getElementById('planModal').style.display = 'none';
}

// Close modal on outside click
window.onclick = function(event) {
    const modal = document.getElementById('planModal');
    if (event.target == modal) {
        closePlanModal();
    }
}
</script>
{% endblock %}
