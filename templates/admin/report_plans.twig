{% extends "layout/admin.twig" %}

{% block title %}Forensic Report Packages - AI DebugScan v3{% endblock %}

{% block admin_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px;">
    <div>
        <h1 class="admin-title" style="margin-bottom: 8px;">Forensic Report Packages</h1>
        <p class="page-subtitle">
            Define customizable forensic reporting plans with specialized AI prompt headers and token charges.
        </p>
    </div>
    <button class="btn btn-primary" onclick="openPlanModal()" style="padding: 10px 24px; font-weight: 700;">
        <i class="fas fa-plus" style="margin-right: 8px;"></i>Create New Package
    </button>
</header>

{% if success %}
    <div class="alert alert-success" style="margin-bottom: 20px;">{{ success }}</div>
{% endif %}
{% if error %}
    <div class="alert alert-danger" style="margin-bottom: 20px;">{{ error }}</div>
{% endif %}

<div class="card" style="padding: 0; overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-1);">
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="background: var(--bg-light); border-bottom: 1px solid var(--border);">
                <th style="padding: 16px 24px;">Package Name</th>
                <th style="padding: 16px 24px;">AI Model</th>
                <th style="padding: 16px 24px;">Token Cost</th>
                <th style="padding: 16px 24px;">Status</th>
                <th style="padding: 16px 24px; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for plan in plans %}
            <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 16px 24px;">
                    <div style="font-weight: 700; color: var(--text-primary);">{{ plan.name }}</div>
                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">ID: {{ plan.id }}</div>
                </td>
                <td style="padding: 16px 24px; font-size: 13px; font-family: monospace; color: var(--text-secondary);">
                    {{ plan.ai_model }}
                </td>
                <td style="padding: 16px 24px;">
                    <span style="font-weight: 700; color: var(--primary);">{{ plan.token_charge|number_format }}</span>
                    <span style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-left: 4px;">Tokens</span>
                </td>
                <td style="padding: 16px 24px;">
                    {% if plan.is_active %}
                        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: #f0fdf4; color: #16a34a; border-radius: 20px; font-size: 11px; font-weight: 700;">
                            <span style="width: 6px; height: 6px; background: #16a34a; border-radius: 50%;"></span>
                            ACTIVE
                        </span>
                    {% else %}
                        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: #fef2f2; color: #dc2626; border-radius: 20px; font-size: 11px; font-weight: 700;">
                            <span style="width: 6px; height: 6px; background: #dc2626; border-radius: 50%;"></span>
                            INACTIVE
                        </span>
                    {% endif %}
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/admin/extraction-config/{{ plan.id }}" class="btn-action btn-info-alt" title="Configure Extraction Rules" data-tooltip="Forensic Rules">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                        <button class="btn-action btn-edit" onclick="openPlanModal({{ plan|json_encode|e('html_attr') }})" title="Edit Package" data-tooltip="Edit Package">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>
                        <button class="btn-action btn-danger-alt btn-delete" onclick="confirmDelete('{{ plan.id }}', '{{ plan.name|e('js') }}')" title="Delete Package" data-tooltip="Delete Package">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" style="padding: 40px; text-align: center; color: var(--text-muted);">
                    <i class="fas fa-box-open" style="font-size: 32px; display: block; margin-bottom: 12px; opacity: 0.3;"></i>
                    No forensic report packages defined yet.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Plan Management Modal #}
<div id="planModal" class="modal-overlay" onclick="if(event.target === this) closePlanModal()">
    <div class="modal-content" style="background: white; width: 850px; max-width: 90vw; padding: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-4);">
        <header style="padding: 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: var(--bg-off-white);">
            <h2 id="modalTitle" style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0;">Create Forensic Package</h2>
            <button onclick="closePlanModal()" style="background: none; border: none; font-size: 24px; color: var(--text-muted); cursor: pointer; transition: color 0.2s;">&times;</button>
        </header>
        <form action="/admin/report-plans/save" method="POST" style="padding: 24px;">
            {{ csrf.inputs | raw }}
            <input type="hidden" name="id" id="plan_id">
            
            <div style="display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 24px; margin-bottom: 24px;">
                <div class="form-group">
                    <label style="display: block; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em;">Package Name</label>
                    <input type="text" name="name" id="plan_name" required placeholder="e.g. Deep Storage Audit"
                           style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-weight: 600; font-size: 14px;">
                </div>
                <div class="form-group" style="grid-column: span 1;">
                    <label style="display: block; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em;">AI Model</label>
                    <select name="ai_model" id="plan_ai_model" required onchange="updateModelInfo()" style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-weight: 600; background: var(--bg-light); font-size: 14px;">
                        {% for model in available_models %}
                            <option value="{{ model.id }}">{{ model.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <!-- Model Insights Box -->
                <div id="model_insights" style="grid-column: span 3; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: var(--radius); padding: 12px 16px; margin-top: -8px; display: none; align-items: center; gap: 20px;">
                    <div style="flex: 1;">
                        <span style="display: block; font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase;">Max Input (Context)</span>
                        <span id="insight_window" style="font-size: 15px; font-weight: 800; color: var(--primary);">0</span>
                    </div>
                    <div style="flex: 1; border-left: 1px solid #e2e8f0; padding-left: 20px;">
                        <span style="display: block; font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase;">Max Output</span>
                        <span id="insight_output" style="font-size: 15px; font-weight: 800; color: #ef4444;">0</span>
                    </div>
                    <div style="flex: 1; border-left: 1px solid #e2e8f0; padding-left: 20px;">
                        <span style="display: block; font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase;">Provider</span>
                        <span id="insight_provider" style="font-size: 14px; font-weight: 700; color: var(--text-secondary); text-transform: capitalize;">-</span>
                    </div>
                    <div style="flex: 2; border-left: 1px solid #e2e8f0; padding-left: 20px;">
                        <p id="insight_note" style="margin: 0; font-size: 12px; color: #475569; line-height: 1.4;"></p>
                    </div>
                </div>
                <div class="form-group">
                    <label style="display: block; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em;">Token Charge</label>
                    <input type="number" name="token_charge" id="plan_token_charge" required value="100000"
                           style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-weight: 700; color: var(--primary); font-size: 14px;">
                </div>
                <div class="form-group">
                    <label style="display: block; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em;">
                        Master Lookback Days
                        <i class="fas fa-info-circle" style="margin-left: 4px;" title="Override: Only logs/events within this many days will be sent for AI analysis and displayed. Set to 0 for unlimited."></i>
                    </label>
                    <input type="number" name="master_lookback_days" id="plan_master_lookback_days" required value="0" min="0"
                           style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-weight: 700; color: #4f46e5; font-size: 14px;">
                    <p style="font-size: 10px; color: var(--text-muted); margin-top: 4px;">0 = No limit (Full diagnostic history)</p>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
                <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px;">
                    Custom Prompt Header
                    <i class="fas fa-info-circle" style="margin-left: 4px; pointer-events: auto;" title="This text will be prepended to the AI forensic rules. Use it to steer the analysis."></i>
                </label>
                <textarea name="prompt_header" id="plan_prompt_header" rows="4" placeholder="e.g. Focus specifically on identifying file system corruption and storage pool health."
                          style="width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-family: inherit; font-size: 14px; line-height: 1.5;"></textarea>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center;">
                <label style="display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--text-secondary); cursor: pointer;">
                    <input type="checkbox" name="is_active" id="plan_is_active" value="1" checked style="width: 18px; height: 18px;">
                    Make this package available for selection
                </label>
                <div style="display: flex; gap: 12px;">
                    <button type="button" onclick="closePlanModal()" class="btn btn-secondary">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="padding-inline: 32px;">Save Package</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
function openPlanModal(plan = null) {
    const modal = document.getElementById('planModal');
    const title = document.getElementById('modalTitle');
    const idInput = document.getElementById('plan_id');
    const nameInput = document.getElementById('plan_name');
    const tokenInput = document.getElementById('plan_token_charge');
    const modelSelect = document.getElementById('plan_ai_model');
    const headerInput = document.getElementById('plan_prompt_header');
    const activeCheck = document.getElementById('plan_is_active');
    const lookbackInput = document.getElementById('plan_master_lookback_days');

    if (plan) {
        title.innerText = 'Edit Forensic Package';
        idInput.value = plan.id;
        nameInput.value = plan.name;
        tokenInput.value = plan.token_charge;
        modelSelect.value = plan.ai_model;
        headerInput.value = plan.prompt_header || '';
        activeCheck.checked = !!plan.is_active;
        lookbackInput.value = plan.master_lookback_days || 0;
    } else {
        title.innerText = 'Create Forensic Package';
        idInput.value = '';
        nameInput.value = '';
        tokenInput.value = '100000';
        modelSelect.value = 'llama-3.3-70b-versatile';
        headerInput.value = '';
        activeCheck.checked = true;
        lookbackInput.value = 0;
    }

    modal.style.display = 'flex';
    updateModelInfo();
}

const modelMetadata = {{ models_json|raw }};

function updateModelInfo() {
    const select = document.getElementById('plan_ai_model');
    const container = document.getElementById('model_insights');
    const windowEl = document.getElementById('insight_window');
    const outputEl = document.getElementById('insight_output');
    const providerEl = document.getElementById('insight_provider');
    const noteEl = document.getElementById('insight_note');

    const modelId = select.value;
    const model = modelMetadata.find(m => m.id === modelId);

    if (model) {
        container.style.display = 'flex';
        const windowVal = model.context_window;
        const outputVal = model.max_output_tokens;
        windowEl.innerText = windowVal ? windowVal.toLocaleString() : 'Unknown';
        outputEl.innerText = outputVal ? outputVal.toLocaleString() : 'Unknown';
        providerEl.innerText = model.owned_by || 'Unknown';

        // Custom notes based on window size
        if (windowVal >= 100000) {
            noteEl.innerText = "High-capacity model. Suitable for massive forensic archives and multiple device correlation.";
        } else if (windowVal >= 30000) {
            noteEl.innerText = "Standard capacity. Ideal for single-device diagnostic audits.";
        } else {
            noteEl.innerText = "Limited window. Best for targeted log analysis or small snippets.";
        }
    } else {
        container.style.display = 'none';
    }
}

function closePlanModal() {
    document.getElementById('planModal').style.display = 'none';
}

function confirmDelete(id, name) {
    if (confirm(`Are you sure you want to delete the forensic package "${name}"?\n\nThis will remove all associated extraction rules and authorized mapping for tenants.`)) {
        const form = document.getElementById('deleteForm');
        document.getElementById('delete_plan_id').value = id;
        form.submit();
    }
}

// Close modal on outside click
window.onclick = function(event) {
    const modal = document.getElementById('planModal');
    if (event.target == modal) {
        closePlanModal();
    }
}
</script>

<form id="deleteForm" action="/admin/report-plans/delete" method="POST" style="display: none;">
    {{ csrf.inputs | raw }}
    <input type="hidden" name="id" id="delete_plan_id">
</form>
{% endblock %}
