{% extends "layout/admin.twig" %}

{% block title %}Admin Dashboard - AI DebugScan v3{% endblock %}

{% block admin_content %}
<h1 class="admin-title">System Health & Metrics</h1>

<div class="stats-grid">
    <div class="stat-card">
        <h2 class="stat-value">{{ tenant_count }}</h2>
        <p class="stat-label">Active Tenants</p>
    </div>
    <div class="stat-card">
        <h2 class="stat-value">{{ total_scans|number_format }}</h2>
        <p class="stat-label">Total Scans Executed</p>
    </div>
    <div class="stat-card">
        <h2 class="stat-value">{{ (tokens_used / 1000)|round(1) }}k</h2>
        <p class="stat-label">Groq Tokens Consumed</p>
    </div>
    <div class="stat-card">
        <h2 class="stat-value">{{ cpu_load }}</h2>
        <p class="stat-label">CPU Load (1m)</p>
    </div>
    <div class="stat-card">
        <h2 class="stat-value">{{ disk_free_gb }} GB</h2>
        <p class="stat-label">Disk Free Space ({{ 100 - disk_used_percent }}%)</p>
    </div>

</div>

{% if stuck_scans %}
<div style="background: #fff5f5; border: 1px solid #feb2b2; border-radius: var(--radius); padding: 20px; margin-bottom: 32px; display: flex; flex-direction: column; gap: 16px;">
    <div style="display: flex; align-items: center; gap: 12px; color: #c53030;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Stuck Scans Detected</h3>
    </div>
    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
    {% for scan in stuck_scans %}
        <li style="display: flex; justify-content: space-between; align-items: center; background: white; padding: 12px 16px; border-radius: 6px; border: 1px solid #fed7d7;">
            <div>
                <div style="font-weight: 700; font-size: 13px;">{{ scan.tenant_name }} - {{ scan.id|slice(0,8) }}</div>
                <div style="font-size: 11px; color: #718096;">Last Activity: {{ scan.updated_at|date('H:i:s') }} ({{ scan.progress_stage }})</div>
            </div>
            <button onclick="abortStuckScan('{{ scan.id }}')" style="background: #e53e3e; color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer;">ABORT (ERROR)</button>
        </li>
    {% endfor %}
    </ul>
</div>
<script>
function abortStuckScan(id) {
    if(!confirm('Abort this scan? It will be marked as ERROR on the tenant side.')) return;
    fetch('/admin/scans/abort/' + id, {method: 'POST'})
    .then(r => r.json())
    .then(d => { if(d.success) location.reload(); });
}
</script>
{% endif %}

<div style="background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
    <h3 style="margin-bottom: 24px; font-weight: 700; color: #2D3436;">Global Audit Log</h3>
    
    {% if recent_activity %}
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">
                <th style="padding: 12px 0;">Timestamp</th>
                <th style="padding: 12px 0;">User</th>
                <th style="padding: 12px 0;">Action</th>
                <th style="padding: 12px 0;">Details</th>
            </tr>
        </thead>
        <tbody>
            {% for log in recent_activity %}
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 13px;">
                <td style="padding: 16px 0; color: var(--text-secondary);">{{ log.created_at|date('M d, H:i:s') }}</td>
                <td style="padding: 16px 0; font-weight: 600;">{{ log.user_name|default('System') }}</td>
                <td style="padding: 16px 0;">
                    <span class="badge" style="background: var(--bg-light); color: var(--text-primary); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border); font-size: 11px; font-weight: 600;">{{ log.action }}</span>
                </td>
                <td style="padding: 16px 0; color: var(--text-secondary);">{{ log.details|default('N/A') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div style="padding: 40px; text-align: center; color: var(--text-muted);">No recent logs.</div>
    {% endif %}
</div>
{% endblock %}
