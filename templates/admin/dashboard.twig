{% extends "layout/admin.twig" %}

{% block title %}Admin Dashboard - AI DebugScan v3{% endblock %}

{% block admin_content %}
<header class="page-header">
    <h1 class="page-title">System Health & Metrics</h1>
    <p class="page-subtitle">Real-time governance and resource utilization overview.</p>
</header>

<div class="kpi-grid">
    <div class="kpi-card">
        <h2 class="kpi-value">{{ tenant_count }}</h2>
        <p class="kpi-label">Active Tenants</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ total_scans|number_format }}</h2>
        <p class="kpi-label">Total Scans</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ (tokens_used / 1000)|round(1) }}k</h2>
        <p class="kpi-label">Tokens Used</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ cpu_load }}</h2>
        <p class="kpi-label">CPU Load</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ disk_free_gb }} GB</h2>
        <p class="kpi-label">Disk Free ({{ 100 - disk_used_percent }}%)</p>
    </div>
</div>

{% if stuck_scans %}
<div class="card" style="background: var(--danger-light); border: 1px solid var(--danger); margin-bottom: 32px;">
    <div style="display: flex; align-items: center; gap: 12px; color: var(--danger); margin-bottom: 20px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Stuck Scans Detected</h3>
    </div>
    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
    {% for scan in stuck_scans %}
        <li style="display: flex; justify-content: space-between; align-items: center; background: white; padding: 12px 16px; border-radius: 6px; border: 1px solid var(--border);">
            <div>
                <div style="font-weight: 700; font-size: 13px; color: var(--text-primary);">{{ scan.tenant_name }} - #{{ scan.id|slice(0,8) }}</div>
                <div style="font-size: 11px; color: var(--text-muted);">Last Activity: {{ scan.updated_at|date('H:i:s') }} (${{ scan.progress_stage }})</div>
            </div>
            <button onclick="abortStuckScan('{{ scan.id }}')" class="btn btn-danger" style="height: 32px; font-size: 11px; font-weight: 700;">ABORT (ERROR)</button>
        </li>
    {% endfor %}
    </ul>
</div>
<script>
function abortStuckScan(id) {
    if(!confirm('Abort this scan? It will be marked as ERROR on the tenant side.')) return;
    fetch('/admin/scans/abort/' + id, {method: 'POST'})
    .then(r => r.json())
    .then(d => { if(d.success) location.reload(); });
}
</script>
{% endif %}

<section class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); background: var(--bg-off-white);">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Global Audit Log</h3>
    </div>
    
    {% if recent_activity %}
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Timestamp</th>
                <th>User</th>
                <th>Action</th>
                <th style="padding-right: 24px;">Details</th>
            </tr>
        </thead>
        <tbody>
            {% for log in recent_activity %}
            <tr>
                <td style="padding-left: 24px; color: var(--text-secondary); font-size: 13px;">{{ log.created_at|date('M d, H:i:s') }}</td>
                <td style="font-weight: 600;">{{ log.user_name|default('System') }}</td>
                <td>
                    <span class="badge" style="background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border);">{{ log.action|upper }}</span>
                </td>
                <td style="padding-right: 24px; color: var(--text-secondary); font-size: 13px;">{{ log.details|default('N/A') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div style="padding: 64px; text-align: center; color: var(--text-muted);">
        <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">📋</div>
        <div style="font-weight: 600; color: var(--text-primary);">No recent logs available</div>
    </div>
    {% endif %}
</section>
{% endblock %}
{% endblock %}
