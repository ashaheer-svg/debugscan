{% extends "layout/base.twig" %}

{% block title %}Sign In - AI DebugScan v3{% endblock %}

{% block content %}
<div class="auth-container">
    <article class="auth-card">
        <div style="margin-bottom: 8px;">
            <img src="/assets/img/logo-black.png" alt="AI DebugScan" style="height: 42px; width: auto; object-fit: contain;">
        </div>
        <p class="auth-subtitle" style="margin-top: 0;">Professional Forensic Diagnostics</p>

        {% if error %}
        <div class="alert alert-danger" role="alert">
            {{ error }}
        </div>
        {% endif %}

        <form action="/auth/login" method="POST">
            {{ csrf.inputs | raw }}
            
            <div class="form-group">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="admin@debugscan.local" required autofocus>
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <div style="position: relative;">
                    <input type="password" id="password" name="password" class="form-control" required>
                    <!-- Password toggle can be added here with Alpine.js -->
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                Sign In &nbsp; &#9656;
            </button>
        </form>

        <footer style="margin-top: 24px; font-size: 13px; color: var(--text-muted);">
            Forgot your password? Contact admin
        </footer>
    </article>
</div>
{% endblock %}
