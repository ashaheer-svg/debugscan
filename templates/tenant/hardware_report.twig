{% extends "layout/dashboard.twig" %}

{% set active_page = 'projects' %}

{% block title %}Hardware Digest — {{ file.nas_model|default('Unknown Device') }}{% endblock %}

{% block head %}
    {{ parent() }}
    <style>
        /* ── Tab Navigation ── */
        .hd-tabs {
            display: flex; gap: 2px;
            background: var(--bg-off-white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 4px;
            margin-bottom: 28px;
        }
        .hd-tab {
            flex: 1; display: flex; align-items: center; justify-content: center; gap: 7px;
            padding: 10px 16px; border-radius: calc(var(--radius) - 2px);
            font-size: 12px; font-weight: 700; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.05em;
            cursor: pointer; border: none; background: transparent;
            transition: all 0.18s;
        }
        .hd-tab:hover { background: var(--white); color: var(--text-primary); }
        .hd-tab.active { background: var(--white); color: var(--primary); box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
        .hd-tab svg { opacity: 0.6; }
        .hd-tab.active svg { opacity: 1; }

        /* ── Tab Panels ── */
        .hd-panel { display: none; }
        .hd-panel.active { display: block; }

        /* ── KPI Grid ── */
        .hd-kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }
        .hd-kpi {
            background: var(--white); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 18px 20px;
            border-top: 3px solid var(--primary);
        }
        .hd-kpi-label {
            font-size: 10px; font-weight: 800; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px;
        }
        .hd-kpi-value {
            font-size: 18px; font-weight: 800; color: var(--text-primary);
            line-height: 1.2; font-family: 'JetBrains Mono', monospace;
        }
        .hd-kpi-sub {
            font-size: 11px; color: var(--text-muted); margin-top: 4px; font-weight: 500;
        }

        /* ── Section Headers ── */
        .hd-section {
            margin-bottom: 32px;
        }
        .hd-section-title {
            font-size: 11px; font-weight: 800; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.1em;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 16px;
            display: flex; align-items: center; gap: 8px;
        }
        .hd-section-title-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--primary); display: inline-block; flex-shrink: 0;
        }

        /* ── Tables ── */
        .hd-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .hd-table thead tr { background: var(--bg-off-white); }
        .hd-table th {
            padding: 10px 14px; text-align: left;
            font-size: 10px; font-weight: 800; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.09em;
            border-bottom: 1px solid var(--border);
        }
        .hd-table td {
            padding: 11px 14px; border-bottom: 1px solid var(--row-border);
            color: var(--text-primary); vertical-align: middle;
        }
        .hd-table tbody tr:last-child td { border-bottom: none; }
        .hd-table tbody tr:hover { background: var(--bg-off-white); }
        .hd-table .mono { font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12px; }

        /* ── Status Badges inline ── */
        .hd-badge {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 2px 8px; border-radius: 4px;
            font-size: 10px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
        }
        .hd-badge-ok     { background: var(--success-light); color: var(--success); border: 1px solid var(--success); }
        .hd-badge-warn   { background: var(--warning-light); color: var(--warning); border: 1px solid var(--warning); }
        .hd-badge-crit   { background: var(--danger-light);  color: var(--danger);  border: 1px solid var(--danger); }
        .hd-badge-info   { background: var(--info-light);    color: var(--info);    border: 1px solid var(--info); }
        .hd-badge-muted  { background: var(--bg-light);      color: var(--text-muted); border: 1px solid var(--border); }

        /* ── Empty State ── */
        .hd-empty {
            padding: 48px; text-align: center; color: var(--text-muted);
            border: 2px dashed var(--border); border-radius: var(--radius);
        }
        .hd-empty-icon { font-size: 32px; margin-bottom: 12px; opacity: 0.2; }

        /* ── Progress bar (for percentages) ── */
        .hd-bar-wrap { display: flex; align-items: center; gap: 8px; }
        .hd-bar { height: 6px; flex: 1; background: var(--bg-light); border-radius: 3px; overflow: hidden; max-width: 80px; }
        .hd-bar-fill { height: 100%; border-radius: 3px; transition: width 0.3s; }

        /* ── Network interface health ── */
        .hd-iface-row { display: flex; align-items: center; gap: 8px; }
        .hd-link-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

        /* ── Pre (raw text blocks) ── */
        .hd-pre {
            background: #1e293b; color: #cbd5e1; padding: 16px 20px;
            border-radius: 6px; font-family: 'JetBrains Mono', Consolas, monospace;
            font-size: 12px; line-height: 1.6; overflow-x: auto;
            border-left: 4px solid var(--info); white-space: pre-wrap; word-break: break-all;
        }
    </style>
{% endblock %}

{% block dashboard_content %}

{# ── Page Header ── #}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/projects/view/{{ project.id }}" style="font-size: 13px; color: var(--text-muted); font-weight: 500;">{{ project.name }}</a>
            <span style="color: var(--text-muted); font-size: 13px;">/</span>
            <span style="color: var(--text-primary); font-size: 13px; font-weight: 600;">Hardware Digest</span>
        </div>
        <h1 class="page-title">Hardware Digest</h1>
        <p class="page-subtitle">Full platform inspection from <code>{{ file.original_filename }}</code> · Uploaded {{ file.created_at|date('M d, Y H:i') }}</p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center;">
        {% if scans %}
            <a href="/scans/report/{{ scans[0].id }}" class="btn btn-primary" style="width: auto; font-size: 12px; padding: 8px 18px; font-weight: 700;">
                View Latest AI Report
            </a>
        {% endif %}
        <a href="/files/raw/{{ file.id }}" target="_blank" class="btn btn-outline" style="width: auto; font-size: 12px; padding: 8px 18px; font-weight: 700;">
            Raw JSON ↗
        </a>
        <a href="/projects/view/{{ project.id }}" class="btn btn-outline" style="width: auto; font-size: 12px; padding: 8px 18px; font-weight: 700;">
            ← Back
        </a>
    </div>
</header>

{# ── Health Banner ── #}
{% set netHealth = data.network_hardware.health_assessment|default('unknown') %}
<div style="display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: var(--radius); margin-bottom: 24px;
    background: {% if netHealth == 'healthy' %}var(--success-light){% elseif netHealth == 'critical' %}var(--danger-light){% elseif netHealth in ['caution','warning'] %}var(--warning-light){% else %}var(--bg-light){% endif %};
    border: 1px solid {% if netHealth == 'healthy' %}var(--success){% elseif netHealth == 'critical' %}var(--danger){% elseif netHealth in ['caution','warning'] %}var(--warning){% else %}var(--border){% endif %};">
    <div style="width: 10px; height: 10px; border-radius: 50%; background: {% if netHealth == 'healthy' %}var(--success){% elseif netHealth == 'critical' %}var(--danger){% elseif netHealth in ['caution','warning'] %}var(--warning){% else %}var(--text-muted){% endif %};"></div>
    <span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">Network Health: <strong>{{ netHealth|upper }}</strong></span>
    <span style="font-size: 12px; color: var(--text-muted); margin-left: 8px;">·</span>
    <span style="font-size: 12px; color: var(--text-muted);">{{ data.disks|length }} drives detected · {{ data.raid|length }} RAID arrays</span>
    <span style="font-size: 12px; color: var(--text-muted);">· DSM {{ data.version.product|default('--') }}</span>
</div>

{# ── Tab Bar ── #}
<nav class="hd-tabs" role="tablist" aria-label="Hardware Digest sections">
    <button class="hd-tab active" onclick="hdTab('overview', this)" role="tab" aria-selected="true" id="tab-overview">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Overview
    </button>
    <button class="hd-tab" onclick="hdTab('storage', this)" role="tab" aria-selected="false" id="tab-storage">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        Storage
    </button>
    <button class="hd-tab" onclick="hdTab('network', this)" role="tab" aria-selected="false" id="tab-network">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-4a8 8 0 0 1 14 0v4"/><path d="M12 12v-2"/></svg>
        Network
    </button>
    <button class="hd-tab" onclick="hdTab('system', this)" role="tab" aria-selected="false" id="tab-system">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        System
    </button>
    <button class="hd-tab" onclick="hdTab('logs', this)" role="tab" aria-selected="false" id="tab-logs">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
        Event Logs
    </button>
    <button class="hd-tab" onclick="hdTab('history', this)" role="tab" aria-selected="false" id="tab-history">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Audit History
    </button>
</nav>


{# ═══════════════════════════════════════ TAB: OVERVIEW ═══ #}
<section class="hd-panel active" id="panel-overview">

    {# KPI Grid #}
    <div class="hd-kpi-grid">
        <div class="hd-kpi" style="border-top-color: #6366f1;">
            <div class="hd-kpi-label">NAS Model</div>
            <div class="hd-kpi-value" style="font-size: 15px;">{{ data.hardware.model|default('--') }}</div>
            <div class="hd-kpi-sub">{{ data.hardware.serial|default('No serial') }}</div>
        </div>
        <div class="hd-kpi" style="border-top-color: var(--primary);">
            <div class="hd-kpi-label">CPU</div>
            <div class="hd-kpi-value" style="font-size: 13px;">{{ data.hardware.cpu_model|default('--') }}</div>
            <div class="hd-kpi-sub">Processor Architecture</div>
        </div>
        <div class="hd-kpi" style="border-top-color: var(--success);">
            <div class="hd-kpi-label">RAM Installed</div>
            <div class="hd-kpi-value">{{ data.hardware.ram_gb|default('0') }} <span style="font-size: 13px; font-weight: 600; color: var(--text-muted);">GB</span></div>
            <div class="hd-kpi-sub">Physical Memory</div>
        </div>
        <div class="hd-kpi" style="border-top-color: var(--warning);">
            <div class="hd-kpi-label">Uptime</div>
            <div class="hd-kpi-value">{{ data.hardware.uptime_days|default('0') }} <span style="font-size: 13px; font-weight: 600; color: var(--text-muted);">days</span></div>
            <div class="hd-kpi-sub">System Uptime</div>
        </div>
        <div class="hd-kpi" style="border-top-color: #10b981;">
            <div class="hd-kpi-label">DSM</div>
            <div class="hd-kpi-value" style="font-size: 14px;">{{ data.version.product|default('--') }}</div>
            <div class="hd-kpi-sub">Build {{ data.version.build|default('--') }}</div>
        </div>
        <div class="hd-kpi" style="border-top-color: #f59e0b;">
            <div class="hd-kpi-label">Drive Bays</div>
            <div class="hd-kpi-value">{{ data.disks|length }}</div>
            <div class="hd-kpi-sub">{{ data.expansion_units|length > 0 ? data.expansion_units|length ~ ' expansion unit(s)' : 'No expansion units' }}</div>
        </div>
    </div>

    {# System Identity #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot"></span> System Identity</div>
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <tbody>
                    <tr><td style="width: 200px; color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">Model</td><td class="mono">{{ data.hardware.model|default('--') }}</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">Serial Number</td><td class="mono">{{ data.hardware.serial|default('--') }}</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">CPU Architecture</td><td>{{ data.hardware.cpu_model|default('--') }}</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">Physical RAM</td><td>{{ data.hardware.ram_gb|default('--') }} GB</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">Physical Location</td><td>{{ data.hardware.location|default('Not specified') }}</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">System Uptime</td><td>{{ data.hardware.uptime_days|default('0') }} days</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    {# Software / DSM #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #10b981;"></span> Software Architecture (DSM)</div>
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <tbody>
                    <tr><td style="width: 200px; color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">DSM Version</td><td class="mono">{{ data.version.product|default('--') }}</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">Major Release</td><td class="mono">DSM {{ data.version.major|default('--') }}</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">Build Number</td><td class="mono">{{ data.version.build|default('--') }}</td></tr>
                    <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase;">Build Date</td><td>{{ data.version.build_date|default('--') }}</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    {# Enclosure / Expansion Units #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #f59e0b;"></span> Enclosure Discovery</div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: var(--bg-light); border-radius: var(--radius); border-left: 3px solid var(--success);">
                <div style="width: 8px; height: 8px; background: var(--success); border-radius: 50%;"></div>
                <span style="font-size: 13px; font-weight: 700;">HOST UNIT: {{ data.hardware.model|default('Unknown Model') }}</span>
                <span style="font-size: 11px; color: var(--text-muted); font-family: monospace;">SN: {{ data.hardware.serial|default('--') }}</span>
            </div>
            {% if data.expansion_units|length > 0 %}
                {% for unit in data.expansion_units %}
                <div style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: var(--bg-light); border-radius: var(--radius); border-left: 3px solid var(--primary); margin-left: 24px;">
                    <div style="width: 8px; height: 8px; background: var(--primary); border-radius: 50%;"></div>
                    <span style="font-size: 13px; font-weight: 700;">EXPANSION: {{ unit }}</span>
                </div>
                {% endfor %}
            {% else %}
                <div style="padding: 20px 18px; background: var(--bg-light); border-radius: var(--radius); color: var(--text-muted); font-size: 13px; font-style: italic;">
                    No expansion units detected in this diagnostic.
                </div>
            {% endif %}
        </div>
    </div>

</section>


{# ═══════════════════════════════════════ TAB: STORAGE ═══ #}
<section class="hd-panel" id="panel-storage">

    {# Physical Disk Registry #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot"></span> Physical Disk Registry ({{ data.disks|length }} drives)</div>
        {% if data.disks %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Device</th>
                        <th>Bay / Container</th>
                        <th>Model</th>
                        <th>Serial</th>
                        <th>Capacity</th>
                        <th>Temp</th>
                        <th>SMART</th>
                        <th style="text-align: right; padding-right: 20px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for id, disk in data.disks %}
                    <tr>
                        <td style="padding-left: 20px;" class="mono" style="font-weight: 700; color: var(--text-primary);">{{ id }}</td>
                        <td>
                            <span class="hd-badge hd-badge-muted">{{ disk.container|default('Main') }} — B{{ disk.bay|default(disk.slot|default('?')) }}</span>
                        </td>
                        <td style="font-weight: 600; font-size: 13px;">{{ disk.model|default('--') }}</td>
                        <td class="mono" style="font-size: 11px; color: var(--text-muted);">{{ disk.serial|default('--') }}</td>
                        <td style="font-weight: 700;">{{ disk.size_gb|default('0') }} GB</td>
                        <td>
                            {% if disk.temp %}
                                <span style="font-weight: 700; color: {% if disk.temp > 50 %}var(--danger){% elseif disk.temp > 42 %}var(--warning){% else %}var(--success){% endif %};">
                                    {{ disk.temp }}°C
                                </span>
                            {% else %}
                                <span style="color: var(--text-muted);">--</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if disk.smart_status and disk.smart_status != 'normal' %}
                                <span class="hd-badge hd-badge-crit">{{ disk.smart_status|upper }}</span>
                            {% elseif disk.bad_sectors and disk.bad_sectors > 0 %}
                                <span class="hd-badge hd-badge-warn">{{ disk.bad_sectors }} bad</span>
                            {% else %}
                                <span class="hd-badge hd-badge-ok">OK</span>
                            {% endif %}
                        </td>
                        <td style="text-align: right; padding-right: 20px;">
                            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 4px;">
                                <span class="hd-badge {% if disk.status in ['normal','detected','ok'] %}hd-badge-ok{% else %}hd-badge-crit{% endif %}">
                                    {{ disk.status|default('unknown')|upper }}
                                </span>
                                {% if disk.timeout_status and disk.timeout_status != 'normal' %}
                                    <span class="hd-badge hd-badge-crit" style="font-size: 9px;">TIMEOUT</span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">💿</div>No disk data extracted from this diagnostic file.</div>
        {% endif %}
    </div>

    {# RAID Arrays #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #6366f1;"></span> RAID / Volume Groups ({{ data.raid|length }} arrays)</div>
        {% if data.raid %}
            {% for array, info in data.raid %}
            <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 12px; padding: 14px 20px; background: var(--bg-off-white); border-bottom: 1px solid var(--border);">
                    <span style="font-size: 16px; font-weight: 800; font-family: monospace; color: var(--text-primary);">{{ array }}</span>
                    <span class="hd-badge hd-badge-info">{{ info.level|default('--')|upper }}</span>
                    <span class="hd-badge {% if info.status in ['clean','active','healthy'] %}hd-badge-ok{% else %}hd-badge-warn{% endif %}">{{ info.status|default('unknown')|upper }}</span>
                    {% if info.size_gb is defined %}
                        <span style="font-size: 12px; color: var(--text-muted); margin-left: auto;">{{ info.size_gb }} GB total</span>
                    {% endif %}
                </div>
                {% if info.raw %}
                <div style="padding: 16px 20px;">
                    <pre class="hd-pre">{{ info.raw }}</pre>
                </div>
                {% else %}
                <div style="padding: 16px 20px;">
                    <table class="hd-table" style="margin: 0;">
                        <tbody>
                            {% if info.devices %}
                            <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px; width: 160px;">Member Drives</td><td class="mono">{{ info.devices|join(' · ') }}</td></tr>
                            {% endif %}
                            {% if info.degraded_devices is defined %}
                            <tr><td style="color: var(--text-muted); font-weight: 700; font-size: 11px;">Degraded Devices</td>
                                <td><span class="hd-badge {% if info.degraded_devices > 0 %}hd-badge-crit{% else %}hd-badge-ok{% endif %}">{{ info.degraded_devices }}</span></td></tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">🧊</div>No active RAID arrays detected in this diagnostic sequence.</div>
        {% endif %}
    </div>

    {# Volumes #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #10b981;"></span> Logical Volume Map</div>
        {% if data.volumes and data.volumes is not empty and data.volumes.error is not defined %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Volume / Mount</th>
                        <th>RAID Group</th>
                        <th>File System</th>
                        <th>Total</th>
                        <th>Used</th>
                        <th style="padding-right: 20px; text-align: right;">Available</th>
                    </tr>
                </thead>
                <tbody>
                    {% for vol in data.volumes %}
                    <tr>
                        <td style="padding-left: 20px; font-weight: 700;" class="mono">{{ vol.mount|default(vol.name|default('--')) }}</td>
                        <td class="mono">{{ vol.raid|default(vol.device|default('--')) }}</td>
                        <td><span class="hd-badge hd-badge-muted">{{ vol.filesystem|default('--')|upper }}</span></td>
                        <td style="font-weight: 700;">{{ vol.size_gb|default(vol.total_gb|default('--')) }} GB</td>
                        <td>{{ vol.used_gb|default('--') }} GB</td>
                        <td style="padding-right: 20px; text-align: right; font-weight: 700; color: var(--success);">{{ vol.avail_gb|default('--') }} GB</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">📂</div>Volume data not available in this extraction.</div>
        {% endif %}
    </div>

    {# Storage Utilisation (df) — DfResultParser: data.storage_util.filesystems is keyed by mountpoint #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #f59e0b;"></span> Storage Utilisation (Filesystem Usage)</div>
        {% set storUtil = data.storage_util %}
        {% set fsList = storUtil.filesystems|default(null) %}
        {% if fsList and fsList|length > 0 %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Device</th>
                        <th>Mount Point</th>
                        <th>Total (GB)</th>
                        <th>Used (GB)</th>
                        <th>Available (GB)</th>
                        <th style="padding-right: 20px; text-align: right;">Usage</th>
                    </tr>
                </thead>
                <tbody>
                    {% for mountpoint, fs in fsList %}
                    <tr>
                        <td style="padding-left: 20px;" class="mono">{{ fs.device|default('--') }}</td>
                        <td class="mono">{{ mountpoint }}</td>
                        <td>{{ fs.total_gb|default('--') }}</td>
                        <td>{{ fs.used_gb|default('--') }}</td>
                        <td style="color: {% if fs.health == 'critical' %}var(--danger){% elseif fs.health in ['warning','caution'] %}var(--warning){% else %}var(--success){% endif %}; font-weight: 700;">{{ fs.available_gb|default('--') }}</td>
                        <td style="padding-right: 20px; text-align: right;">
                            {% set pct = fs.use_percent|default(0) %}
                            <div class="hd-bar-wrap" style="justify-content: flex-end;">
                                <span style="font-weight: 700; font-size: 12px; color: {% if pct > 90 %}var(--danger){% elseif pct > 75 %}var(--warning){% else %}var(--success){% endif %};">{{ pct }}%</span>
                                <div class="hd-bar">
                                    <div class="hd-bar-fill" style="width: {{ pct }}%; background: {% if pct > 90 %}var(--danger){% elseif pct > 75 %}var(--warning){% else %}var(--success){% endif %};"></div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">📊</div>Filesystem usage data (df) not captured in this extraction.</div>
        {% endif %}
    </div>

    {# Btrfs Scrub History #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #8b5cf6;"></span> Btrfs Data Integrity (Scrub History)</div>
        {% set btrfsData = data.btrfs %}
        {% if btrfsData and btrfsData is not empty and btrfsData.error is not defined and btrfsData|length > 0 %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Volume</th>
                        <th>Last Status</th>
                        <th>Last Completed</th>
                        <th style="padding-right: 20px; text-align: right;">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    {% for volume, stats in btrfsData %}
                    <tr>
                        <td style="padding-left: 20px;" class="mono">{{ volume }}</td>
                        <td>
                            <span class="hd-badge {% if stats.last_status in ['finished', 'clean', 'normal'] %}hd-badge-ok{% else %}hd-badge-warn{% endif %}">
                                {{ stats.last_status|default('Unknown') }}
                            </span>
                        </td>
                        <td>{{ stats.last_finished|default('Never') }}</td>
                        <td style="padding-right: 20px; text-align: right; font-size: 12px; color: var(--text-muted);">{{ stats.detail|default('N/A') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">🔍</div>Btrfs scrub history not available (scrub may not be enabled or data was not captured).</div>
        {% endif %}
    </div>

    {# Disk I/O Stats #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #ec4899;"></span> Disk I/O Statistics</div>
        {% set diskIo = data.disk_io %}
        {% if diskIo and diskIo is not empty and diskIo.error is not defined %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Device</th>
                        <th>Reads</th>
                        <th>Read Sectors</th>
                        <th>Writes</th>
                        <th>Write Sectors</th>
                        <th style="padding-right: 20px; text-align: right;">I/O In Progress</th>
                    </tr>
                </thead>
                <tbody>
                    {% if diskIo is iterable %}
                    {% for device, stats in diskIo %}
                    {% if device != 'error' and stats is iterable %}
                    <tr>
                        <td style="padding-left: 20px;" class="mono">{{ device }}</td>
                        <td>{{ stats.reads_completed|default(stats.reads|default('--')) }}</td>
                        <td>{{ stats.sectors_read|default('--') }}</td>
                        <td>{{ stats.writes_completed|default(stats.writes|default('--')) }}</td>
                        <td>{{ stats.sectors_written|default('--') }}</td>
                        <td style="padding-right: 20px; text-align: right;">
                            {% set iop = stats.io_in_progress|default(stats.ios_in_progress|default(0)) %}
                            <span class="hd-badge {% if iop > 0 %}hd-badge-info{% else %}hd-badge-muted{% endif %}">{{ iop }}</span>
                        </td>
                    </tr>
                    {% endif %}
                    {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">⚡</div>Disk I/O statistics not captured in this extraction.</div>
        {% endif %}
    </div>

</section>


{# ═══════════════════════════════════════ TAB: NETWORK ═══ #}
<section class="hd-panel" id="panel-network">

    {# Network Interfaces #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot"></span> Physical Network Interfaces</div>
        {% set netHw = data.network_hardware %}
        {% if netHw and netHw.interfaces is defined and netHw.interfaces|length > 0 %}
        <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 20px;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Interface</th>
                        <th>Link</th>
                        <th>Speed</th>
                        <th>Duplex</th>
                        <th>Auto-Neg</th>
                        <th>Port Type</th>
                        <th style="padding-right: 20px; text-align: right;">Negotiation</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ifname, iface in netHw.interfaces %}
                    <tr>
                        <td style="padding-left: 20px;">
                            <div class="hd-iface-row">
                                <span class="hd-link-dot" style="background: {{ iface.link_detected ? 'var(--success)' : 'var(--danger)' }};"></span>
                                <span class="mono" style="font-weight: 700;">{{ ifname }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="hd-badge {% if iface.link_detected %}hd-badge-ok{% else %}hd-badge-crit{% endif %}">
                                {{ iface.link_detected ? 'UP' : 'DOWN' }}
                            </span>
                        </td>
                        <td class="mono">{{ iface.speed|default('--') }}</td>
                        <td>{{ iface.duplex|default('--') }}</td>
                        <td>
                            <span class="hd-badge {% if iface.autonegotiation == 'on' %}hd-badge-ok{% else %}hd-badge-muted{% endif %}">
                                {{ iface.autonegotiation|default('--') }}
                            </span>
                        </td>
                        <td>{{ iface.port|default('--') }}</td>
                        <td style="padding-right: 20px; text-align: right;">
                            {% if iface.speed_mismatch is defined and iface.speed_mismatch %}
                                <span class="hd-badge hd-badge-warn">SPEED MISMATCH</span>
                            {% else %}
                                <span class="hd-badge hd-badge-ok">NORMAL</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Interface Statistics (errors) #}
        {% for ifname, iface in netHw.interfaces %}
        {% if iface.statistics is defined and iface.statistics is iterable %}
        <div style="margin-bottom: 12px;">
            <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.08em;">{{ ifname }} – Packet Counters</div>
            <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">RX Packets</th>
                        <th>TX Packets</th>
                        <th>RX Errors</th>
                        <th>TX Errors</th>
                        <th>RX Dropped</th>
                        <th>TX Dropped</th>
                        <th>Collisions</th>
                        <th style="padding-right: 20px; text-align: right;">CRC Errors</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding-left: 20px;">{{ iface.statistics.rx_packets|default(0)|number_format }}</td>
                        <td>{{ iface.statistics.tx_packets|default(0)|number_format }}</td>
                        <td>
                            <span style="color: {{ iface.statistics.rx_errors > 0 ? 'var(--danger)' : 'inherit' }}; font-weight: {{ iface.statistics.rx_errors > 0 ? '700' : '400' }};">
                                {{ iface.statistics.rx_errors|default(0) }}
                            </span>
                        </td>
                        <td>
                            <span style="color: {{ iface.statistics.tx_errors > 0 ? 'var(--danger)' : 'inherit' }}; font-weight: {{ iface.statistics.tx_errors > 0 ? '700' : '400' }};">
                                {{ iface.statistics.tx_errors|default(0) }}
                            </span>
                        </td>
                        <td>
                            <span style="color: {{ iface.statistics.rx_dropped > 100 ? 'var(--warning)' : 'inherit' }};">
                                {{ iface.statistics.rx_dropped|default(0) }}
                            </span>
                        </td>
                        <td>{{ iface.statistics.tx_dropped|default(0) }}</td>
                        <td>
                            <span style="color: {{ iface.statistics.collisions > 0 ? 'var(--warning)' : 'inherit' }};">
                                {{ iface.statistics.collisions|default(0) }}
                            </span>
                        </td>
                        <td style="padding-right: 20px; text-align: right;">
                            <span style="color: {{ iface.statistics.rx_crc_errors > 0 ? 'var(--danger)' : 'inherit' }}; font-weight: {{ iface.statistics.rx_crc_errors > 0 ? '800' : '400' }};">
                                {{ iface.statistics.rx_crc_errors|default(0) }}
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
        {% endif %}
        {% endfor %}

        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">🔌</div>Network hardware telemetry not captured (ethtool data not present in this diagnostic).</div>
        {% endif %}
    </div>

    {# Network Errors #}
    {% if netHw and netHw.network_errors is defined and netHw.network_errors|length > 0 %}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: var(--danger);"></span> Detected Network Errors ({{ netHw.network_errors|length }})</div>
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Interface</th>
                        <th>Severity</th>
                        <th>Issue</th>
                        <th>Details</th>
                        <th style="padding-right: 20px; text-align: right;">Likely Cause</th>
                    </tr>
                </thead>
                <tbody>
                    {% for err in netHw.network_errors %}
                    <tr>
                        <td style="padding-left: 20px;" class="mono">{{ err.interface|default('--') }}</td>
                        <td>
                            <span class="hd-badge {% if err.severity == 'critical' %}hd-badge-crit{% elseif err.severity == 'warning' %}hd-badge-warn{% else %}hd-badge-info{% endif %}">
                                {{ err.severity|upper }}
                            </span>
                        </td>
                        <td style="font-weight: 600;">{{ err.issue|default('--') }}</td>
                        <td class="mono" style="font-size: 11px;">{{ err.details|default('--') }}</td>
                        <td style="padding-right: 20px; text-align: right; font-size: 12px; color: var(--text-muted);">{{ err.likely_cause|default('--') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# Link Flapping #}
    {% if netHw and netHw.link_flapping is defined and netHw.link_flapping %}
    {% set flap = netHw.link_flapping %}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: var(--danger);"></span> Link Flapping Detected</div>
        <div class="card" style="padding: 20px 24px; border-left: 4px solid {% if flap.severity == 'critical' %}var(--danger){% else %}var(--warning){% endif %};">
            <div style="display: flex; align-items: flex-start; gap: 16px;">
                <div style="font-size: 28px;">⚠️</div>
                <div>
                    <div style="font-weight: 800; font-size: 15px; color: var(--text-primary); margin-bottom: 6px;">
                        Link State Instability — {{ flap.event_count }} events detected
                    </div>
                    <div style="font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 12px;">{{ flap.recommendation }}</div>
                    {% if flap.events|length > 0 %}
                    <div style="font-size: 11px; color: var(--text-muted);">
                        First event: {{ flap.events[0].timestamp }} on {{ flap.events[0].interface }}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# Connection Status #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #10b981;"></span> TCP Connection State Summary</div>
        {% set connStatus = netHw.connection_status is defined ? netHw.connection_status : data.network %}
        {% if connStatus %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">State</th>
                        <th style="padding-right: 20px; text-align: right;">Count</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td style="padding-left: 20px; font-weight: 700;">ESTABLISHED</td><td style="text-align: right; padding-right: 20px;">{{ connStatus.established|default(0) }}</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 700;">LISTEN</td><td style="text-align: right; padding-right: 20px;">{{ connStatus.listen|default(0) }}</td></tr>
                    <tr>
                        <td style="padding-left: 20px; font-weight: 700;">TIME_WAIT
                            {% if connStatus.time_wait > 500 %}<span class="hd-badge hd-badge-warn" style="margin-left: 8px;">HIGH</span>{% endif %}
                        </td>
                        <td style="text-align: right; padding-right: 20px; color: {{ connStatus.time_wait > 500 ? 'var(--warning)' : 'inherit' }}; font-weight: {{ connStatus.time_wait > 500 ? '700' : '400' }};">{{ connStatus.time_wait|default(0) }}</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 20px; font-weight: 700;">CLOSE_WAIT
                            {% if connStatus.close_wait > 100 %}<span class="hd-badge hd-badge-warn" style="margin-left: 8px;">HIGH</span>{% endif %}
                        </td>
                        <td style="text-align: right; padding-right: 20px; color: {{ connStatus.close_wait > 100 ? 'var(--warning)' : 'inherit' }}; font-weight: {{ connStatus.close_wait > 100 ? '700' : '400' }};">{{ connStatus.close_wait|default(0) }}</td>
                    </tr>
                    <tr><td style="padding-left: 20px; font-weight: 700;">FIN_WAIT</td><td style="text-align: right; padding-right: 20px;">{{ connStatus.fin_wait|default(0) }}</td></tr>
                </tbody>
            </table>
        </div>
        {% if connStatus.anomalies is defined and connStatus.anomalies|length > 0 %}
        <div style="margin-top: 12px;">
            {% for anomaly in connStatus.anomalies %}
            <div style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--warning-light); border-radius: var(--radius); border-left: 3px solid var(--warning); margin-bottom: 8px;">
                <span class="hd-badge hd-badge-warn">{{ anomaly.severity|upper }}</span>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-primary);">{{ anomaly.issue }}</span>
                <span style="font-size: 12px; color: var(--text-muted);">({{ anomaly.count }} connections) — {{ anomaly.likely_cause }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">🔗</div>Connection state data not captured in this extraction.</div>
        {% endif %}
    </div>

</section>


{# ═══════════════════════════════════════ TAB: SYSTEM ═══ #}
<section class="hd-panel" id="panel-system">

    {# System Load #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot"></span> System Load &amp; Process Activity</div>
        {# TopResultParser keys: load_average{1min,5min,15min}, io_load, cpu_load, cpu_stats{user_percent,system_percent,iowait_percent,idle_percent}, processes{total,zombie}, memory #}
        {% set sysLoad = data.system_load %}
        {% if sysLoad and sysLoad.load_average is defined or sysLoad.cpu_stats is defined %}
        <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 20px;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Metric</th>
                        <th style="padding-right: 20px; text-align: right;">Value</th>
                    </tr>
                </thead>
                <tbody>
                    {% if sysLoad.load_average is defined and sysLoad.load_average %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Load Average (1 min)</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.load_average['1min']|default('--') }}</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">Load Average (5 min)</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.load_average['5min']|default('--') }}</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">Load Average (15 min)</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.load_average['15min']|default('--') }}</td></tr>
                    {% if sysLoad.load_average.overload_factor is defined %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">CPU Overload Factor</td>
                        <td style="text-align: right; padding-right: 20px;">
                            <span style="font-weight: 700; color: {% if sysLoad.load_average.cpu_bound %}var(--danger){% else %}var(--success){% endif %};">{{ sysLoad.load_average.overload_factor }}x</span>
                        </td>
                    </tr>
                    {% endif %}
                    {% endif %}
                    {% if sysLoad.processes is defined and sysLoad.processes %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Total Processes</td><td style="text-align: right; padding-right: 20px;">{{ sysLoad.processes.total|default('--') }}</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">Zombie Processes</td>
                        <td style="text-align: right; padding-right: 20px;">
                            {% set zcount = sysLoad.processes.zombie|default(sysLoad.zombie_processes|default(0)) %}
                            <span style="color: {% if zcount > 0 %}var(--danger){% else %}inherit{% endif %}; font-weight: {% if zcount > 0 %}700{% else %}400{% endif %};">{{ zcount }}</span>
                        </td>
                    </tr>
                    {% if sysLoad.processes.zombie_warning is defined %}
                    <tr><td colspan="2" style="padding: 10px 20px; font-size: 12px; color: var(--danger); font-style: italic;">{{ sysLoad.processes.zombie_warning }}</td></tr>
                    {% endif %}
                    {% endif %}
                    {% if sysLoad.cpu_stats is defined and sysLoad.cpu_stats %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">CPU User %</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.cpu_stats.user_percent|default('--') }}%</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">CPU System %</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.cpu_stats.system_percent|default('--') }}%</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">CPU Nice %</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.cpu_stats.nice_percent|default('--') }}%</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">CPU Idle %</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.cpu_stats.idle_percent|default('--') }}%</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">CPU I/O Wait %</td>
                        <td style="text-align: right; padding-right: 20px;" class="mono">
                            {% set iow = sysLoad.cpu_stats.iowait_percent|default(0) %}
                            <span style="color: {% if iow > 20 %}var(--danger){% elseif iow > 10 %}var(--warning){% else %}inherit{% endif %}; font-weight: {% if iow > 10 %}700{% else %}400{% endif %};">{{ iow }}%</span>
                            {% if sysLoad.cpu_stats.iowait_severity is defined %}
                            <span class="hd-badge {% if sysLoad.cpu_stats.iowait_severity == 'critical' %}hd-badge-crit{% elseif sysLoad.cpu_stats.iowait_severity == 'warning' %}hd-badge-warn{% else %}hd-badge-muted{% endif %}" style="margin-left: 8px;">{{ sysLoad.cpu_stats.iowait_severity }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% if sysLoad.cpu_stats.io_bottleneck is defined and sysLoad.cpu_stats.io_bottleneck %}
                    <tr><td colspan="2" style="padding: 10px 20px; background: var(--danger-light); color: var(--danger); font-size: 12px; font-weight: 700;">⚠ I/O bottleneck detected — CPU is spending excessive time waiting on storage I/O</td></tr>
                    {% endif %}
                    {% endif %}
                    {% if sysLoad.memory is defined and sysLoad.memory %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Memory Total</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.memory.total_gb|default('--') }} GB</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">Memory Free</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.memory.free_gb|default('--') }} GB</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">Memory Used</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ sysLoad.memory.used_gb|default('--') }} GB</td></tr>
                    {% endif %}
                </tbody>
            </table>
        </div>

        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">📉</div>System load data (top) not captured in this extraction.</div>
        {% endif %}
    </div>

    {# Memory Utilisation — VmstatParser keys: meminfo{key:{kb,gb}}, vmstat{key:int}, memory_pressure, swap_usage{total_gb,free_gb,used_gb,percent_used}, oom_risk #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: #6366f1;"></span> Memory &amp; Pressure Analysis (vmstat + meminfo)</div>
        {% set memUtil = data.memory_util %}
        {% if memUtil and (memUtil.meminfo is defined or memUtil.memory_pressure is defined) %}

        {# Memory Pressure Banner #}
        {% if memUtil.memory_pressure is defined %}
        <div style="display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-radius: var(--radius); margin-bottom: 16px;
            background: {% if memUtil.memory_pressure == 'critical' %}var(--danger-light){% elseif memUtil.memory_pressure == 'warning' %}var(--warning-light){% else %}var(--success-light){% endif %};
            border: 1px solid {% if memUtil.memory_pressure == 'critical' %}var(--danger){% elseif memUtil.memory_pressure == 'warning' %}var(--warning){% else %}var(--success){% endif %}; margin-bottom: 16px;">
            <span class="hd-badge {% if memUtil.memory_pressure == 'critical' %}hd-badge-crit{% elseif memUtil.memory_pressure == 'warning' %}hd-badge-warn{% else %}hd-badge-ok{% endif %}">Memory Pressure: {{ memUtil.memory_pressure|upper }}</span>
            {% if memUtil.oom_risk is defined and memUtil.oom_risk %}
            <span class="hd-badge hd-badge-crit">⚠ OOM RISK DETECTED</span>
            {% endif %}
        </div>
        {% endif %}

        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr><th style="padding-left: 20px;">Metric</th><th style="padding-right: 20px; text-align: right;">Value</th></tr>
                </thead>
                <tbody>
                    {% if memUtil.meminfo.memtotal is defined %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Total RAM</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ memUtil.meminfo.memtotal.gb|default('--') }} GB</td></tr>
                    {% endif %}
                    {% if memUtil.meminfo.memfree is defined %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Free RAM</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ memUtil.meminfo.memfree.gb|default('--') }} GB</td></tr>
                    {% endif %}
                    {% if memUtil.meminfo.memavailable is defined %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Available RAM</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ memUtil.meminfo.memavailable.gb|default('--') }} GB</td></tr>
                    {% endif %}
                    {% if memUtil.meminfo.cached is defined %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Page Cache</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ memUtil.meminfo.cached.gb|default('--') }} GB</td></tr>
                    {% endif %}
                    {% if memUtil.meminfo.shmem is defined %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Shared Memory (tmpfs)</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ memUtil.meminfo.shmem.gb|default('--') }} GB</td></tr>
                    {% endif %}
                    {% if memUtil.swap_usage is defined %}
                    <tr><td style="padding-left: 20px; font-weight: 600;">Swap Total</td><td style="text-align: right; padding-right: 20px;" class="mono">{{ memUtil.swap_usage.total_gb|default('--') }} GB</td></tr>
                    <tr><td style="padding-left: 20px; font-weight: 600;">Swap Used</td>
                        <td style="text-align: right; padding-right: 20px;">
                            <span class="mono" style="color: {% if memUtil.swap_usage.swap_active %}var(--warning){% else %}inherit{% endif %}; font-weight: {% if memUtil.swap_usage.swap_active %}700{% else %}400{% endif %};">{{ memUtil.swap_usage.used_gb|default('--') }} GB ({{ memUtil.swap_usage.percent_used|default(0) }}%)</span>
                        </td>
                    </tr>
                    <tr><td colspan="2" style="padding: 8px 20px; font-size: 11px; color: var(--text-muted); font-style: italic;">{{ memUtil.swap_usage.type_note|default('') }}</td></tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">🧮</div>Memory data (vmstat/meminfo) not captured in this extraction.</div>
        {% endif %}
    </div>

    {# D-State — DStateParser keys: d_state_events[{timestamp,process_name,stack_trace,is_io_issue}], summary{total_events,severity,recommendation} #}
    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot" style="background: var(--danger);"></span> D-State Process Trace (I/O Blocking Detection)</div>
        {% set dstate = data.dstate %}
        {% set dstateEvents = dstate.d_state_events|default([]) %}
        {% set dstateSummary = dstate.summary|default(null) %}
        {% if dstate is defined and dstate %}
            {% if dstateEvents|length > 0 %}
            <div class="card" style="border-left: 3px solid {% if dstateSummary.severity == 'critical' %}var(--danger){% else %}var(--warning){% endif %}; padding: 14px 18px; margin-bottom: 12px; background: var(--danger-light);">
                <div style="font-size: 13px; font-weight: 700; color: var(--danger);">⚠ {{ dstateEvents|length }} D-State event(s) detected — {{ dstateSummary.severity|upper|default('UNKNOWN') }} severity. This indicates I/O blocking conditions.</div>
                {% if dstateSummary.recommendation is defined %}
                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 6px;">{{ dstateSummary.recommendation }}</div>
                {% endif %}
                {% if dstateSummary.time_span_hours is defined and dstateSummary.time_span_hours > 0 %}
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Events span: {{ dstateSummary.time_span_hours }}h · First: {{ dstateSummary.first_event }} · Last: {{ dstateSummary.last_event }}</div>
                {% endif %}
            </div>
            <div class="card" style="padding: 0; overflow: hidden;">
                <table class="hd-table">
                    <thead>
                        <tr>
                            <th style="padding-left: 20px;">Timestamp</th>
                            <th>Process</th>
                            <th>I/O Related</th>
                            <th style="padding-right: 20px; text-align: right;">Stack Trace (excerpt)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in dstateEvents|slice(0, 20) %}
                        <tr>
                            <td style="padding-left: 20px;" class="mono" style="font-size: 11px;">{{ event.timestamp|default(event.timestamp_raw|default('--')) }}</td>
                            <td class="mono">{{ event.process_name|default('(unknown)') }}</td>
                            <td><span class="hd-badge {% if event.is_io_issue %}hd-badge-crit{% else %}hd-badge-muted{% endif %}">{% if event.is_io_issue %}I/O BLOCK{% else %}OTHER{% endif %}</span></td>
                            <td style="padding-right: 20px; text-align: right; font-size: 11px; color: var(--text-muted); font-family: monospace;">{{ event.stack_trace|slice(0, 80)|default('--') }}{% if event.stack_trace|length > 80 %}…{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <div class="hd-empty" style="border-color: var(--success); background: var(--success-light);">
                    <div class="hd-empty-icon" style="opacity: 0.6;">✅</div>
                    <span style="color: var(--success); font-weight: 700;">No D-State events detected — {{ dstateSummary.recommendation|default('I/O blocking conditions are not present.') }}</span>
                </div>
            {% endif %}
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">🔍</div>D-State data not captured in this extraction.</div>
        {% endif %}
    </div>

</section>


{# ═══════════════════════════════════════ TAB: LOGS ═══ #}
<section class="hd-panel" id="panel-logs">

    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot"></span> Critical System Events</div>
        {% set logs = data.logs %}
        {% if logs and logs.critical_events is defined and logs.critical_events|length > 0 %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px; width: 140px;">Source</th>
                        <th>Message / Content</th>
                    </tr>
                </thead>
                <tbody>
                    {% set events = logs.critical_events %}
                    {# Handle if already flattened to markdown string #}
                    {% if events is not iterable %}
                    <tr>
                        <td colspan="2" style="padding: 0;">
                            <pre class="hd-pre" style="margin: 0; border-radius: 0; border-left: none;">{{ events }}</pre>
                        </td>
                    </tr>
                    {% else %}
                    {% for event in events %}
                    <tr>
                        <td style="padding-left: 20px;">
                            <span class="hd-badge hd-badge-muted" style="font-size: 9px;">{{ event.source|default('unknown') }}</span>
                        </td>
                        <td style="font-size: 12px; color: var(--text-primary); line-height: 1.5; max-width: 800px; word-break: break-word;">
                            {% set content = event.content|default(event.msg|default(event.message|default('--'))) %}
                            {{ content|slice(0, 500) }}{% if content|length > 500 %}…{% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
        {% elseif logs and logs.error is not defined and logs is not empty %}
            <div class="card" style="padding: 20px 24px;">
                <pre class="hd-pre">{{ logs|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
            </div>
        {% else %}
            <div class="hd-empty"><div class="hd-empty-icon">📋</div>No critical system events captured in this extraction.</div>
        {% endif %}
    </div>

</section>


{# ═══════════════════════════════════════ TAB: AUDIT HISTORY ═══ #}
<section class="hd-panel" id="panel-history">

    <div class="hd-section">
        <div class="hd-section-title"><span class="hd-section-title-dot"></span> AI Forensic Audit History (Last 12 Months)</div>
        <div class="card" style="padding: 0; overflow: hidden;">
            <div style="display: flex; justify-content: flex-end; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--border); background: var(--bg-off-white);">
                <span style="font-size: 12px; font-weight: 700; color: var(--text-muted);">{{ pagination.count }} scan(s) on record</span>
            </div>
            {% if scans %}
            <table class="hd-table">
                <thead>
                    <tr>
                        <th style="padding-left: 20px;">Analysis Date</th>
                        <th>Level</th>
                        <th>Model</th>
                        <th>Findings</th>
                        <th>Health Score</th>
                        <th style="padding-right: 20px; text-align: right;">Report</th>
                    </tr>
                </thead>
                <tbody>
                    {% for scan in scans %}
                    <tr>
                        <td style="padding-left: 20px; font-weight: 600;">{{ scan.completed_at|date('M d, Y H:i') }}</td>
                        <td>
                            <span class="hd-badge hd-badge-muted">{{ scan.scan_level|upper }}</span>
                            {% if scan.debug_file_ids|length > 1 %}
                                <span style="font-size: 9px; color: var(--text-muted); font-weight: 700; margin-left: 4px; text-transform: uppercase;">(Multi)</span>
                            {% endif %}
                        </td>
                        <td class="mono" style="font-size: 11px;">{{ scan.ai_model|default('--') }}</td>
                        <td>
                            <span style="font-weight: 700; color: {{ scan.findings_count > 0 ? 'var(--warning)' : 'var(--success)' }};">
                                {{ scan.findings_count|default(0) }}
                            </span>
                        </td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 60px; height: 6px; background: var(--bg-light); border-radius: 3px; overflow: hidden;">
                                    <div style="width: {{ scan.health_score|default(0) }}%; height: 100%; background: {% if scan.health_score > 80 %}var(--success){% elseif scan.health_score > 50 %}var(--warning){% else %}var(--danger){% endif %};"></div>
                                </div>
                                <span style="font-weight: 800; font-size: 12px; font-family: monospace;">{{ scan.health_score|default('--') }}%</span>
                            </div>
                        </td>
                        <td style="padding-right: 20px; text-align: right;">
                            <a href="/scans/report/{{ scan.id }}" class="btn btn-outline" style="height: 28px; padding: 0 14px; font-size: 11px; font-weight: 700; width: auto;">View Report</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
                <div style="padding: 48px; text-align: center; color: var(--text-muted); font-size: 13px;">
                    No AI forensic audits have been run on this diagnostic file yet.
                </div>
            {% endif %}

            {# Pagination #}
            {% if pagination.total > 1 %}
            <div style="padding: 16px 20px; border-top: 1px solid var(--row-border); display: flex; justify-content: center; gap: 6px; background: var(--bg-off-white);">
                {% for i in 1..pagination.total %}
                    <a href="?page={{ i }}" class="btn btn-sm" style="height: 28px; padding: 0 10px; width: auto; font-weight: 700; {% if i == pagination.current %}background: var(--primary); color: white; border: none;{% else %}background: var(--white); color: var(--text-primary); border: 1px solid var(--border);{% endif %}">{{ i }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>

</section>


{# ── Tab Switching Script ── #}
<script>
(function () {
    var panels = document.querySelectorAll('.hd-panel');
    var tabs   = document.querySelectorAll('.hd-tab');

    function hdTab(name, btn) {
        panels.forEach(function(p) { p.classList.remove('active'); });
        tabs.forEach(function(t)   { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });

        var panel = document.getElementById('panel-' + name);
        if (panel) panel.classList.add('active');
        if (btn)   { btn.classList.add('active'); btn.setAttribute('aria-selected', 'true'); }

        try { localStorage.setItem('hw_digest_tab', name); } catch(e) {}
    }
    window.hdTab = hdTab;

    // Restore tab from URL hash or localStorage
    var hash = window.location.hash.replace('#', '');
    var saved = '';
    try { saved = localStorage.getItem('hw_digest_tab') || ''; } catch(e) {}
    var restore = hash || saved;

    if (restore && document.getElementById('panel-' + restore)) {
        var btn = document.getElementById('tab-' + restore);
        hdTab(restore, btn);
    }
})();
</script>

{% endblock %}
