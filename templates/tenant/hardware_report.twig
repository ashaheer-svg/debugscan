{% extends "layout/dashboard.twig" %}

{% set active_page = 'projects' %}

{% block title %}Hardware Audit - {{ file.nas_model|default('Unknown') }}{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <a href="/projects/view/{{ project.id }}" style="text-decoration: none; color: var(--text-muted); font-size: 13px;">{{ project.name }}</a>
            <span style="color: var(--text-muted); font-size: 13px;">/</span>
            <span style="color: var(--text-primary); font-size: 13px; font-weight: 600;">Hardware Audit</span>
        </div>
        <h1 class="page-title">Hardware Discovery Report</h1>
        <p class="page-subtitle">Platform audit generated from <code>{{ file.original_filename }}</code></p>
    </div>
    <div style="display: flex; gap: 12px; align-items: center;">
        {% if scans %}
            <a href="/scans/report/{{ scans[0].id }}" class="btn" style="background: var(--success); color: white; width: auto; text-decoration: none; font-weight: 700;">View Latest AI Forensic</a>
        {% endif %}
        <a href="/files/raw/{{ file.id }}" target="_blank" class="btn" style="background: var(--white); border: 1px solid var(--border); color: var(--text-primary); width: auto; text-decoration: none;">View Raw JSON</a>
    </div>
</header>


<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-bottom: 32px;">
    <!-- System Identity -->
    <section style="background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
        <h3 style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; letter-spacing: 0.5px;">System Identity</h3>
        <div style="display: grid; grid-template-columns: 140px 1fr; gap: 12px;">
            <span style="font-size: 13px; color: var(--text-secondary);">Model</span>
            <span style="font-size: 13px; font-weight: 700;">{{ data.hardware.model|default('--') }}</span>
            
            <span style="font-size: 13px; color: var(--text-secondary);">Serial Number</span>
            <span style="font-size: 13px; font-weight: 700; font-family: monospace;">{{ data.hardware.serial|default('--') }}</span>
            
            <span style="font-size: 13px; color: var(--text-secondary);">CPU Architecture</span>
            <span style="font-size: 13px; font-weight: 600;">{{ data.hardware.cpu_model|default('--') }}</span>
            
            <span style="font-size: 13px; color: var(--text-secondary);">Physical RAM</span>
            <span style="font-size: 13px; font-weight: 600;">{{ data.hardware.ram_gb ? data.hardware.ram_gb ~ ' GB' : '--' }}</span>
            
            <span style="font-size: 13px; color: var(--text-secondary);">System Uptime</span>
            <span style="font-size: 13px; font-weight: 600;">{{ data.hardware.uptime_days|default('0') }} days</span>
        </div>
    </section>

    <!-- Expansion Units -->
    <section style="background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
        <h3 style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; letter-spacing: 0.5px;">Enclosure Discovery</h3>
        {% if data.expansion_units|length > 0 %}
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 8px; height: 8px; background: var(--success); border-radius: 50%;"></div>
                    <span style="font-size: 13px; font-weight: 700;">Host: {{ data.hardware.model }}</span>
                </div>
                {% for unit in data.expansion_units %}
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 8px; height: 8px; background: var(--primary); border-radius: 50%;"></div>
                    <span style="font-size: 13px; font-weight: 700;">Expansion: {{ unit }}</span>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div style="display: flex; align-items: center; gap: 12px; height: 100%;">
                <span style="font-size: 13px; color: var(--text-muted);">No expansion units detected. Physical bays are internal to the host.</span>
            </div>
        {% endif %}
    </section>
</div>

<!-- OS / Software -->
<div style="display: grid; grid-template-columns: 1fr; gap: 24px; margin-bottom: 32px;">
    <section style="background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
        <h3 style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; letter-spacing: 0.5px;">Software Environment</h3>
        <div style="display: grid; grid-template-columns: 140px 1fr 140px 1fr; gap: 12px;">
            <span style="font-size: 13px; color: var(--text-secondary);">DSM Version</span>
            <span style="font-size: 13px; font-weight: 700;">{{ data.version.product|default('--') }}</span>
            
            <span style="font-size: 13px; color: var(--text-secondary);">Build Number</span>
            <span style="font-size: 13px; font-weight: 600;">{{ data.version.build|default('--') }}</span>
            
            <span style="font-size: 13px; color: var(--text-secondary);">Build Date</span>
            <span style="font-size: 13px; font-weight: 600;">{{ data.version.build_date|default('--') }}</span>
            
            <span style="font-size: 13px; color: var(--text-secondary);">Major Release</span>
            <span style="font-size: 13px; font-weight: 600;">DSM {{ data.version.major|default('--') }}</span>
        </div>
    </section>
</div>

<!-- Storage Inventory -->
<section style="background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-1); overflow: hidden; margin-bottom: 32px;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border);">
        <h3 style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">Discovery: Disk Inventory</h3>
    </div>
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">
                <th style="padding: 12px 24px;">Device</th>
                <th style="padding: 12px 0;">Unit / Bay</th>
                <th style="padding: 12px 0;">Model / Serial</th>
                <th style="padding: 12px 0;">Capacity</th>
                <th style="padding: 12px 0;">Temp</th>
                <th style="padding: 12px 24px; text-align: right;">Health Status</th>
            </tr>
        </thead>
        <tbody>
            {% for id, disk in data.disks %}
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 13px;">
                <td style="padding: 16px 24px; font-family: monospace; font-weight: 700;">{{ id }}</td>
                <td style="padding: 16px 0;">
                    <span style="font-size: 11px; background: {% if disk.container == 'Main' %}#f0f2f5{% else %}var(--primary-light){% endif %}; color: {% if disk.container == 'Main' %}var(--text-primary){% else %}var(--primary){% endif %}; padding: 2px 6px; border-radius: 3px; font-weight: 700;">
                        {{ disk.container }} [Bay {{ disk.bay|default(disk.slot)|default('--') }}]
                    </span>
                </td>
                <td style="padding: 16px 0;">
                    <div style="font-weight: 600;">{{ disk.model|default('--') }}</div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace;">{{ disk.serial|default('--') }}</div>
                </td>
                <td style="padding: 16px 0;">{{ disk.size_gb|default('0') }} GB</td>
                <td style="padding: 16px 0;">
                    {% if disk.temp %}
                        <span style="color: {% if disk.temp > 45 %}var(--warning){% else %}var(--success){% endif %};">{{ disk.temp }}°C</span>
                    {% else %}--{% endif %}
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 4px;">
                        <span style="font-size: 11px; font-weight: 700; color: {% if disk.status == 'normal' or disk.status == 'detected' %}var(--success){% else %}var(--error){% endif %}; text-transform: uppercase;">
                            {{ disk.status|default('Unknown') }}
                        </span>
                        
                        {# Detailed Health Indicators #}
                        <div style="display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end;">
                            {% if disk.smart_status and disk.smart_status != 'normal' %}
                                <span style="font-size: 9px; padding: 1px 4px; border-radius: 2px; background: #fee2e2; color: #991b1b; font-weight: 700; border: 1px solid #fecaca;">SMART: {{ disk.smart_status|upper }}</span>
                            {% endif %}
                            
                            {% if disk.bad_sectors and disk.bad_sectors > 0 %}
                                <span style="font-size: 9px; padding: 1px 4px; border-radius: 2px; background: #fff7ed; color: #9a3412; font-weight: 700; border: 1px solid #ffedd5;">BAD SECTORS: {{ disk.bad_sectors }}</span>
                            {% endif %}

                            {% if disk.timeout_status and disk.timeout_status != 'normal' %}
                                <span style="font-size: 9px; padding: 1px 4px; border-radius: 2px; background: #fff1f2; color: #be123c; font-weight: 700; border: 1px solid #ffe4e6;">TIMEOUTS</span>
                            {% endif %}

                            {% if disk.reset_fail_status and disk.reset_fail_status != 'normal' %}
                                <span style="font-size: 9px; padding: 1px 4px; border-radius: 2px; background: #7f1d1d; color: #fff; font-weight: 700; border: 1px solid #991b1b;">RESET FAIL</span>
                            {% endif %}
                        </div>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>

<!-- Logic / RAID Summary -->
<section style="background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-1); overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border);">
        <h3 style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">Storage Hierarchy (RAID/LVM)</h3>
    </div>
    <div style="padding: 24px;">
        {% if data.raid %}
            <div style="display: flex; flex-direction: column; gap: 24px;">
                {% for array, info in data.raid %}
                    <div>
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                            <span style="font-weight: 700; font-size: 16px;">{{ array }}</span>
                            <span style="background: var(--primary-light); color: var(--primary); padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700;">{{ info.level|upper }}</span>
                            <span style="color: {% if info.status == 'clean' or info.status == 'active' %}var(--success){% else %}var(--warning){% endif %}; font-weight: 600; font-size: 13px;">{{ info.status|upper }}</span>
                        </div>
                        <div style="font-family: monospace; font-size: 12px; background: #1e293b; color: #cbd5e1; padding: 12px; border-radius: 6px; overflow-x: auto;">
                            {{ info.raw|default('No raw data captured.')|nl2br }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div style="text-align: center; padding: 24px; color: var(--text-muted);">
                No active RAID arrays detected in this log.
            </div>
        {% endif %}
    </div>
</section>

<!-- AI Analysis History (within 1 Year) -->
<section style="background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-1); overflow: hidden; margin-top: 32px;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">Forensic Audit History (Last 1 Year)</h3>
        <span style="font-size: 12px; color: var(--text-muted);">{{ pagination.count }} scan(s) found</span>
    </div>
    
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">
                <th style="padding: 12px 24px;">Date</th>
                <th style="padding: 12px 0;">Audit Level</th>
                <th style="padding: 12px 0;">Health Score</th>
                <th style="padding: 12px 24px; text-align: right;">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for scan in scans %}
            <tr style="border-bottom: 1px solid var(--row-border); font-size: 13px;">
                <td style="padding: 16px 24px; color: var(--text-secondary);">{{ scan.completed_at|date('M d, Y H:i') }}</td>
                <td style="padding: 16px 0;">
                    <span class="badge" style="background: {% if scan.scan_level == 'level1' %}var(--success-light){% else %}var(--warning-light){% endif %}; color: {% if scan.scan_level == 'level1' %}var(--success){% else %}var(--warning){% endif %}; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 700;">
                        {{ scan.scan_level|upper }}
                    </span>
                    {% if scan.debug_file_ids|length > 1 %}
                        <span style="font-size: 10px; color: var(--text-muted); margin-left: 4px;">(Multi-File)</span>
                    {% endif %}
                </td>
                <td style="padding: 16px 0; font-weight: 800; color: var(--text-primary);">
                    {{ scan.health_score|default('--') }}{% if scan.health_score %}%{% endif %}
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <a href="/scans/report/{{ scan.id }}" class="btn btn-sm" style="background: var(--primary); color: white; text-decoration: none; padding: 4px 12px; font-size: 11px; border-radius: 4px;">Report</a>
                </td>
            </tr>
            {% endfor %}
            {% if not scans %}
            <tr>
                <td colspan="4" style="padding: 40px; text-align: center; color: var(--text-muted); font-size: 13px;">
                    No AI forensic logs found for this hardware diagnostic in the last 1 year.
                </td>
            </tr>
            {% endif %}
        </tbody>
    </table>

    {% if pagination.total > 1 %}
    <div style="padding: 16px 24px; border-top: 1px solid var(--row-border); display: flex; justify-content: center; gap: 8px;">
        {% for i in 1..pagination.total %}
            <a href="?page={{ i }}" class="btn btn-sm" style="padding: 4px 10px; width: auto; text-decoration: none; {% if i == pagination.current %}background: var(--primary); color: white;{% else %}background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border);{% endif %}">{{ i }}</a>
        {% endfor %}
    </div>
    {% endif %}
</section>

{% endblock %}

