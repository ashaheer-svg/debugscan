{% extends "layout/dashboard.twig" %}

{% set active_page = 'projects' %}

{% block title %}Hardware Audit - {{ file.nas_model|default('Unknown') }}{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/projects/view/{{ project.id }}" style="font-size: 13px; color: var(--text-muted); font-weight: 500;">{{ project.name }}</a>
            <span style="color: var(--text-muted); font-size: 13px;">/</span>
            <span style="color: var(--text-primary); font-size: 13px; font-weight: 600;">Hardware Audit</span>
        </div>
        <h1 class="page-title">Hardware Discovery Report</h1>
        <p class="page-subtitle">Platform audit generated from <code>{{ file.original_filename }}</code></p>
    </div>
    <div style="display: flex; gap: 12px; align-items: center;">
        {% if scans %}
            <a href="/scans/report/{{ scans[0].id }}" class="btn btn-primary" style="width: auto; font-weight: 700;">View Latest AI Forensic</a>
        {% endif %}
        <a href="/files/raw/{{ file.id }}" target="_blank" class="btn btn-outline" style="width: auto; font-weight: 700;">View Raw JSON</a>
    </div>
</header>


<div class="responsive-grid" style="margin-bottom: 32px;">
    <!-- System Identity -->
    <section class="card">
        <h3 style="font-size: 11px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; letter-spacing: 0.1em;">System Identity</h3>
        <dl style="display: flex; flex-direction: column; gap: 12px; margin: 0;">
            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                <dt style="font-size: 12px; color: var(--text-muted); font-weight: 600;">MODEL</dt>
                <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ data.hardware.model|default('--') }}</dd>
            </div>
            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                <dt style="font-size: 12px; color: var(--text-muted); font-weight: 600;">SERIAL</dt>
                <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary); font-family: monospace;">{{ data.hardware.serial|default('--') }}</dd>
            </div>
            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                <dt style="font-size: 12px; color: var(--text-muted); font-weight: 600;">CPU ARCH</dt>
                <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ data.hardware.cpu_model|default('--') }}</dd>
            </div>
            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                <dt style="font-size: 12px; color: var(--text-muted); font-weight: 600;">PHYSICAL RAM</dt>
                <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ data.hardware.ram_gb ? data.hardware.ram_gb ~ ' GB' : '--' }}</dd>
            </div>
            <div style="display: flex; justify-content: space-between; padding-bottom: 4px;">
                <dt style="font-size: 12px; color: var(--text-muted); font-weight: 600;">UPTIME</dt>
                <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ data.hardware.uptime_days|default('0') }} days</dd>
            </div>
        </dl>
    </section>

    <!-- Expansion Units -->
    <section class="card">
        <h3 style="font-size: 11px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; letter-spacing: 0.1em;">Enclosure Discovery</h3>
        {% if data.expansion_units|length > 0 %}
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div style="display: flex; align-items: center; gap: 12px; padding: 12px; background: var(--bg-light); border-radius: var(--radius); border-left: 3px solid var(--success);">
                    <div style="width: 10px; height: 10px; background: var(--success); border-radius: 50%;"></div>
                    <span style="font-size: 13px; font-weight: 800; color: var(--text-primary);">HOST: {{ data.hardware.model }}</span>
                </div>
                {% for unit in data.expansion_units %}
                <div style="display: flex; align-items: center; gap: 12px; padding: 12px; background: var(--bg-light); border-radius: var(--radius); border-left: 3px solid var(--primary);">
                    <div style="width: 10px; height: 10px; background: var(--primary); border-radius: 50%;"></div>
                    <span style="font-size: 13px; font-weight: 800; color: var(--text-primary);">EXPANSION: {{ unit }}</span>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div style="display: flex; align-items: center; justify-content: center; height: 160px; border: 2px dashed var(--border); border-radius: var(--radius);">
                <span style="font-size: 13px; color: var(--text-muted); font-weight: 600;">No expansion units detected.</span>
            </div>
        {% endif %}
    </section>
</div>

<!-- OS / Software -->
<section class="card" style="margin-bottom: 32px;">
    <h3 style="font-size: 11px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; letter-spacing: 0.1em;">Software Architecture</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px;">
        <div>
            <label style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">DSM Version</label>
            <div style="font-size: 15px; font-weight: 800; color: var(--text-primary); margin-top: 4px;">{{ data.version.product|default('--') }}</div>
        </div>
        <div>
            <label style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Build Number</label>
            <div style="font-size: 15px; font-weight: 800; color: var(--text-primary); margin-top: 4px;">{{ data.version.build|default('--') }}</div>
        </div>
        <div>
            <label style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Build Date</label>
            <div style="font-size: 15px; font-weight: 800; color: var(--text-primary); margin-top: 4px;">{{ data.version.build_date|default('--') }}</div>
        </div>
        <div>
            <label style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Release</label>
            <div style="font-size: 15px; font-weight: 800; color: var(--text-primary); margin-top: 4px;">DSM {{ data.version.major|default('--') }}</div>
        </div>
    </div>
</section>

<!-- Storage Inventory -->
<section class="card" style="padding: 0; overflow: hidden; margin-bottom: 32px;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); background: var(--bg-off-white);">
        <h3 style="font-size: 12px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin: 0; letter-spacing: 0.05em;">Discovery: Physical Disk Registry</h3>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Device</th>
                <th>Unit / Bay</th>
                <th>Model / Serial</th>
                <th>Metrics</th>
                <th style="padding-right: 24px; text-align: right;">Integrity Status</th>
            </tr>
        </thead>
        <tbody>
            {% for id, disk in data.disks %}
            <tr>
                <td style="padding-left: 24px; font-family: monospace; font-weight: 700; color: var(--text-primary);">{{ id }}</td>
                <td>
                    <span class="badge" style="background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border);">
                        {{ disk.container }} [B{{ disk.bay|default(disk.slot)|default('--') }}]
                    </span>
                </td>
                <td>
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 13px;">{{ disk.model|default('--') }}</div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; font-weight: 600;">{{ disk.serial|default('--') }}</div>
                </td>
                <td>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ disk.size_gb|default('0') }} GB</div>
                    {% if disk.temp %}
                        <div style="font-size: 11px; font-weight: 700; color: {% if disk.temp > 45 %}var(--danger){% else %}var(--success){% endif %};">{{ disk.temp }}°C</div>
                    {% endif %}
                </td>
                <td style="padding-right: 24px; text-align: right;">
                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 6px;">
                        <span style="font-size: 10px; font-weight: 800; color: {% if disk.status == 'normal' or disk.status == 'detected' %}var(--success){% else %}var(--danger){% endif %}; text-transform: uppercase; letter-spacing: 0.05em;">
                            {{ disk.status|default('UNKNOWN') }}
                        </span>
                        
                        <div style="display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end;">
                            {% if disk.smart_status and disk.smart_status != 'normal' %}
                                <span style="font-size: 9px; padding: 1px 6px; border-radius: 4px; background: var(--danger-light); color: var(--danger); font-weight: 800; border: 1px solid var(--danger);">SMART: {{ disk.smart_status|upper }}</span>
                            {% endif %}
                            
                            {% if disk.bad_sectors and disk.bad_sectors > 0 %}
                                <span style="font-size: 9px; padding: 1px 6px; border-radius: 4px; background: var(--warning-light); color: var(--warning); font-weight: 800; border: 1px solid var(--warning);">BAD: {{ disk.bad_sectors }}</span>
                            {% endif %}

                            {% if disk.timeout_status and disk.timeout_status != 'normal' %}
                                <span style="font-size: 9px; padding: 1px 6px; border-radius: 4px; background: var(--danger-light); color: var(--danger); font-weight: 800; border: 1px solid var(--danger);">TIMEOUT</span>
                            {% endif %}
                        </div>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>

<!-- RAID Summary -->
<section class="card" style="padding: 0; overflow: hidden; margin-bottom: 32px;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); background: var(--bg-off-white);">
        <h3 style="font-size: 12px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin: 0; letter-spacing: 0.05em;">Logical Hierarchy (RAID MAP)</h3>
    </div>
    <div style="padding: 32px;">
        {% if data.raid %}
            <div style="display: flex; flex-direction: column; gap: 32px;">
                {% for array, info in data.raid %}
                    <div>
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                            <span style="font-weight: 800; font-size: 18px; color: var(--text-primary); letter-spacing: -0.01em;">{{ array }}</span>
                            <span class="badge" style="background: var(--bg-light); color: var(--primary); border: 1px solid var(--primary); font-size: 11px;">{{ info.level|upper }}</span>
                            <span style="color: {% if info.status == 'clean' or info.status == 'active' %}var(--success){% else %}var(--warning){% endif %}; font-weight: 800; font-size: 12px; text-transform: uppercase;">{{ info.status }}</span>
                        </div>
                        <pre style="background: #1e293b; color: #cbd5e1; padding: 20px; border-radius: 6px; overflow-x: auto; font-family: 'Cascadia Code', monospace; font-size: 12px; line-height: 1.6; border: 1px solid #334155; box-shadow: inset 0 2px 4px rgba(0,0,0,0.3);">{{ info.raw|default('No raw data captured.') }}</pre>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div style="text-align: center; padding: 48px; color: var(--text-muted);">
                <div style="font-size: 32px; margin-bottom: 12px; opacity: 0.2;">🧊</div>
                <div style="font-weight: 600;">No active RAID arrays detected in this diagnostic sequence.</div>
            </div>
        {% endif %}
    </div>
</section>

<!-- AI Analysis History -->
<section class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); display: flex; justify-content: space-between; align-items: center; background: var(--bg-off-white);">
        <h3 style="font-size: 12px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin: 0; letter-spacing: 0.05em;">Forensic Audit History (Last 12 Months)</h3>
        <span style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">{{ pagination.count }} scan(s) referenced</span>
    </div>
    
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Analysis Date</th>
                <th>Audit Level</th>
                <th>Health Score</th>
                <th style="padding-right: 24px; text-align: right;">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for scan in scans %}
            <tr>
                <td style="padding-left: 24px; color: var(--text-secondary); font-size: 13px; font-weight: 600;">{{ scan.completed_at|date('M d, Y H:i') }}</td>
                <td>
                    <span class="badge" style="background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border);">
                        {{ scan.scan_level|upper }}
                    </span>
                    {% if scan.debug_file_ids|length > 1 %}
                        <span style="font-size: 10px; color: var(--text-muted); font-weight: 700; margin-left: 4px; text-transform: uppercase;">(Unified)</span>
                    {% endif %}
                </td>
                <td>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 60px; height: 6px; background: var(--bg-light); border-radius: 3px; overflow: hidden;">
                            <div style="width: {{ scan.health_score|default(0) }}%; height: 100%; background: {% if scan.health_score > 80 %}var(--success){% elseif scan.health_score > 50 %}var(--warning){% else %}var(--danger){% endif %};"></div>
                        </div>
                        <span style="font-weight: 800; font-size: 12px; font-family: monospace;">{{ scan.health_score|default('--') }}%</span>
                    </div>
                </td>
                <td style="padding-right: 24px; text-align: right;">
                    <a href="/scans/report/{{ scan.id }}" class="btn btn-outline" style="height: 28px; padding: 0 12px; font-size: 11px; font-weight: 700;">View Report</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if pagination.total > 1 %}
    <div style="padding: 20px 24px; border-top: 1px solid var(--row-border); display: flex; justify-content: center; gap: 8px; background: var(--bg-off-white);">
        {% for i in 1..pagination.total %}
            <a href="?page={{ i }}" class="btn btn-sm" style="height: 28px; padding: 0 10px; width: auto; font-weight: 700; {% if i == pagination.current %}background: var(--primary); color: white; border: none;{% else %}background: var(--white); color: var(--text-primary); border: 1px solid var(--border);{% endif %}">{{ i }}</a>
        {% endfor %}
    </div>
    {% endif %}
</section>

{% endblock %}

