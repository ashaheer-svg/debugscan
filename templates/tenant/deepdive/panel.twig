{# ----------------------------------------------------------------------
   DeepDive project-page panel
   Included from templates/tenant/project_view.twig via ONE line:
     {% include 'tenant/deepdive/panel.twig' ignore missing %}
   The `ignore missing` is important — if this file is ever deleted the
   project page still renders.
   Panel itself renders NOTHING if tenants.deepdive_enabled is false.
---------------------------------------------------------------------- #}
{% if tenant is defined and tenant.deepdive_enabled %}
<div class="deepdive-panel" style="border:1px solid #e5e7eb;border-radius:8px;padding:16px;margin-top:24px;background:#fafbfc">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
    <div>
      <div style="font-weight:600;font-size:15px">Deep Diagnostic <span style="font-size:11px;color:#888;font-weight:500;background:#fff7e6;padding:2px 6px;border-radius:10px;margin-left:6px">Beta</span></div>
      <div style="font-size:12px;color:#666;margin-top:4px">Evidence-cited, rule-driven analysis with cause-chain correlation. Separate from the AI Diagnostic above.</div>
    </div>
    <form method="post" action="{{ base_path }}/deepdive/start/{{ project.id }}" style="margin:0">
      {{ csrf.inputs|raw }}
      <button type="submit" class="btn" style="background:#0b5ed7;color:#fff;border:0;padding:8px 16px;border-radius:6px;font-weight:600;cursor:pointer">
        Run Deep Dive
      </button>
    </form>
  </div>

  {% if deepdive_history is defined and deepdive_history|length > 0 %}
    <div style="margin-top:16px;border-top:1px solid #eee;padding-top:12px">
      <div style="font-size:12px;color:#666;margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em">Past deep dives</div>
      <table style="width:100%;font-size:12px;border-collapse:collapse">
        <thead>
          <tr style="color:#666">
            <th style="text-align:left;padding:8px">Started</th>
            <th style="text-align:left;padding:8px">Status</th>
            <th style="text-align:left;padding:8px">Progress</th>
            <th style="text-align:right;padding:8px">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for h in deepdive_history %}
            <tr style="border-top:1px solid #f0f0f0">
              <td style="padding:12px 8px;color:#666">{{ h.queued_at|default('—') }}</td>
              <td style="padding:12px 8px">
                <span style="display:inline-block;padding:4px 8px;border-radius:4px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;
                  {% if h.status == 'completed' %}background:#d1fae5;color:#047857
                  {% elseif h.status == 'failed' %}background:#fee2e2;color:#dc2626
                  {% elseif h.status == 'running' %}background:#dbeafe;color:#0284c7
                  {% else %}background:#f3f4f6;color:#6b7280
                  {% endif %}
                ">{{ h.status }}</span>
              </td>
              <td style="padding:12px 8px;color:#666">{{ h.progress_percent|default(0) }}%</td>
              <td style="padding:12px 8px;text-align:right">
                <div style="display:flex;gap:6px;justify-content:flex-end;align-items:center">
                  {% if h.status == 'completed' %}
                    <a href="{{ base_path }}/deepdive/report/{{ h.id }}"
                       class="btn-action btn-success-alt"
                       data-tooltip="View Report"
                       target="_blank"
                       style="display:inline-flex;align-items:center;justify-content:center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/></svg>
                    </a>
                    <a href="{{ base_path }}/deepdive/download/{{ h.id }}/html"
                       class="btn-action btn-info-alt"
                       data-tooltip="Download HTML"
                       style="display:inline-flex;align-items:center;justify-content:center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </a>
                    {% if h.report_pdf_path %}
                      <a href="{{ base_path }}/deepdive/download/{{ h.id }}/pdf"
                         class="btn-action btn-info-alt"
                         data-tooltip="Download PDF"
                         style="display:inline-flex;align-items:center;justify-content:center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                      </a>
                    {% endif %}
                  {% else %}
                    <a href="{{ base_path }}/deepdive/view/{{ h.id }}"
                       class="btn-action btn-info-alt"
                       data-tooltip="View Status"
                       style="display:inline-flex;align-items:center;justify-content:center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </a>
                  {% endif %}
                  <button onclick="deleteDeepDive('{{ h.id }}')"
                          class="btn-action btn-danger-alt"
                          data-tooltip="Delete Report"
                          style="display:inline-flex;align-items:center;justify-content:center;border:none;background:none;cursor:pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  <script>
    function deleteDeepDive(jobId) {
      if (!confirm('Permanently delete this Deep Dive analysis report? This cannot be undone.')) {
        return;
      }

      const formData = new FormData();
      formData.append('{{ csrf.keys.name }}', '{{ csrf.name }}');
      formData.append('{{ csrf.keys.value }}', '{{ csrf.value }}');

      fetch(`{{ base_path }}/deepdive/delete/${jobId}`, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert(data.message || 'Failed to delete report');
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('An error occurred while deleting the report');
      });
    }
  </script>
</div>
{% endif %}
