{% extends "layout/dashboard.twig" %}
{% block content %}

{# Modal Backdrop & Container #}
<div id="dd-modal-backdrop" style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9998;font-family:system-ui,-apple-system,'Segoe UI',sans-serif">

  {# Modal Dialog #}
  <div id="dd-modal" style="background:#fff;border-radius:8px;box-shadow:0 10px 40px rgba(0,0,0,0.2);width:90%;max-width:600px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden">

    {# Modal Header #}
    <div style="padding:20px;border-bottom:1px solid #e5e7eb;background:linear-gradient(135deg,#0066cc 0%,#004a99 100%);color:#fff;display:flex;justify-content:space-between;align-items:flex-start">
      <div>
        <h2 style="margin:0 0 4px;font-size:18px;font-weight:600">DeepDive Analysis in Progress</h2>
        <p style="margin:0;font-size:13px;opacity:0.85">Job <code style="background:rgba(255,255,255,0.2);padding:2px 6px;border-radius:3px;font-family:monospace">{{ job.id }}</code></p>
      </div>
      <button id="dd-close-btn" onclick="document.getElementById('dd-modal-backdrop').style.display='none'" style="background:none;border:none;color:#fff;font-size:24px;cursor:pointer;padding:0;width:24px;height:24px;display:flex;align-items:center;justify-content:center;opacity:0.7;transition:opacity .2s" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">✕</button>
    </div>

    {# Modal Body #}
    <div style="padding:24px;overflow-y:auto;flex:1">

      {# Progress Section #}
      <div style="margin-bottom:24px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <div style="font-weight:600;font-size:14px" id="dd-stage">{{ job.progress_stage|default('Queued') }}</div>
          <div style="background:#f0f0f0;padding:2px 8px;border-radius:3px;font-weight:600;color:#0066cc;font-size:13px" id="dd-pct">{{ job.progress_percent|default(0) }}%</div>
        </div>
        <div style="height:24px;background:#f5f5f5;border-radius:12px;overflow:hidden;border:1px solid #e0e0e0;position:relative">
          <div id="dd-bar" style="height:100%;width:{{ job.progress_percent|default(0) }}%;background:linear-gradient(90deg,#0066cc 0%,#0052a3 100%);transition:width .4s ease;display:flex;align-items:center;justify-content:flex-end;padding-right:8px">
            <span style="font-size:11px;font-weight:600;color:#fff;opacity:0" id="dd-bar-text"></span>
          </div>
        </div>
        <div style="font-size:12px;color:#666;margin-top:6px" id="dd-status">Status: {{ job.status }}</div>
      </div>

      {# Steps List #}
      <div style="margin:20px 0">
        <div style="font-size:12px;font-weight:600;color:#333;margin-bottom:12px;text-transform:uppercase;letter-spacing:0.5px">Analysis Steps</div>
        <ol id="dd-steps" style="list-style:none;padding:0;margin:0;font-size:13px">
          {% for s in steps %}
            <li data-id="{{ s.id }}" style="display:flex;gap:10px;padding:12px;margin-bottom:8px;background:#f9f9f9;border-left:3px solid #ddd;border-radius:4px;transition:all .3s">
              <span class="dd-icon" style="width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;font-weight:600;flex-shrink:0;{% if s.status == 'done' or s.status == 'completed' %}background:#28a745;color:#fff{% elseif s.status == 'failed' %}background:#dc3545;color:#fff{% elseif s.status == 'running' %}background:#0066cc;color:#fff;animation:pulse 2s infinite{% elseif s.status == 'skipped' %}background:#999;color:#fff;opacity:.7{% else %}background:#e0e0e0;color:#999{% endif %}">
                {% if s.status == 'done' or s.status == 'completed' %}✓{% elseif s.status == 'failed' %}✕{% elseif s.status == 'running' %}⟳{% elseif s.status == 'skipped' %}–{% else %}·{% endif %}
              </span>
              <span style="flex:1">
                <div style="font-weight:500;color:#333">{{ s.label }}</div>
                {% if s.detail %}<div style="color:#666;font-size:12px;margin-top:2px">{{ s.detail }}</div>{% endif %}
                {% if s.error %}<div style="color:#dc3545;font-size:12px;margin-top:4px;padding:6px;background:#fff5f5;border-left:2px solid #dc3545;border-radius:2px">{{ s.error }}</div>{% endif %}
              </span>
            </li>
          {% endfor %}
        </ol>
      </div>

      {# Error Alert #}
      <div id="dd-error" style="display:{% if job.status == 'failed' %}flex{% else %}none{% endif %};align-items:flex-start;background:#fff5f5;border:1px solid #f5c6cb;border-radius:6px;padding:16px;margin-bottom:16px">
        <div style="font-size:24px;margin-right:12px;flex-shrink:0">⚠️</div>
        <div>
          <h3 style="margin:0 0 6px;color:#721c24;font-size:14px">Job Failed</h3>
          <p style="margin:0;color:#721c24;font-size:13px;line-height:1.5" id="dd-err-msg">{{ job.error_message|default('unknown error') }}</p>
        </div>
      </div>

      {# Completion Actions #}
      <div id="dd-done" style="display:{% if job.status == 'completed' %}flex{% else %}none{% endif %};gap:10px;padding-top:16px;border-top:1px solid #e0e0e0;flex-wrap:wrap;justify-content:center">
        <a href="{{ base_path }}/deepdive/report/{{ job.id }}" target="_blank" style="background:#0066cc;color:#fff;padding:10px 20px;border-radius:6px;text-decoration:none;font-weight:500;font-size:13px;transition:background .2s" onmouseover="this.style.background='#004a99'" onmouseout="this.style.background='#0066cc'">View Report</a>
        <a href="{{ base_path }}/deepdive/download/{{ job.id }}/html" style="background:#e8e8e8;color:#333;padding:10px 20px;border-radius:6px;text-decoration:none;font-weight:500;font-size:13px;transition:background .2s" onmouseover="this.style.background='#d0d0d0'" onmouseout="this.style.background='#e8e8e8'">Download HTML</a>
        <a href="{{ base_path }}/deepdive/download/{{ job.id }}/pdf" style="background:#e8e8e8;color:#333;padding:10px 20px;border-radius:6px;text-decoration:none;font-weight:500;font-size:13px;transition:background .2s" onmouseover="this.style.background='#d0d0d0'" onmouseout="this.style.background='#e8e8e8'">Download PDF</a>
      </div>

    </div>
  </div>

</div>

{# Fallback page content (visible if modal is closed) #}
<div style="max-width:820px;margin:0 auto;opacity:0.5;pointer-events:none">
  <a href="{{ base_path }}/projects/view/{{ job.project_id }}" style="font-size:13px;color:#0b5ed7;text-decoration:none">&larr; back to project</a>
  <h2 style="margin:8px 0 4px">Deep Diagnostic</h2>
  <div style="color:#666;font-size:13px">Job <code>{{ job.id }}</code> · queued {{ job.queued_at|default('—') }}</div>
</div>

{# Pulse animation for running steps #}
<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
</style>

<script>
(function(){
  const jobId = '{{ job.id }}';
  const backdrop = document.getElementById('dd-modal-backdrop');
  const closeBtn = document.getElementById('dd-close-btn');
  let pollInterval = null;

  // Fetch job status and update DOM
  async function fetchAndUpdate() {
    try {
      const response = await fetch('/deepdive/api/job/' + encodeURIComponent(jobId) + '/status', {
        credentials: 'include'
      });
      if (!response.ok) return;

      const data = await response.json();
      const isComplete = data.status === 'completed' || data.status === 'failed';

      // Update progress bar and percentage
      const bar = document.getElementById('dd-bar');
      const pct = document.getElementById('dd-pct');
      bar.style.width = data.progress_percent + '%';
      pct.textContent = data.progress_percent + '%';

      // Update status text
      document.getElementById('dd-stage').textContent = data.progress_stage;
      document.getElementById('dd-status').textContent = 'Status: ' + data.status;

      // Update steps list
      if (data.steps && data.steps.length > 0) {
        updateStepsList(data.steps);
      }

      // Update error message
      if (data.status === 'failed') {
        const errorDiv = document.getElementById('dd-error');
        errorDiv.style.display = 'flex';
        document.getElementById('dd-err-msg').textContent = data.error_message || 'unknown error';
      }

      // When job completes, close modal and show fallback
      if (isComplete) {
        clearInterval(pollInterval);
        closeBtn.style.opacity = '1';
        closeBtn.style.cursor = 'pointer';
        closeBtn.onclick = function() {
          backdrop.style.display = 'none';
        };

        // Auto-close modal after 2 seconds
        setTimeout(function() {
          backdrop.style.display = 'none';
        }, 2000);
      }
    } catch (e) {
      console.error('Poll error:', e);
    }
  }

  function updateStepsList(steps) {
    const stepsList = document.getElementById('dd-steps');

    // Update existing steps or create new ones
    steps.forEach((step, idx) => {
      let li = document.querySelector('li[data-id="' + step.id + '"]');

      if (!li) {
        // Create new step element
        li = document.createElement('li');
        li.setAttribute('data-id', step.id);
        li.style.cssText = 'display:flex;gap:10px;padding:12px;margin-bottom:8px;background:#f9f9f9;border-left:3px solid #ddd;border-radius:4px;transition:all .3s';

        const icon = document.createElement('span');
        icon.className = 'dd-icon';
        icon.style.cssText = 'width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;font-weight:600;flex-shrink:0;transition:all .3s';

        const content = document.createElement('span');
        content.style.cssText = 'flex:1';

        li.appendChild(icon);
        li.appendChild(content);
        stepsList.appendChild(li);
      }

      // Update step status icon and styling
      const icon = li.querySelector('.dd-icon');
      const content = li.querySelector('span:last-child');

      let iconBg = '#e0e0e0', iconColor = '#999', iconText = '·';
      if (step.status === 'done' || step.status === 'completed') {
        iconBg = '#28a745'; iconColor = '#fff'; iconText = '✓';
      } else if (step.status === 'failed') {
        iconBg = '#dc3545'; iconColor = '#fff'; iconText = '✕';
      } else if (step.status === 'running') {
        iconBg = '#0066cc'; iconColor = '#fff'; iconText = '⟳';
      } else if (step.status === 'skipped') {
        iconBg = '#999'; iconColor = '#fff'; iconText = '–';
      }

      icon.style.background = iconBg;
      icon.style.color = iconColor;
      icon.textContent = iconText;
      if (step.status === 'running') {
        icon.style.animation = 'pulse 2s infinite';
      } else {
        icon.style.animation = 'none';
      }

      // Update step content
      let html = '<div style="font-weight:500;color:#333">' + escapeHtml(step.label) + '</div>';
      if (step.detail) {
        html += '<div style="color:#666;font-size:12px;margin-top:2px">' + escapeHtml(step.detail) + '</div>';
      }
      if (step.error) {
        html += '<div style="color:#dc3545;font-size:12px;margin-top:4px;padding:6px;background:#fff5f5;border-left:2px solid #dc3545;border-radius:2px">' + escapeHtml(step.error) + '</div>';
      }
      content.innerHTML = html;
    });
  }

  function escapeHtml(text) {
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return text.replace(/[&<>"']/g, function(m) { return map[m]; });
  }

  // Ensure modal is visible on load
  backdrop.style.display = 'flex';

  // Initial state: disable close button if job not complete
  const initialStatus = '{{ job.status }}';
  if (initialStatus !== 'completed' && initialStatus !== 'failed') {
    closeBtn.style.opacity = '0.3';
    closeBtn.style.cursor = 'not-allowed';
    closeBtn.onclick = function() { return false; };

    // Start polling
    fetchAndUpdate();
    pollInterval = setInterval(fetchAndUpdate, 2000);
  } else {
    // Job already complete, allow close immediately
    closeBtn.style.opacity = '1';
    closeBtn.style.cursor = 'pointer';
    closeBtn.onclick = function() {
      backdrop.style.display = 'none';
    };
  }
})();
</script>

{% endblock %}
