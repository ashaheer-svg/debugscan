{% extends "layout/dashboard.twig" %}
{% block content %}
<div style="max-width:820px;margin:0 auto">
  <a href="{{ base_path }}/projects/view/{{ job.project_id }}" style="font-size:13px;color:#0b5ed7;text-decoration:none">&larr; back to project</a>
  <h2 style="margin:8px 0 4px">Deep Diagnostic</h2>
  <div style="color:#666;font-size:13px">Job <code>{{ job.id }}</code> · queued {{ job.queued_at|default('—') }}</div>
</div>

{# Include the advanced progress modal #}
{% include 'tenant/deepdive/progress-modal.twig' %}

<script>
  // Initialize the progress modal with job ID and base path
  document.addEventListener('DOMContentLoaded', function() {
    window._ddJobId = {{ job.id|json_encode|raw }};
    window._basePath = {{ base_path|json_encode|raw }};
    new DeepDiveProgressModal({{ job.id|json_encode|raw }}, {{ base_path|json_encode|raw }});
  });
</script>
{% endblock %}
