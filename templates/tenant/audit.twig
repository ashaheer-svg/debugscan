{% extends "layout/dashboard.twig" %}

{% block title %}My Activity Log - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
    <div>
        <h1 class="page-title">Activity Log</h1>
        <p class="page-subtitle">Complete history of your forensic activities and token usage.</p>
    </div>
    <div style="text-align: right;">
        <div style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px;">Available Balance</div>
        <div style="font-size: 24px; font-weight: 800; color: var(--primary);">{{ tokens_available|number_format }} <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);">tokens</span></div>
    </div>
</header>

<!-- Filter Console -->
<section class="dashboard-card" style="margin-bottom: 24px; background: var(--bg-light); border-color: var(--border);">
    <form method="GET" style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 150px;">
            <label class="form-label" style="font-size: 11px; font-weight: 700; color: var(--text-secondary); margin-bottom: 4px; display: block;">SEARCH</label>
            <input type="text" name="q" value="{{ search }}" class="form-control" placeholder="Keywords..." style="background: var(--white); border-color: var(--border);">
        </div>
        <div style="flex: 0 0 160px;">
            <label class="form-label" style="font-size: 11px; font-weight: 700; color: var(--text-secondary); margin-bottom: 4px; display: block;">DATE FROM</label>
            <input type="date" name="from" value="{{ filters.from }}" class="form-control" style="background: var(--white); border-color: var(--border);">
        </div>
        <div style="flex: 0 0 160px;">
            <label class="form-label" style="font-size: 11px; font-weight: 700; color: var(--text-secondary); margin-bottom: 4px; display: block;">DATE TO</label>
            <input type="date" name="to" value="{{ filters.to }}" class="form-control" style="background: var(--white); border-color: var(--border);">
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label class="form-label" style="font-size: 11px; font-weight: 700; color: var(--text-secondary); margin-bottom: 4px; display: block;">ACTIVITY TYPE</label>
            <select name="category" class="form-control" style="background: var(--white); border-color: var(--border);">
                <option value="all" {% if filters.category == 'all' %}selected{% endif %}>All Activities</option>
                <option value="financial" {% if filters.category == 'financial' %}selected{% endif %}>Token Usage & Top-ups</option>
                <option value="scans" {% if filters.category == 'scans' %}selected{% endif %}>AI Analysis & Scans</option>
                <option value="files" {% if filters.category == 'files' %}selected{% endif %}>File Activity</option>
                <option value="sessions" {% if filters.category == 'sessions' %}selected{% endif %}>Account Sessions</option>
            </select>
        </div>
        <div style="display: flex; gap: 8px;">
            <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">
                Filter
            </button>
            <a href="/audit/export?from={{ filters.from }}&to={{ filters.to }}&q={{ search }}&category={{ filters.category }}" class="btn btn-secondary" style="background: var(--white); color: var(--text-primary); border: 1px solid var(--border); padding: 10px 20px; display: flex; align-items: center; gap: 8px; text-decoration: none; font-size: 14px; font-weight: 600; border-radius: var(--radius-sm);">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export
            </a>
        </div>
    </form>
</section>

<!-- Audit Table -->
<section class="dashboard-card" style="padding: 0; overflow: hidden;">
    <table class="data-table" style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: var(--bg-light); border-bottom: 1px solid var(--border);">
                <th style="padding: 12px 24px; text-align: left; width: 180px;">
                    <a href="?from={{ filters.from }}&to={{ filters.to }}&category={{ filters.category }}&q={{ search }}&sort=created_at&order={{ (sort == 'created_at' and order == 'DESC') ? 'ASC' : 'DESC' }}" 
                       style="text-decoration: none; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: flex; align-items: center; gap: 6px;">
                        Timestamp (UTC)
                        {% if sort == 'created_at' %}
                            <i class="fas fa-sort-{{ order == 'DESC' ? 'down' : 'up' }}" style="font-size: 10px; color: var(--primary);"></i>
                        {% endif %}
                    </a>
                </th>
                <th style="padding: 12px; text-align: left; width: 150px;">
                    <a href="?from={{ filters.from }}&to={{ filters.to }}&category={{ filters.category }}&q={{ search }}&sort=action&order={{ (sort == 'action' and order == 'ASC') ? 'DESC' : 'ASC' }}" 
                       style="text-decoration: none; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: flex; align-items: center; gap: 6px;">
                        Action
                        {% if sort == 'action' %}
                            <i class="fas fa-sort-{{ order == 'DESC' ? 'down' : 'up' }}" style="font-size: 10px; color: var(--primary);"></i>
                        {% endif %}
                    </a>
                </th>
                <th style="padding: 12px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Activity Details</th>
                <th style="padding: 12px 24px; text-align: right; width: 140px; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">IP Address</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            {% set details = log.details|json_decode %}
            <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 16px 24px; color: var(--text-secondary); font-size: 12px; font-weight: 500;">
                    {{ log.created_at|date('Y-m-d H:i:s') }}
                </td>
                <td style="padding: 16px 12px;">
                    <span class="badge" style="
                        {% if log.action in ['tokens_allocated', 'tokens_redeemed'] %}
                            background: var(--success-light); color: var(--success); border: 1px solid var(--success);
                        {% elseif log.action in ['tokens_deducted', 'scan_failed'] %}
                            background: var(--error-light); color: var(--error); border: 1px solid var(--error);
                        {% elseif log.action == 'login' %}
                            background: #e3f2fd; color: #1976d2; border: 1px solid #bbdefb;
                        {% else %}
                            background: var(--bg-light); color: var(--text-muted); border: 1px solid var(--border);
                        {% endif %}
                        text-transform: uppercase; font-size: 10px; padding: 2px 8px; font-weight: 700; border-radius: 4px;
                    ">
                        {{ log.action|replace({'_': ' '}) }}
                    </span>
                </td>
                <td style="padding: 16px 12px;">
                    <!-- Activity Context -->
                    {% if details.project_name %}
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 13px; margin-bottom: 4px;">
                        Project: {{ details.project_name }}
                    </div>
                    {% endif %}

                    <!-- Token Transaction Logic -->
                    {% if log.action in ['tokens_allocated', 'tokens_redeemed', 'tokens_deducted', 'scan_completed'] %}
                    <div style="display: flex; align-items: center; gap: 12px; margin-top: 4px;">
                        <div style="font-size: 13px; font-weight: 800; color: {% if log.action in ['tokens_allocated', 'tokens_redeemed'] %}var(--success){% else %}var(--error){% endif %};">
                            {% if log.action in ['tokens_allocated', 'tokens_redeemed'] %}+{% else %}-{% endif %}
                            {{ (details.amount ?: (details.used ?: 0))|number_format }}
                        </div>
                        <div style="display: flex; gap: 8px; font-size: 11px; background: var(--bg-light); padding: 4px 8px; border-radius: 4px; border: 1px dashed var(--border);">
                            <span style="color: var(--text-muted);">Bal: <span style="text-decoration: line-through;">{{ details.before|number_format }}</span></span>
                            <span style="color: var(--text-muted);">→</span>
                            <span style="color: var(--text-primary); font-weight: 700;">{{ details.after|number_format }}</span>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Resource metadata -->
                    {% if details.filename %}
                    <div style="color: var(--text-secondary); font-size: 12px;">File: {{ details.filename }}</div>
                    {% endif %}
                    {% if details.package_name or details.scan_level %}
                    <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-top: 4px;">Package: {{ (details.package_name ?: (details.scan_level|replace({'level': 'Level '})))|upper }}</div>
                    {% endif %}
                </td>
                <td style="padding: 16px 24px; text-align: right; color: var(--text-muted); font-size: 12px; font-family: monospace;">
                    {{ log.ip_address ?: 'Internal' }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if not logs %}
    <div style="padding: 80px; text-align: center; color: var(--text-muted);">
        <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">📋</div>
        <div style="font-weight: 600; color: var(--text-primary);">No activity logs found for this search</div>
        <p style="font-size: 13px; margin-top: 8px;">Try adjusting your search keywords or range filters.</p>
    </div>
    {% endif %}

    {# Pagination Footer #}
    {% if totalPages > 1 %}
    <footer style="padding: 16px 24px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: var(--white);">
        <div style="font-size: 12px; color: var(--text-muted); font-weight: 600;">
            Page <strong>{{ currentPage }}</strong> of <strong>{{ totalPages }}</strong>
        </div>
        <div style="display: flex; gap: 6px;">
            {% if currentPage > 1 %}
                <a href="?page={{ currentPage - 1 }}&from={{ filters.from }}&to={{ filters.to }}&category={{ filters.category }}&q={{ search }}&sort={{ sort }}&order={{ order }}" 
                   style="padding: 6px 12px; border: 1px solid var(--border); border-radius: 4px; text-decoration: none; color: var(--text-primary); font-size: 12px; font-weight: 600; background: white;">Previous</a>
            {% endif %}
            
            {% for i in max(1, currentPage - 2)..min(totalPages, currentPage + 2) %}
                <a href="?page={{ i }}&from={{ filters.from }}&to={{ filters.to }}&category={{ filters.category }}&q={{ search }}&sort={{ sort }}&order={{ order }}" 
                   style="padding: 6px 12px; border: 1px solid var(--border); border-radius: 4px; text-decoration: none; font-size: 12px; font-weight: 700; 
                          {% if i == currentPage %}background: var(--primary); color: white; border-color: var(--primary);{% else %}background: white; color: var(--text-primary);{% endif %}">{{ i }}</a>
            {% endfor %}

            {% if currentPage < totalPages %}
                <a href="?page={{ currentPage + 1 }}&from={{ filters.from }}&to={{ filters.to }}&category={{ filters.category }}&q={{ search }}&sort={{ sort }}&order={{ order }}" 
                   style="padding: 6px 12px; border: 1px solid var(--border); border-radius: 4px; text-decoration: none; color: var(--text-primary); font-size: 12px; font-weight: 600; background: white;">Next</a>
            {% endif %}
        </div>
    </footer>
    {% endif %}
</section>

{% endblock %}
