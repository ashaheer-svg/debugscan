{% extends "layout/dashboard.twig" %}

{% block title %}Token Transactions - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header">
    <h1 class="page-title">Token Transaction History</h1>
    <p class="page-subtitle">Detailed audit trail for your AI token acquisitions and usage.</p>
</header>

<section class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); background: var(--bg-off-white); display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Transaction Log</h3>
        <button onclick="document.getElementById('tokenModal').style.display='flex'" class="btn-action" title="Request More Tokens" style="padding: 4px; line-height: 1; min-width: auto; background: var(--primary); color: white; border: none; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;">
            <i class="fas fa-plus-circle" style="font-size: 14px;"></i>
        </button>
    </div>
    
    {% if logs %}
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Date</th>
                <th>Action</th>
                <th>Details</th>
                <th style="padding-right: 24px;">Tokens</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            {% set details = log.details|json_decode %}
            <tr>
                <td style="padding-left: 24px; color: var(--text-secondary); font-size: 13px;">{{ log.created_at|date('M d, Y H:i:s') }}</td>
                <td>
                    {% if log.action == 'tokens_deducted' %}
                        <span class="badge" style="background: var(--error-light); color: var(--error);">DEDUCTION</span>
                    {% elseif log.action == 'tokens_allocated' or log.action == 'tokens_redeemed' %}
                        <span class="badge" style="background: var(--success-light); color: var(--success);">CREDIT</span>
                    {% else %}
                        <span class="badge" style="background: var(--info-light); color: var(--info);">{{ log.action|upper|replace({'_':' '}) }}</span>
                    {% endif %}
                </td>
                <td style="font-size: 13px;">
                    {% if log.action == 'tokens_deducted' %}
                        AI Analysis Scan (Job: {{ details.job_id|slice(0,8) }})
                    {% elseif log.action == 'tokens_requested' %}
                        Purchase Request for {{ details.amount|number_format }} tokens
                    {% elseif log.action == 'tokens_redeemed' %}
                        Magic Link Redemption
                    {% elseif log.action == 'tokens_allocated' %}
                        Manual Admin Allocation
                    {% else %}
                        {{ log.details }}
                    {% endif %}
                </td>
                <td style="padding-right: 24px; font-weight: 600; text-align: right;">
                    {% if log.action == 'tokens_deducted' %}
                        <span style="color: var(--error);">-{{ (details.amount_deducted ?: (details.used ?: 0))|number_format }}</span>
                    {% elseif log.action == 'tokens_allocated' or log.action == 'tokens_redeemed' %}
                        <span style="color: var(--success);">+{{ details.amount|number_format }}</span>
                    {% else %}
                        <span style="color: var(--text-muted);">{{ details.amount|number_format|default('0') }}</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div style="padding: 64px; text-align: center; color: var(--text-muted); font-size: 14px;">
        <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">📄</div>
        <div style="font-weight: 600; color: var(--text-primary);">No transactions yet</div>
        <div style="margin-top: 4px;">Token acquisitions and usage logs will appear here.</div>
    </div>
    {% endif %}
</section>

<!-- Request Tokens Modal -->
<div id="tokenModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="card" style="width: 400px; padding: 24px;">
        <h2 style="margin-top: 0;">Request AI Tokens</h2>
        <p style="font-size: 14px; color: var(--text-secondary);">Tokens are requested in blocks of 20,000. An administrator will review your request and grant the tokens via a magic link.</p>
        
        <form action="/tokens/purchase" method="POST">
            {{ csrf.inputs | raw }}
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">Number of Blocks</label>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <input type="number" name="blocks" value="1" min="1" max="10" style="width: 80px; padding: 8px; border: 1px solid var(--row-border); border-radius: 4px;">
                    <span style="font-size: 14px; color: var(--text-muted);">x 20,000 = <strong id="tokenTotal">20,000</strong> tokens</span>
                </div>
            </div>
            
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" onclick="document.getElementById('tokenModal').style.display='none'" class="btn" style="background: transparent; color: var(--text-secondary);">Cancel</button>
                <button type="submit" class="btn btn-primary" style="background: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">Submit Request</button>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelector('input[name="blocks"]').addEventListener('input', function(e) {
    const blocks = parseInt(e.target.value) || 0;
    const totalEl = document.getElementById('tokenTotal');
    if (totalEl) totalEl.textContent = (blocks * 20000).toLocaleString();
});
</script>
{% endblock %}
