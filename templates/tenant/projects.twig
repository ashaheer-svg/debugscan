{% extends "layout/dashboard.twig" %}

{% set active_page = 'projects' %}

{% block title %}Projects - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <h1 class="page-title">Forensic Projects</h1>
        <p class="page-subtitle">Manage cases and their associated diagnostic files.</p>
    </div>
    <button type="button" class="btn btn-primary" style="width: auto;" onclick="document.getElementById('new-project-modal').style.display='flex'">
        + Create New Project
    </button>
</header>

<section class="card" style="padding: 0; overflow: hidden; border: 1px solid var(--row-border);">
    {% if projects %}
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px; width: 40%;">Project Identity / Notes</th>
                <th>Model / DSM</th>
                <th>Serial Number</th>
                <th>Created Date</th>
                <th style="padding-right: 24px; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for project in projects %}
            <tr style="cursor: pointer;" onclick="window.location='{{ base_path }}/projects/view/{{ project.id }}'">
                <td style="padding-left: 24px; vertical-align: middle;">
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 15px; letter-spacing: -0.01em;">{{ project.name }}</div>
                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px; font-weight: 500;">{{ project.notes|default('No forensic notes recorded.')|slice(0, 80) }}{% if project.notes|length > 80 %}...{% endif %}</div>
                </td>
                <td style="vertical-align: middle;">
                    <div style="font-weight: 600; color: var(--text-secondary);">{{ project.model|default('ID PENDING') }}</div>
                    {% if project.dsm_version %}
                    <div style="font-size: 11px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin-top: 2px;">DSM {{ project.dsm_version }}</div>
                    {% endif %}
                </td>
                <td style="vertical-align: middle;">
                    <code style="background: var(--bg-light); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border); font-size: 12px; font-weight: 600; color: var(--primary);">{{ project.serial_number|default('S/N PENDING') }}</code>
                </td>
                <td style="vertical-align: middle; color: var(--text-muted); font-size: 13px; font-weight: 500;">
                    {{ project.created_at|date('M d, Y') }}
                </td>
                <td style="padding-right: 24px; text-align: right; vertical-align: middle;">
                    <a href="{{ base_path }}/projects/view/{{ project.id }}" class="btn-action" data-tooltip="View Forensic Data" aria-label="View Forensic Data">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><path d="M12 11v6"/><path d="M9 14h6"/></svg>
                    </a>
                    <form action="{{ base_path }}/projects/delete/{{ project.id }}" method="POST" style="display: inline;" onsubmit="return confirm('WARNING: This will permanently delete the project and all associated forensic data/scans. Continue?');">
                        {{ csrf.inputs | raw }}
                        <button type="submit" class="btn-action" style="color: var(--danger); border-color: rgba(220, 53, 69, 0.2); background: rgba(220, 53, 69, 0.05);" data-tooltip="Delete Project" onclick="event.stopPropagation();">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div style="padding: 80px 24px; text-align: center;">
        <div style="font-size: 48px; margin-bottom: 20px; opacity: 0.2;">📁</div>
        <h2 style="font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">No forensic projects found</h2>
        <p style="color: var(--text-secondary); margin-bottom: 32px; max-width: 400px; margin-left: auto; margin-right: auto;">Start by creating your first forensic project to analyze Synology debug logs and map hardware identities.</p>
        <button type="button" class="btn btn-primary" style="width: auto; padding: 10px 32px;" onclick="document.getElementById('new-project-modal').style.display='flex'">
            + Create Your First Project
        </button>
    </div>
    {% endif %}
</section>

<!-- Simple Project Creation Modal -->
<div id="new-project-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 400; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card" style="width: 100%; max-width: 480px; padding: 32px; box-shadow: var(--shadow-4);">
        <h2 style="font-weight: 700; font-size: 20px; margin-bottom: 24px; color: var(--text-primary);">Create New Project</h2>
        <form action="{{ base_path }}/projects/create" method="POST">
            {{ csrf.inputs | raw }}
            <div class="form-group">
                <label for="name" class="form-label">Project Name</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="Case Ref #1234" required autofocus>
            </div>
            <div class="form-group">
                <label for="notes" class="form-label">Notes (Optional)</label>
                <textarea id="notes" name="notes" class="form-control" style="height: 120px; resize: vertical;" placeholder="Internal case details or briefing notes..."></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
                <button type="button" class="btn btn-outline" style="width: auto; border: none; color: var(--text-muted);" onclick="document.getElementById('new-project-modal').style.display='none'">Cancel</button>
                <button type="submit" class="btn btn-primary" style="width: auto; padding: 10px 24px; font-weight: 700;">Create Project</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
