{% extends "layout/dashboard.twig" %}

{% set active_page = 'projects' %}

{% block title %}Projects - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <h1 class="page-title">Forensic Projects</h1>
        <p class="page-subtitle">Manage cases and their associated diagnostic files.</p>
    </div>
    <button type="button" class="btn btn-primary" style="width: auto;" onclick="document.getElementById('new-project-modal').style.display='flex'">
        + Create New Project
    </button>
</header>

<div class="card" style="padding: 32px;">
    {% if projects %}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        {% for project in projects %}
        <article class="card" style="padding: 24px; cursor: pointer; border: 1px solid var(--row-border);" onclick="window.location='/projects/view/{{ project.id }}'">
            <h3 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; letter-spacing: -0.01em;">{{ project.name }}</h3>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 24px; min-height: 40px; line-height: 1.6;">{{ project.notes|default('No notes provided for this case.')|slice(0, 100) }}...</p>
            
            <footer style="display: flex; border-top: 1px solid var(--row-border); padding-top: 16px; justify-content: space-between; align-items: center;">
                <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">
                    Created: {{ project.created_at|date('M d, Y') }}
                </span>
                <span class="badge" style="background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border);">
                    {{ project.serial_number|default('ID PENDING') }}
                </span>
            </footer>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div style="padding: 80px 24px; text-align: center;">
        <div style="font-size: 48px; margin-bottom: 20px; opacity: 0.2;">📁</div>
        <h2 style="font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">No projects found</h2>
        <p style="color: var(--text-secondary); margin-bottom: 32px; max-width: 400px; margin-left: auto; margin-right: auto;">Start by creating your first forensic project to analyze Synology debug logs and map hardware identities.</p>
        <button type="button" class="btn btn-primary" style="width: auto; padding: 10px 32px;" onclick="document.getElementById('new-project-modal').style.display='flex'">
            + Create Your First Project
        </button>
    </div>
    {% endif %}
</div>

<!-- Simple Project Creation Modal -->
<div id="new-project-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 400; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card" style="width: 100%; max-width: 480px; padding: 32px; box-shadow: var(--shadow-4);">
        <h2 style="font-weight: 700; font-size: 20px; margin-bottom: 24px; color: var(--text-primary);">Create New Project</h2>
        <form action="/projects/create" method="POST">
            <div class="form-group">
                <label for="name" class="form-label">Project Name</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="Case Ref #1234" required autofocus>
            </div>
            <div class="form-group">
                <label for="notes" class="form-label">Notes (Optional)</label>
                <textarea id="notes" name="notes" class="form-control" style="height: 120px; resize: vertical;" placeholder="Internal case details or briefing notes..."></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
                <button type="button" class="btn btn-outline" style="width: auto; border: none; color: var(--text-muted);" onclick="document.getElementById('new-project-modal').style.display='none'">Cancel</button>
                <button type="submit" class="btn btn-primary" style="width: auto; padding: 10px 24px; font-weight: 700;">Create Project</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
