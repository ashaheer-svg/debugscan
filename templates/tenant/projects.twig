{% extends "layout/dashboard.twig" %}

{% set active_page = 'projects' %}

{% block title %}Projects - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <h1 class="page-title">Forensic Projects</h1>
        <p class="page-subtitle">Manage cases and their associated diagnostic files.</p>
    </div>
    <button type="button" class="btn btn-primary" style="width: auto;" onclick="document.getElementById('new-project-modal').style.display='flex'">
        + Create New Project
    </button>
</header>

<div style="background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
    {% if projects %}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
        {% for project in projects %}
        <article style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='var(--shadow-2)'" onmouseout="this.style.transform='none'; this.style.boxShadow='none'" onclick="window.location='/projects/view/{{ project.id }}'">
            <h3 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">{{ project.name }}</h3>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 20px; min-height: 40px;">{{ project.notes|default('No notes provided.')|slice(0, 80) }}...</p>
            
            <footer style="display: flex; border-top: 1px solid var(--row-border); padding-top: 16px; justify-content: space-between; align-items: center;">
                <span style="font-size: 12px; color: var(--text-muted);">
                    Created: {{ project.created_at|date('M d, Y') }}
                </span>
                <span style="background: var(--bg-light); color: var(--text-secondary); font-size: 12px; padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border);">
                    {{ project.serial_number|default('Serial Pending') }}
                </span>
            </footer>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div style="padding: 64px; text-align: center;">
        <h2 style="font-weight: 700; margin-bottom: 8px;">No projects found.</h2>
        <p style="color: var(--text-secondary); margin-bottom: 24px;">Start by creating your first forensic project to analyze Synology debug logs.</p>
        <button type="button" class="btn btn-primary" style="width: auto;" onclick="document.getElementById('new-project-modal').style.display='flex'">
            Create Your First Project
        </button>
    </div>
    {% endif %}
</div>

<!-- Simple Project Creation Modal -->
<div id="new-project-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 400; align-items: center; justify-content: center;">
    <div style="background: var(--white); width: 480px; padding: 32px; border-radius: var(--radius-lg); box-shadow: var(--shadow-4);">
        <h2 style="font-weight: 700; margin-bottom: 24px;">Create New Project</h2>
        <form action="/projects/create" method="POST">
            <div class="form-group">
                <label for="name" class="form-label">Project Name</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="Case Ref #1234" required>
            </div>
            <div class="form-group">
                <label for="notes" class="form-label">Notes (Optional)</label>
                <textarea id="notes" name="notes" class="form-control" style="height: 100px;" placeholder="Internal case details..."></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
                <button type="button" class="btn" style="background: var(--bg-light); color: var(--text-secondary);" onclick="document.getElementById('new-project-modal').style.display='none'">Cancel</button>
                <button type="submit" class="btn btn-primary" style="width: auto;">Create Project</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
