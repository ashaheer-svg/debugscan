{% extends "layout/dashboard.twig" %}

{% set active_page = 'dashboard' %}

{% block title %}Dashboard - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header">
    <h1 class="page-title">Welcome back, {{ user_name }}</h1>
    <p class="page-subtitle">Here is an overview of your forensic diagnostic status.</p>
</header>

<div class="kpi-grid">
    <div class="kpi-card">
        <h2 class="kpi-value">{{ project_count }}</h2>
        <p class="kpi-label">Active Projects</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ scan_count }}</h2>
        <p class="kpi-label">Completed Scans</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ tokens_available|number_format }}</h2>
        <p class="kpi-label">Available Tokens</p>
    </div>
</div>

<section class="recent-scans-card">
    <div style="background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-1);">
        <h3 style="margin-bottom: 24px; font-weight: 700;">Recent Forensic Scans</h3>
        
        {% if recent_scans %}
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--row-border); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">
                    <th style="padding: 12px 0;">Project</th>
                    <th style="padding: 12px 0;">Status</th>
                    <th style="padding: 12px 0;">Health</th>
                    <th style="padding: 12px 0;">Completed At</th>
                    <th style="padding: 12px 0;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for scan in recent_scans %}
                <tr style="border-bottom: 1px solid var(--row-border); font-size: 14px;">
                    <td style="padding: 16px 0; font-weight: 600; color: var(--primary);">{{ scan.project_name }}</td>
                    <td style="padding: 16px 0;">
                        <span class="badge" style="background: var(--info-light); color: var(--info); padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600;">{{ scan.status }}</span>
                    </td>
                    <td style="padding: 16px 0;">
                        <span style="font-weight: 700; color: {% if scan.health_score == 'A' %}var(--success){% else %}var(--warning){% endif %};">{{ scan.health_score }}</span>
                    </td>
                    <td style="padding: 16px 0; color: var(--text-secondary);">{{ scan.completed_at ? scan.completed_at|date('M d, Y H:i') : 'Pending' }}</td>
                    <td style="padding: 16px 0;">
                        <a href="/scans/report/{{ scan.id }}" style="color: var(--primary); font-weight: 600; text-decoration: none;">View Report</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div style="padding: 40px; text-align: center; color: var(--text-muted); font-size: 14px;">
            No recent scans found. Start by creating a project and uploading a debug file.
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}
