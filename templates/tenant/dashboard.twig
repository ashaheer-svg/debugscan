{% extends "layout/dashboard.twig" %}

{% set active_page = 'dashboard' %}

{% block title %}Dashboard - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header">
    <h1 class="page-title">Welcome back, {{ user_name }}</h1>
    <p class="page-subtitle">Here is an overview of your forensic diagnostic status.</p>
</header>

<div class="kpi-grid">
    <div class="kpi-card">
        <h2 class="kpi-value">{{ project_count }}</h2>
        <p class="kpi-label">Active Projects</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ scan_count }}</h2>
        <p class="kpi-label">Completed Scans</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ tokens_available|number_format }}</h2>
        <p class="kpi-label">Available Tokens</p>
    </div>
</div>

<section class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); background: var(--bg-off-white);">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Recent Forensic Scans</h3>
    </div>
    
    {% if recent_scans %}
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Project</th>
                <th>Status</th>
                <th>Health</th>
                <th>Completed At</th>
                <th style="padding-right: 24px; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for scan in recent_scans %}
            <tr>
                <td style="padding-left: 24px; font-weight: 600;">
                    <a href="/projects/view/{{ scan.project_id }}" style="color: var(--primary);">{{ scan.project_name }}</a>
                </td>
                <td>
                    <span class="badge" style="background: var(--info-light); color: var(--info);">{{ scan.status|upper }}</span>
                </td>
                <td>
                    <span style="font-weight: 700; color: {% if scan.health_score == 'A' or scan.health_score|replace('%','')|number_format > 80 %}var(--success){% else %}var(--warning){% endif %};">{{ scan.health_score }}</span>
                </td>
                <td style="color: var(--text-secondary); font-size: 13px;">{{ scan.completed_at ? scan.completed_at|date('M d, Y H:i') : 'Pending' }}</td>
                <td style="padding-right: 24px; text-align: right;">
                    <a href="/scans/report/{{ scan.id }}" class="btn-action" data-tooltip="View Analysis Report" aria-label="View Analysis Report">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                    </a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div style="padding: 64px; text-align: center; color: var(--text-muted); font-size: 14px;">
        <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">🔍</div>
        <div style="font-weight: 600; color: var(--text-primary);">No recent scans found</div>
        <div style="margin-top: 4px;">Start by creating a project and uploading a debug file.</div>
    </div>
    {% endif %}
</section>
{% endblock %}
