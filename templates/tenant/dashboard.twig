{% extends "layout/dashboard.twig" %}

{% set active_page = 'dashboard' %}

{% block title %}Dashboard - AI DebugScan v3{% endblock %}

{% block dashboard_content %}
<header class="page-header">
    <h1 class="page-title">Welcome back, {{ user_name }}</h1>
    <p class="page-subtitle">Here is an overview of your forensic diagnostic status.</p>
</header>

<div class="kpi-grid">
    <div class="kpi-card">
        <h2 class="kpi-value">{{ project_count }}</h2>
        <p class="kpi-label">Active Projects</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ scan_count }}</h2>
        <p class="kpi-label">Completed Scans</p>
    </div>
    <div class="kpi-card">
        <h2 class="kpi-value">{{ tokens_available|number_format }}</h2>
        <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
            <p class="kpi-label" style="margin: 0;">Available Tokens</p>
            <button onclick="document.getElementById('tokenModal').style.display='flex'" class="btn-action" style="padding: 2px 8px; font-size: 11px; background: var(--primary); color: white; border: none; border-radius: 4px; cursor: pointer;">Request More</button>
        </div>
    </div>
</div>

<!-- Request Tokens Modal -->
<div id="tokenModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="card" style="width: 400px; padding: 24px;">
        <h2 style="margin-top: 0;">Request AI Tokens</h2>
        <p style="font-size: 14px; color: var(--text-secondary);">Tokens are requested in blocks of 20,000. An administrator will review your request and grant the tokens via a magic link.</p>
        
        <form action="/tokens/purchase" method="POST">
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">Number of Blocks</label>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <input type="number" name="blocks" value="1" min="1" max="10" style="width: 80px; padding: 8px; border: 1px solid var(--row-border); border-radius: 4px;">
                    <span style="font-size: 14px; color: var(--text-muted);">x 20,000 = <strong id="tokenTotal">20,000</strong> tokens</span>
                </div>
            </div>
            
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" onclick="document.getElementById('tokenModal').style.display='none'" class="btn" style="background: transparent; color: var(--text-secondary);">Cancel</button>
                <button type="submit" class="btn btn-primary" style="background: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">Submit Request</button>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelector('input[name="blocks"]').addEventListener('input', function(e) {
    const blocks = parseInt(e.target.value) || 0;
    document.getElementById('tokenTotal').textContent = (blocks * 20000).toLocaleString();
});
</script>

<section class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); background: var(--bg-off-white);">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Recent Forensic Scans</h3>
    </div>
    
    {% if recent_scans %}
    <table class="data-table">
        <thead>
            <tr>
                <th style="padding-left: 24px;">Project</th>
                <th>Status</th>
                <th>Health</th>
                <th>Completed At</th>
                <th style="padding-right: 24px; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for scan in recent_scans %}
            <tr>
                <td style="padding-left: 24px; font-weight: 600;">
                    <a href="/projects/view/{{ scan.project_id }}" style="color: var(--primary);">{{ scan.project_name }}</a>
                </td>
                <td>
                    <span class="badge" style="background: var(--info-light); color: var(--info);">{{ scan.status|upper }}</span>
                </td>
                <td>
                    <span style="font-weight: 700; color: {% if scan.health_score == 'A' %}var(--success){% elseif scan.health_score != 'N/A' and (scan.health_score|default('0')|replace({'%':''})|trim) matches '/^[0-9]+$/' and (scan.health_score|default('0')|replace({'%':''})|number_format > 80) %}var(--success){% else %}var(--warning){% endif %};">{{ scan.health_score|default('N/A') }}</span>
                </td>
                <td style="color: var(--text-secondary); font-size: 13px;">{{ scan.completed_at ? scan.completed_at|date('M d, Y H:i') : 'Pending' }}</td>
                <td style="padding-right: 24px; text-align: right;">
                    <a href="/scans/report/{{ scan.id }}" class="btn-action" data-tooltip="View Analysis Report" aria-label="View Analysis Report">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                    </a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div style="padding: 64px; text-align: center; color: var(--text-muted); font-size: 14px;">
        <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">🔍</div>
        <div style="font-weight: 600; color: var(--text-primary);">No recent scans found</div>
        <div style="margin-top: 4px;">Start by creating a project and uploading a debug file.</div>
    </div>
    {% endif %}
</section>
{% endblock %}
