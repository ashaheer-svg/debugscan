{% extends "layout/dashboard.twig" %}

{% set active_page = 'scans' %}

{% block title %}Forensic Report - {{ project.name }}{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/projects/view/{{ project.id }}" style="font-size: 13px; color: var(--text-muted); font-weight: 500;">Projects</a>
            <span style="color: var(--text-muted); font-size: 13px;">/</span>
            <span style="color: var(--text-primary); font-size: 13px; font-weight: 600;">Report</span>
        </div>
        <h1 class="page-title">Forensic Analysis Report</h1>
        <p class="page-subtitle">Project: {{ project.name }} | Serial: {{ project.serial_number|default('ID PENDING') }}</p>
    </div>
    <div style="text-align: right; background: var(--bg-light); padding: 16px 24px; border-radius: var(--radius); border: 1px solid var(--border);">
        <span style="font-size: 11px; font-weight: 800; color: var(--text-muted); display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.1em;">Health Score</span>
        <div style="font-size: 40px; font-weight: 900; color: {% if job.health_score == 'A' %}var(--success){% elseif job.health_score == 'F' or job.health_score|replace('%','')|number_format < 40 %}var(--danger){% else %}var(--warning){% endif %}; line-height: 1;">
            {{ job.health_score }}
        </div>
    </div>
</header>

<!-- Summary Section -->
<section class="card" style="border-left: 4px solid var(--primary); padding: 32px;">
    <h3 style="margin: 0 0 20px 0; font-size: 18px; font-weight: 700; color: var(--text-primary);">Executive Summary</h3>
    <div style="font-size: 15px; color: var(--text-primary); line-height: 1.8; font-weight: 500;">
        {% set summary = job.result_summary|json_decode %}
        {% if summary is iterable %}
            {{ summary.text|default(summary|json_encode) }}
        {% else %}
            {{ summary|default('No formal summary was documented for this forensic scan.') }}
        {% endif %}
    </div>
</section>

<!-- Findings Section -->
<div style="display: flex; justify-content: space-between; align-items: center; margin: 48px 0 24px 0;">
    <h3 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 0;">Detailed Forensic Findings ({{ findings|length }})</h3>
    <div style="height: 1px; flex: 1; background: var(--border); margin-left: 24px;"></div>
</div>

<div style="display: flex; flex-direction: column; gap: 24px;">
    {% for finding in findings %}
    <article class="card" style="padding: 0; overflow: hidden; border: 1px solid var(--row-border);">
        <header style="padding: 16px 24px; background: var(--bg-off-white); border-bottom: 1px solid var(--row-border); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <span class="badge" style="
                    background: {% if finding.severity == 'critical' %}var(--danger-light){% elseif finding.severity == 'warning' %}var(--warning-light){% else %}var(--info-light){% endif %};
                    color: {% if finding.severity == 'critical' %}var(--danger){% elseif finding.severity == 'warning' %}var(--warning){% else %}var(--info){% endif %};
                    border: 1px solid {% if finding.severity == 'critical' %}var(--danger){% elseif finding.severity == 'warning' %}var(--warning){% else %}var(--info){% endif %};
                    ">
                    {{ finding.severity|upper }}
                </span>
                <span style="font-size: 11px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">{{ finding.category }}</span>
            </div>
            <span style="font-size: 11px; font-family: monospace; color: var(--text-muted); font-weight: 600;">#{{ finding.id|slice(0,8) }}</span>
        </header>
        
        <div style="padding: 32px;">
            <h4 style="font-size: 18px; font-weight: 700; margin: 0 0 16px 0; color: var(--text-primary); letter-spacing: -0.01em;">{{ finding.title }}</h4>
            <div style="font-size: 14px; color: var(--text-secondary); margin-bottom: 32px; line-height: 1.7; font-weight: 500;">{{ finding.description }}</div>
            
            <div style="background: var(--bg-light); border-radius: var(--radius); padding: 24px; border-left: 3px solid var(--primary);">
                <h5 style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--primary); margin: 0 0 8px 0; letter-spacing: 0.1em;">Remediation Recommendation</h5>
                <p style="font-size: 14px; color: var(--text-primary); font-weight: 600; margin: 0; line-height: 1.6;">{{ finding.recommendation }}</p>
            </div>
        </div>
    </article>
    {% endfor %}
</div>

{% if not findings %}
<div class="card" style="padding: 64px; text-align: center; color: var(--text-muted);">
    <div style="font-size: 48px; margin-bottom: 20px; opacity: 0.2;">🛡️</div>
    <div style="font-weight: 600; color: var(--text-primary); font-size: 16px;">No findings documented</div>
    <div style="margin-top: 4px;">This diagnostic session did not surface any critical anomalies.</div>
</div>
{% endif %}
{% endblock %}
