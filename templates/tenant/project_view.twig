{% extends "layout/dashboard.twig" %}

{% set active_page = 'projects' %}

{% block title %}{{ project.name }} - Project View{% endblock %}

{% block dashboard_content %}
<header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/projects" style="font-size: 13px; color: var(--text-muted); font-weight: 500;">Projects</a>
            <span style="color: var(--text-muted); font-size: 13px;">/</span>
            <span style="color: var(--text-primary); font-size: 13px; font-weight: 600;">{{ project.name }}</span>
        </div>
        <h1 class="page-title">{{ project.name }}</h1>
        <p class="page-subtitle">{{ project.notes|default('No description provided for this case.') }}</p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button type="button" class="btn btn-outline" style="width: auto;">Edit Project</button>
    </div>
</header>

{% if success %}
<div style="background: var(--success-light); color: var(--success); padding: 12px 16px; border-radius: var(--radius); margin-bottom: 24px; font-weight: 500; border: 1px solid #c8e6c9;">
    {{ success }}
</div>
{% endif %}
{% if error %}
<div style="background: var(--error-light); color: var(--error); padding: 12px 16px; border-radius: var(--radius); margin-bottom: 24px; font-weight: 500; border: 1px solid #ffcdd2;">
    {{ error }}
</div>
{% endif %}

<div style="display: flex; flex-direction: column; gap: 32px;">
    <!-- Top Dashboard Area: 3-Column Layout -->
    <div style="display: grid; grid-template-columns: 280px 1fr 340px; gap: 24px;">
        
        <!-- Project Details (Summary) -->
        <section class="card" style="padding: 20px;">
            <h3 style="font-size: 14px; font-weight: 700; margin-bottom: 16px; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                Project Details
            </h3>
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid var(--bg-light);">
                    <span style="font-size: 11px; font-weight: 600; color: var(--text-muted);">CASE ID</span>
                    <span style="font-size: 12px; font-family: monospace; font-weight: 700; color: var(--primary);">#{{ project.case_id|default(project.id|slice(0,8)) }}</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid var(--bg-light);">
                    <span style="font-size: 11px; font-weight: 600; color: var(--text-muted);">CREATED</span>
                    <span style="font-size: 12px; font-weight: 600;">{{ project.created_at|date('M d, Y') }}</span>
                </div>
                <div style="display: flex; gap: 24px; padding-top: 4px;">
                    <div>
                        <div style="font-size: 9px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Logs</div>
                        <div style="font-size: 16px; font-weight: 800; color: var(--text-primary);">{{ files|length }}</div>
                    </div>
                    <div>
                        <div style="font-size: 9px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Audits</div>
                        <div style="font-size: 16px; font-weight: 800; color: var(--text-primary);">{{ scans|length }}</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Case Overview (Now properly named and distinct) -->
        <section class="card" style="padding: 20px;">
            <h3 style="font-size: 14px; font-weight: 700; margin-bottom: 12px; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                Forensic Notes
            </h3>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin: 0; max-height: 120px; overflow-y: auto;">
                {{ project.notes|default('No forensic context provided yet.') }}
            </p>
        </section>

        <!-- Upload Panel (Compact and aligned) -->
        <section class="card" style="background: var(--bg-deep); border: 2px dashed var(--primary); border-radius: 12px; padding: 20px; text-align: center; transition: all 0.2s; position: relative;">
            <input type="file" id="debug_log" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 2;">
            <div style="pointer-events: none;">
                <div style="font-size: 24px; margin-bottom: 4px;">📁</div>
                <h3 style="font-size: 13px; font-weight: 700; color: var(--primary); margin-bottom: 2px;">Upload Diagnostic Log</h3>
                <p style="font-size: 11px; color: var(--text-muted); margin: 0;">Drag & drop Synology .dat file</p>
            </div>
        </section>
    </div>

    <!-- Main Content: Diagnostic Log Table -->
    <div style="display: flex; flex-direction: column; gap: 32px;">
        
        <!-- Files Section -->
        <section class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); display: flex; justify-content: space-between; align-items: center; background: var(--bg-off-white);">
                <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Diagnostic Log Files</h3>
                <span style="font-size: 12px; color: var(--text-muted); font-weight: 500;">{{ files|length }} file(s) attached</span>
            </div>
            
            <form id="scanForm" action="/projects/scan/{{ project.id }}" method="POST">
                <table class="data-table" style="table-layout: fixed; width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 40px; padding-left: 24px;">
                                <input type="checkbox" id="selectAll">
                            </th>
                            <th>Filename</th>
                            <th style="width: 100px;">Size</th>
                            <th style="width: 140px;">Base Extraction</th>
                            <th style="width: 150px;">Forensic Audit</th>
                            <th style="width: 180px; text-align: right; padding-right: 24px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for file in files %}
                        <tr id="file-row-{{ file.id }}">
                            <td style="padding-left: 24px;">
                                <input type="checkbox" name="file_ids[]" value="{{ file.id }}" class="file-check">
                            </td>
                            <td>
                                <div style="font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis;">{{ file.original_filename }}</div>
                                <div style="font-size: 11px; color: var(--text-muted);">{{ file.created_at|date('M d, H:i') }}</div>
                            </td>
                            <td style="color: var(--text-secondary); font-size: 13px;">{{ (file.file_size_bytes / 1024 / 1024)|number_format(1) }} MB</td>
                            <td>
                                <span id="extraction-status-{{ file.id }}" style="font-size: 10px; font-weight: 800; color: {% if file.extraction_status == 'completed' %}var(--success){% else %}var(--primary){% endif %}; text-transform: uppercase; letter-spacing: 0.05em;">
                                    {{ file.extraction_status }}
                                </span>
                            </td>
                            <td>
                                <div class="forensic-status-{{ file.id }}" style="display: flex; flex-direction: column; gap: 4px;">
                                    <div style="display: flex; gap: 4px;">
                                        <span id="l1-badge-{{ file.id }}" class="badge" title="Level 1" style="background: {% if file_reports[file.id].level1 %}var(--success-light){% else %}var(--bg-light){% endif %}; color: {% if file_reports[file.id].level1 %}var(--success){% else %}var(--text-muted){% endif %};">L1</span>
                                        <span id="l2-badge-{{ file.id }}" class="badge" title="Level 2" style="background: {% if file_reports[file.id].level2 %}var(--warning-light){% else %}var(--bg-light){% endif %}; color: {% if file_reports[file.id].level2 %}var(--warning){% else %}var(--text-muted){% endif %};">L2</span>
                                    </div>
                                    <div id="progress-container-{{ file.id }}" style="display: none;">
                                        <div style="height: 4px; background: var(--bg-light); border-radius: 2px; overflow: hidden; width: 80px;">
                                            <div id="progress-bar-{{ file.id }}" class="shimmer" style="width: 0%; height: 100%; background: var(--primary); transition: width 0.3s ease;"></div>
                                        </div>
                                        <div id="progress-stage-{{ file.id }}" style="font-size: 9px; color: var(--primary); font-weight: 700; text-transform: uppercase; margin-top: 2px;">Queued...</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding-right: 24px; text-align: right;">
                                <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                    {% set level1 = file_reports[file.id].level1 %}
                                    {% set level2 = file_reports[file.id].level2 %}
                                    {% set is_truncated = (level1 and level1.truncated) or (level2 and level2.truncated) %}
                                    <button type="button" onclick="openPromptModal('{{ file.id }}')" 
                                            class="btn-action {% if is_truncated %}btn-warning-alt{% endif %}" 
                                            data-tooltip="View Forensic AI Prompt{% if is_truncated %} (Truncated){% endif %}" 
                                            aria-label="View Forensic AI Prompt">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                    </button>
                                    <a href="/files/report/{{ file.id }}" class="btn-action" data-tooltip="Hardware Evidence" aria-label="Hardware Evidence">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
                                    </a>
                                    
                                    <a href="{% if file_reports[file.id].level1 %}/scans/report/{{ file_reports[file.id].level1.id }}{% else %}#{% endif %}" id="l1-btn-{{ file.id }}" class="btn-action btn-success-alt" data-tooltip="View Level 1 Report" aria-label="Level 1" style="display: {% if file_reports[file.id].level1 %}flex{% else %}none{% endif %};">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8a3 3 0 0 0-3 3"/></svg>
                                    </a>
                                    <a href="{% if file_reports[file.id].level2 %}/scans/report/{{ file_reports[file.id].level2.id }}{% else %}#{% endif %}" id="l2-btn-{{ file.id }}" class="btn-action btn-warning-alt" data-tooltip="View Level 2 Report" aria-label="Level 2" style="display: {% if file_reports[file.id].level2 %}flex{% else %}none{% endif %};">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>

                                    <button type="button" onclick="deleteFile('{{ file.id }}')" class="btn-action btn-danger-alt" data-tooltip="Delete Log File" aria-label="Delete Log File">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                
                {% if not files %}
                <div style="padding: 64px; text-align: center; color: var(--text-muted);">
                    <div style="font-size: 40px; margin-bottom: 16px; opacity: 0.3;">📄</div>
                    <div style="font-weight: 600; color: var(--text-primary);">No log files uploaded yet</div>
                    <div style="font-size: 13px; margin-top: 4px;">Use the panel on the right to upload a Synology debug.dat file.</div>
                </div>
                {% else %}
                <div style="padding: 24px; background: var(--bg-light); border-top: 1px solid var(--row-border); display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; gap: 16px; align-items: center; white-space: nowrap;">
                        <label style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); letter-spacing: 0.05em; flex-shrink: 0;">AI Audit Level:</label>
                        <select id="scanLevel" name="level" style="padding: 10px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border); font-size: 13px; background: var(--white); cursor: pointer; font-weight: 600;">
                            <option value="level1">Level 1 (Standard Forensic Audit)</option>
                            <option value="level2">Level 2 (Deep Hardware Discovery)</option>
                        </select>
                    </div>
                    <button type="button" onclick="showTokenApproval()" class="btn btn-primary" style="width: auto; padding: 10px 32px; font-weight: 700;">Queue &nbsp; &#9656;</button>
                </div>
                {% endif %}
            </form>

        </section>

        <!-- Scans Section -->
        <section class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--row-border); background: var(--bg-off-white);">
                <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Analysis History</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="padding-left: 24px;">Job ID</th>
                        <th>Level</th>
                        <th>Status</th>
                        <th>Health Score</th>
                        <th style="padding-right: 24px; text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for scan in scans %}
                    <tr>
                        <td style="padding-left: 24px; font-family: monospace; font-size: 11px; color: var(--text-secondary);">#{{ scan.id|slice(0, 8) }}</td>
                        <td>
                            <span class="badge" style="background: var(--bg-light); color: var(--text-primary);">
                                {{ scan.scan_level|upper }}
                            </span>
                        </td>
                        <td>
                            <span style="color: {% if scan.status == 'completed' %}var(--success){% elseif scan.status == 'failed' or scan.status == 'error' %}var(--danger){% elseif scan.status == 'retry' %}var(--warning){% else %}var(--primary){% endif %}; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
                                {{ scan.status }}
                            </span>
                        </td>
                        <td>
                            {% if scan.health_score %}
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 60px; height: 6px; background: var(--bg-light); border-radius: 3px; overflow: hidden;">
                                    <div style="width: {{ scan.health_score }}%; height: 100%; background: {% if scan.health_score > 80 %}var(--success){% elseif scan.health_score > 50 %}var(--warning){% else %}var(--danger){% endif %};"></div>
                                </div>
                                <span style="font-weight: 700; font-size: 12px; font-family: monospace;">{{ scan.health_score }}%</span>
                            </div>
                            {% else %}
                            <span style="color: var(--text-muted); font-size: 12px;">--</span>
                            {% endif %}
                        </td>
                        <td style="padding-right: 24px; text-align: right;">
                            <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                                <button onclick="openCheckpointModal('{{ scan.id }}')" class="btn-action" data-tooltip="Inspect Workflow Pipeline" aria-label="Inspect Workflow Pipeline">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                                </button>
                                
                                {% if scan.status == 'completed' %}
                                <a href="/scans/report/{{ scan.id }}" class="btn-action btn-success-alt" data-tooltip="View Final Analysis Report" aria-label="View Analysis Report">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                                </a>
                                {% else %}
                                <div class="btn-action" data-tooltip="Processing..." style="opacity: 0.5; cursor: wait;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                                </div>
                                {% endif %}
                                <button onclick="deleteScan('{{ scan.id }}')" class="btn-action btn-danger-alt" data-tooltip="Delete Analysis Job" aria-label="Delete Analysis Job">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if not scans %}
            <div style="padding: 48px; text-align: center; color: var(--text-muted); font-size: 13px;">
                No analysis jobs found for this project.
            </div>
            {% endif %}
        </section>
    </div>

    <!-- Right Sidebar: Upload & Summary -->
    <aside style="display: flex; flex-direction: column; gap: 24px;">
        
        <div class="card">
            <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 16px;">Upload Debug Log</h3>
            <div id="uploadContainer">
                <div id="dropZone" style="border: 2px dashed var(--border); border-radius: var(--radius); padding: 24px; text-align: center; margin-bottom: 16px; background: var(--bg-light); cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'" onclick="document.getElementById('debug_log').click()">
                    <div style="font-size: 32px; margin-bottom: 8px;">📤</div>
                    <p style="font-size: 13px; color: var(--text-primary); font-weight: 600; margin-bottom: 4px;">Click or Drag to Upload</p>
                    <p style="font-size: 11px; color: var(--text-muted); font-weight: 500;">Synology debug.dat or .zip</p>
                    <input type="file" id="debug_log" name="debug_log" style="display: none;">
                </div>
                <p style="font-size: 11px; color: var(--text-muted); line-height: 1.5; font-weight: 500;">
                    Logs stay within your isolated tenant partition and are encrypted at rest.
                </p>
            </div>
        </div>

        <div class="card">
            <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 16px;">Project Summary</h3>
            <dl style="display: flex; flex-direction: column; gap: 12px; margin: 0;">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                    <dt style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Model</dt>
                    <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ project.model|default('--') }}</dd>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                    <dt style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">DSM Version</dt>
                    <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ project.dsm_version|default('--') }}</dd>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                    <dt style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">RAM</dt>
                    <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ project.ram_gb ? project.ram_gb ~ ' GB' : '--' }}</dd>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--row-border); padding-bottom: 8px;">
                    <dt style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Serial</dt>
                    <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary); font-family: monospace;">{{ project.serial_number|default('--') }}</dd>
                </div>
                <div style="display: flex; justify-content: space-between; padding-bottom: 4px;">
                    <dt style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Location</dt>
                    <dd style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">{{ project.physical_location|default('--') }}</dd>
                </div>
            </dl>
        </div>

    </aside>
</div>

<!-- Upload Progress Modal -->
<div id="uploadModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: var(--white); width: 100%; max-width: 440px; padding: 32px; border-radius: var(--radius-lg); box-shadow: var(--shadow-3); text-align: center;">
        <div id="modalIcon" style="font-size: 40px; margin-bottom: 16px;">🚀</div>
        <h3 id="modalTitle" style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">Uploading Debug Log</h3>
        <p id="modalStatus" style="font-size: 14px; color: var(--text-secondary); margin-bottom: 24px;">Preparing transmission...</p>
        
        <div style="background: var(--bg-light); height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 12px; position: relative;">
            <div id="progressBar" style="position: absolute; left: 0; top: 0; height: 100%; width: 0%; background: var(--primary); transition: width 0.3s ease;"></div>
        </div>
        <div id="progressText" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">0%</div>

        <div id="processingSteps" style="margin-top: 32px; text-align: left; display: none;">
            <div class="step-item" id="step-extract" style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; opacity: 0.5;">
                <div class="step-dot" style="width: 8px; height: 8px; border-radius: 50%; background: var(--border);"></div>
                <span style="font-size: 13px;">Uncompressing Archive</span>
            </div>
            <div class="step-item" id="step-parse" style="display: flex; align-items: center; gap: 12px; opacity: 0.5;">
                <div class="step-dot" style="width: 8px; height: 8px; border-radius: 50%; background: var(--border);"></div>
                <span style="font-size: 13px;">Extracting Hardware Identity</span>
            </div>
        </div>
    </div>
</div>

<script>
    const currentUserRole = '{{ user_role }}';
    const fileInput = document.getElementById('debug_log');
    const uploadModal = document.getElementById('uploadModal');
    const progressBar = document.getElementById('progressBar');
    const progressText = document.getElementById('progressText');
    const modalTitle = document.getElementById('modalTitle');
    const modalStatus = document.getElementById('modalStatus');
    const modalIcon = document.getElementById('modalIcon');
    const processingSteps = document.getElementById('processingSteps');

    if (fileInput) {
        fileInput.addEventListener('change', function() {
            if (!this.files.length) return;
            uploadFile(this.files[0]);
        });
    }

    function uploadFile(file) {
        const formData = new FormData();
        formData.append('debug_log', file);

        const xhr = new XMLHttpRequest();
        uploadModal.style.display = 'flex';
        
        // Stage 1: Uploading
        xhr.upload.addEventListener('progress', e => {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressBar.style.width = percent + '%';
                progressText.innerText = percent + '%';
                modalStatus.innerText = `Transmitting ${file.name} (${(e.loaded/1024/1024).toFixed(1)}MB / ${(e.total/1024/1024).toFixed(1)}MB)`;
            }
        });

        xhr.addEventListener('load', () => {
            if (xhr.status >= 200 && xhr.status < 300) {
                // Stage 2: Processing
                transitionToProcessing();
                setTimeout(() => {
                    location.reload();
                }, 2000); // Give user time to see completion
            } else {
                let errorMsg = "Upload failed";
                try {
                    const resp = JSON.parse(xhr.responseText);
                    errorMsg = resp.message || errorMsg;
                } catch(e) {}
                handleUploadError(errorMsg);
            }
        });

        xhr.addEventListener('error', () => handleUploadError("Network connection lost"));
        
        xhr.open('POST', '/projects/upload/{{ project.id }}');
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        xhr.send(formData);
    }

    function transitionToProcessing() {
        modalIcon.innerText = '⚙️';
        modalTitle.innerText = 'Analyzing Debug Log';
        modalStatus.innerText = 'Finalizing extraction and mapping metadata...';
        progressBar.style.width = '100%';
        progressBar.style.background = 'var(--success)';
        progressText.innerText = 'UPLOAD COMPLETE';
        processingSteps.style.display = 'block';
        
        // Simulated sub-steps for UX since backend is one-shot
        const stepExtract = document.getElementById('step-extract');
        const stepParse = document.getElementById('step-parse');
        
        setTimeout(() => {
            stepExtract.style.opacity = '1';
            stepExtract.querySelector('.step-dot').style.background = 'var(--success)';
        }, 500);
        
        setTimeout(() => {
            stepParse.style.opacity = '1';
            stepParse.querySelector('.step-dot').style.background = 'var(--success)';
            modalIcon.innerText = '✅';
            modalTitle.innerText = 'Extraction Successful';
            modalStatus.innerText = 'Hardware identity and storage topology mapped.';
        }, 1200);
    }

    function handleUploadError(msg) {
        modalIcon.innerText = '❌';
        modalTitle.innerText = 'Upload Failed';
        modalStatus.innerText = msg || 'An unknown error occurred during processing.';
        modalStatus.style.color = 'var(--error)';
        progressBar.style.background = 'var(--error)';
        
        setTimeout(() => {
            uploadModal.style.display = 'none';
            // Reset for next attempt
            modalStatus.style.color = '';
            progressBar.style.background = '';
            fileInput.value = '';
        }, 5000);
    }

    const activeScans = new Map();

    // Initialize state from server-side data
    {% for scan in scans %}
        {% if scan.status in ['queued', 'running'] %}
            activeScans.set('{{ scan.id }}', {
                level: '{{ scan.scan_level }}',
                files: {{ scan.debug_file_ids|json_encode|raw }}
            });
        {% elseif scan.status == 'completed' %}
            {# Immediately show buttons for completed historic scans #}
            {% for fid in scan.debug_file_ids %}
                (function() {
                    const fid = '{{ fid }}';
                    const level = '{{ scan.scan_level }}';
                    const btn = document.getElementById(level + '-btn-' + fid);
                    const badge = document.getElementById(level + '-badge-' + fid);
                    if (btn) {
                        btn.style.display = 'inline-block';
                        btn.href = '/scans/report/{{ scan.id }}';
                    }
                    if (badge) {
                        badge.style.background = level === 'level1' ? 'var(--success-light)' : 'var(--warning-light)';
                        badge.style.color = level === 'level1' ? 'var(--success)' : 'var(--warning)';
                    }
                })();
            {% endfor %}
        {% endif %}
    {% endfor %}

    function pollScans() {
        if (activeScans.size === 0) return;

        activeScans.forEach((data, scanId) => {
            fetch(`/scans/status/${scanId}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(job => {
                const isFinished = job.status === 'completed' || job.status === 'failed';
                
                // Defensive: Ensure debug_file_ids is an array
                const fileIds = typeof job.debug_file_ids === 'string' ? job.debug_file_ids.replace('{','').replace('}','').split(',') : job.debug_file_ids;
                
                if (fileIds) {
                    fileIds.forEach(fid => {
                        const container = document.getElementById('progress-container-' + fid);
                        const bar = document.getElementById('progress-bar-' + fid);
                        const stage = document.getElementById('progress-stage-' + fid);

                    const l1Btn = document.getElementById('l1-btn-' + fid);
                    const l2Btn = document.getElementById('l2-btn-' + fid);
                    const badge = document.getElementById(job.scan_level + '-badge-' + fid);

                    if (job.status === 'running' || job.status === 'queued') {
                        container.style.display = 'block';
                        
                        // Stepped Progress Mapping
                        const stages = ['Initializing', 'Extracting', 'Database Parsing', 'AI Analysis', 'Finalizing'];
                        const currentStageIdx = stages.indexOf(job.progress_stage);
                        const progress = currentStageIdx >= 0 ? ((currentStageIdx + 1) / stages.length) * 100 : (job.progress_percent || 0);
                        
                        bar.style.width = progress + '%';
                        stage.innerHTML = `
                            <div style="display: flex; gap: 4px; margin-top: 4px;">
                                ${stages.map((s, i) => `
                                    <div style="flex: 1; height: 3px; border-radius: 1px; background: ${i <= currentStageIdx ? 'var(--primary)' : 'var(--bg-light)'};"></div>
                                `).join('')}
                            </div>
                            <div style="margin-top: 4px;">${job.progress_stage || 'Queued...'}</div>
                        `;
                    } else if (isFinished) {

                        container.style.display = 'none';
                        if (job.status === 'completed') {
                            const btn = job.scan_level === 'level1' ? l1Btn : l2Btn;
                            if (btn) {
                                btn.style.display = 'inline-block';
                                btn.href = '/scans/report/' + job.id;
                            }
                            if (badge) {
                                badge.style.background = job.scan_level === 'level1' ? 'var(--success-light)' : 'var(--warning-light)';
                                badge.style.color = job.scan_level === 'level1' ? 'var(--success)' : 'var(--warning)';
                            }
                        }
                    }
                });
            }


                if (isFinished) {
                    activeScans.delete(scanId);
                    if (job.status === 'completed') {
                        // Optionally reload if we want the history table updated too
                        // location.reload(); 
                    }
                }
            })
            .catch(e => console.error("Poll error:", e));
        });
    }

    // Start polling if needed
    if (activeScans.size > 0) {
        setInterval(pollScans, 3000);
    }

    // Update startScan to handle AJAX and start polling
    document.getElementById('analysisForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        
        fetch(this.action, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                activeScans.set(data.job_id, {
                    level: formData.get('level'),
                    files: data.debug_file_ids
                });
                pollScans(); // Start immediately
                setInterval(pollScans, 3000);
            } else {
                alert(data.message || 'Failed to start scan');
            }
        })
        .catch(err => alert('Error starting scan: ' + err));
    });

    function deleteFile(id) {
        if (!confirm('Are you sure you want to delete this log file? This will also remove all extracted temporary data.')) {
            return;
        }

        fetch(`/files/delete/${id}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Failed to delete file');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while deleting the file');
        });
    }
    function openCheckpointModal(scanId) {
        const modal = document.getElementById('checkpointModal');
        const content = document.getElementById('checkpointContent');
        modal.style.display = 'flex';
        content.innerHTML = '<div style="text-align: center; padding: 40px; color: var(--text-muted);">Loading checkpoints...</div>';

        fetch(`/scans/status/${scanId}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            const cps = typeof data.checkpoints === 'string' ? JSON.parse(data.checkpoints) : data.checkpoints;
            
            if (!cps || cps.length === 0) {
                content.innerHTML = '<div style="text-align: center; padding: 40px; color: var(--text-muted);">No checkpoints logged yet.</div>';
                return;
            }

            let html = '<div style="display: flex; flex-direction: column; gap: 16px;">';
            cps.forEach((cp, idx) => {
                const isLast = idx === cps.length - 1;
                const color = cp.status === 'success' ? '#10b981' : '#ef4444';
                
                html += `
                    <div style="display: flex; gap: 16px;">
                        <div style="display: flex; flex-direction: column; align-items: center; width: 24px;">
                            <div style="width: 12px; height: 12px; border-radius: 50%; background: ${color}; border: 3px solid #fff; box-shadow: 0 0 0 1px ${color}; z-index: 1;"></div>
                            ${!isLast ? `<div style="width: 2px; flex-grow: 1; background: #e5e7eb; margin: 4px 0;"></div>` : ''}
                        </div>
                        <div style="flex-grow: 1; padding-bottom: ${!isLast ? '16px' : '0'};">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
                                <h4 style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary);">${cp.stage}</h4>
                                <span style="font-size: 11px; color: var(--text-muted);">${cp.ts.split(' ')[1]}</span>
                            </div>
                            <div style="font-size: 12px; color: var(--text-secondary); background: #f8fafc; padding: 8px 12px; border-radius: 6px; border: 1px solid #edf2f7;">
                                <div style="font-weight: 700; font-size: 10px; color: ${color}; text-transform: uppercase; margin-bottom: 4px;">${cp.status}</div>
                                ${cp.meta.capacity ? `<div style="margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px dashed #e2e8f0;"><strong style="color: var(--text-primary);">Handover Capacity:</strong> <span style="color: var(--primary); font-weight: 700;">${cp.meta.capacity}</span></div>` : ''}
                                ${Object.entries(cp.meta).filter(([k]) => !['capacity', 'data_link'].includes(k)).map(([k, v]) => `<div><strong>${k}:</strong> ${typeof v === 'object' ? JSON.stringify(v) : v}</div>`).join('') || (!cp.meta.capacity ? 'Process completed successfully.' : '')}
                                ${cp.meta.data_link && (currentUserRole === 'admin' || currentUserRole === 'system_admin') ? `
                                    <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid #e2e8f0;">
                                        <a href="${cp.meta.data_link}" target="_blank" class="btn" style="height: 28px; font-size: 11px; font-weight: 700; background: var(--bg-light); border: 1px solid var(--border); color: var(--primary); width: 100%;">INSPECT HANDOVER DATA</a>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            content.innerHTML = html;
        })
        .catch(err => {
            content.innerHTML = `<div style="text-align: center; padding: 40px; color: var(--error);">Error loading checkpoints: ${err.message}</div>`;
        });
    }

    function closeCheckpointModal() {
        document.getElementById('checkpointModal').style.display = 'none';
    }

    function showTokenApproval() {
        const fileIds = Array.from(document.querySelectorAll('.file-check:checked')).map(cb => cb.value);
        if (fileIds.length === 0) {
            alert('Please select at least one log file to scan.');
            return;
        }

        const level = document.getElementById('scanLevel').value;
        const modal = document.getElementById('tokenModal');
        const tokenLabel = document.getElementById('tokenAllocation');
        const levelLabel = document.getElementById('modalScanLevel');
        
        // Final sanity check for auto-L2
        const effectiveLevel = fileIds.length > 1 ? 'level2' : level;
        
        levelLabel.innerText = effectiveLevel === 'level1' ? 'LEVEL 1 (Standard Forensic Audit)' : 'LEVEL 2 (Deep Hardware / Multi-File Audit)';
        tokenLabel.innerText = effectiveLevel === 'level1' ? '12,000 Tokens' : '40,000 Tokens'; // Estimates or limits
        
        modal.style.display = 'flex';
    }

    function confirmScan() {
        document.getElementById('tokenModal').style.display = 'none';
        const form = document.getElementById('scanForm');
        const formData = new FormData(form);
        
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                activeScans.set(data.job_id, {
                    level: formData.get('level'),
                    files: data.debug_file_ids
                });
                pollScans();
                if (!window.pollInterval) {
                   window.pollInterval = setInterval(pollScans, 3000);
                }
            } else {

                alert(data.message || 'Failed to start scan');
            }
        })
        .catch(err => alert('Error starting scan: ' + err));
    }

    function cancelScan() {
        document.getElementById('tokenModal').style.display = 'none';
    }

    function deleteScan(id) {
        if (!confirm('Permanently delete this analysis record and its findings?')) return;
        fetch(`/scans/delete/${id}`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) location.reload();
            else alert(data.message);
        });
    }

    function openPromptModal(fileId) {
        const modal = document.getElementById('promptModal');
        const title = document.getElementById('promptModalTitle');
        const content = document.getElementById('promptModalContent');
        const typeBadge = document.getElementById('promptTypeBadge');
        
        modal.style.display = 'flex';
        content.innerHTML = '<div style="text-align: center; padding: 40px; color: var(--text-muted);">Fetching forensic payload...</div>';
        
        fetch(`/files/prompt/${fileId}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(resp => {
            if (resp.success) {
                title.innerText = resp.title;
                typeBadge.innerText = resp.type.toUpperCase();
                typeBadge.style.background = resp.type === 'prompt' ? 'var(--info-light)' : 'var(--bg-deep)';
                typeBadge.style.color = resp.type === 'prompt' ? 'var(--info)' : 'var(--text-muted)';
                
                // Formatted output
                const displayData = typeof resp.data === 'string' ? resp.data : JSON.stringify(resp.data, null, 2);
                content.innerHTML = `<pre style="margin: 0; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 13px; color: #e5e7eb; line-height: 1.6; white-space: pre-wrap; word-break: break-all;">${displayData}</pre>`;
            } else {
                content.innerHTML = `<div style="color: var(--error); padding: 20px;">${resp.message || 'Failed to load diagnostic data.'}</div>`;
            }
        })
        .catch(err => {
            content.innerHTML = `<div style="color: var(--error); padding: 20px;">Network Error: ${err.message}</div>`;
        });
    }

    function closePromptModal() {
        document.getElementById('promptModal').style.display = 'none';
    }
</script>

    <!-- Token Approval Modal -->
    <div id="tokenModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 10001; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <div style="background: var(--white); width: 100%; max-width: 480px; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
            <div style="padding: 32px; text-align: center;">
                <div style="font-size: 40px; margin-bottom: 16px;">🎟️</div>
                <h3 style="margin-bottom: 8px;">Token Allocation Approval</h3>
                <p style="font-size: 14px; color: var(--text-secondary); margin-bottom: 24px;">
                    This analysis job requires a token allocation from your tenant balance.
                </p>
                
                <div style="background: var(--bg-light); border-radius: 8px; padding: 20px; text-align: left; border: 1px solid var(--border); margin-bottom: 24px;">
                    <div style="margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Scan Level</span>
                        <span id="modalScanLevel" style="font-size: 13px; font-weight: 700; color: var(--primary);">--</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Token Allotment</span>
                        <span id="tokenAllocation" style="font-size: 18px; font-weight: 900; color: var(--text-primary);">--</span>
                    </div>
                </div>

                <div style="display: flex; gap: 12px;">
                    <button onclick="confirmScan()" class="btn btn-primary" style="flex: 1;">Approve & Execute</button>
                    <button onclick="cancelScan()" class="btn" style="flex: 1; background: var(--bg-light); border: 1px solid var(--border);">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Checkpoints Modal -->
    <div id="checkpointModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <div style="background: var(--white); width: 90%; max-width: 600px; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: var(--bg-light);">
                <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Workflow Checkpoints</h3>
                <button onclick="closeCheckpointModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-muted);">&times;</button>
            </div>
            <div id="checkpointContent" style="padding: 24px; max-height: 400px; overflow-y: auto;">
                <div style="text-align: center; padding: 40px; color: var(--text-muted);">Loading checkpoints...</div>
            </div>
            <div style="padding: 16px 24px; border-top: 1px solid var(--border); background: var(--bg-light); text-align: right;">
                <button onclick="closeCheckpointModal()" class="btn" style="width: auto; padding: 8px 20px; background: var(--white); color: var(--text-primary); border: 1px solid var(--border);">Close</button>
            </div>
        </div>
    </div>

    <!-- Styled Prompt Modal -->
    <div id="promptModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,10,0.85); z-index: 10005; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
        <div style="background: #1a1b1e; width: 90%; max-width: 900px; height: 80vh; border-radius: 16px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.1);">
            <div style="padding: 24px 32px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; background: #232429;">
                <div style="display: flex; align-items: center; gap: 16px;">
                    <h3 id="promptModalTitle" style="margin: 0; font-size: 16px; font-weight: 700; color: #fff; letter-spacing: -0.01em;">Forensic Data View</h3>
                    <span id="promptTypeBadge" class="badge" style="font-size: 10px; font-weight: 800; padding: 4px 10px;">IDLE</span>
                </div>
                <button onclick="closePromptModal()" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #9ca3af; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.color='#fff';" onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.color='#9ca3af';">&times;</button>
            </div>
            
            <div id="promptModalContent" style="flex-grow: 1; padding: 32px; overflow-y: auto; background: #0f1012;">
                <!-- Content will be injected here -->
            </div>
            
            <div style="padding: 16px 32px; border-top: 1px solid rgba(255,255,255,0.05); background: #232429; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 12px; color: #6b7280; font-family: monospace;">Secured Forensic Partition | read-only node</span>
                <button onclick="closePromptModal()" class="btn" style="width: auto; padding: 10px 24px; background: var(--primary); color: #fff; border: none; font-weight: 700; border-radius: 8px;">Close Inspector</button>
            </div>
        </div>
    </div>
{% endblock %}
